---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  DEFAULT_LOCALE,
  absoluteLocaleUrl,
  getTranslations,
  localePath,
  type Locale,
} from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(lang);
const gl = t.googleLockPage;

const lockSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: gl.title,
  url: absoluteLocaleUrl(lang, 'sideloading/google-lock/'),
  author: { '@type': 'Person', name: 'DurchEins', url: 'https://github.com/DurchEins' },
  about: { '@type': 'SoftwareApplication', name: 'ApkUp' },
};
---

<BaseLayout
  lang={lang}
  subPath="sideloading/google-lock/"
  title={gl.title}
  description={gl.metaDesc}
  jsonLd={lockSchema}
  kaoBannerSize="normal"
>
  <Navbar lang={lang} />
  <div class="kao-scroll-progress" id="kao-scroll-progress" aria-hidden="true"></div>
  <main id="main-content" class="section">
    <div class="container subpage-wrap">
      <nav class="sl-breadcrumb" aria-label="Breadcrumb">
        <a href={localePath(lang, 'sideloading/')} class="mono">
          {gl.backLink}
        </a>
      </nav>

      <header class="kao-hero" id="kao-hero">
        <div class="kao-hero-top">
          <span class="pill-badge pill-danger mono kao-alert-pill">
            <span class="kao-pulse-dot" aria-hidden="true"></span>
            <span>{gl.alertPill}</span>
          </span>
          <span class="pill-badge pill-neutral mono kao-countdown-pill" id="kao-global-countdown">
            {gl.countdownPill}
          </span>
          <span class="pill-badge pill-neutral mono">keepandroidopen.org</span>
        </div>

        <h1 class="kao-title">{gl.h1}</h1>
        <p class="kao-lead">{gl.lead}</p>

        <div class="kao-hero-actions">
          <a href="#sl-lock-steps" class="btn btn-danger" data-kao-jump-steps>
            {gl.jumpStepsBtn}
          </a>
          <a
            href="https://keepandroidopen.org"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-danger-outline"
          >
            {gl.joinKaoBtn}
          </a>
          <button type="button" class="btn btn-danger-outline kao-share-btn" id="kao-share-btn">
            {gl.shareBtn}
          </button>
        </div>
      </header>

      <section class="kao-checker" id="kao-checker" aria-labelledby="kao-checker-title">
        <div class="kao-checker-head">
          <span class="pill-badge pill-danger mono">{gl.checkerBadge}</span>
          <h2 id="kao-checker-title">{gl.checkerTitle}</h2>
        </div>
        <div class="kao-checker-grid">
          <div class="kao-q">
            <span class="kao-q-label" id="kao-q1-label">{gl.checkerQ1}</span>
            <div class="kao-q-btns" role="group" aria-labelledby="kao-q1-label">
              <button type="button" class="kao-q-btn is-selected" data-q="gms" data-val="yes" aria-pressed="true">
                {gl.checkerQ1Yes}
              </button>
              <button type="button" class="kao-q-btn" data-q="gms" data-val="no" aria-pressed="false">
                {gl.checkerQ1No}
              </button>
            </div>
          </div>
          <div class="kao-q">
            <span class="kao-q-label" id="kao-q2-label">{gl.checkerQ2}</span>
            <div class="kao-q-btns" role="group" aria-labelledby="kao-q2-label">
              <button type="button" class="kao-q-btn is-selected" data-q="method" data-val="apk" aria-pressed="true">
                {gl.checkerQ2Apk}
              </button>
              <button type="button" class="kao-q-btn" data-q="method" data-val="adb" aria-pressed="false">
                {gl.checkerQ2Adb}
              </button>
            </div>
          </div>
        </div>
        <div class="kao-checker-result is-affected mono" id="kao-checker-result" role="status" aria-live="polite">
          {gl.checkerResultAffected}
        </div>
      </section>

      <section class="kao-section" aria-labelledby="kao-timeline-heading">
        <div class="kao-sec-head">
          <span class="pill-badge pill-danger mono">{gl.factsBadge}</span>
          <h2 id="kao-timeline-heading">{gl.factsHeading}</h2>
        </div>

        <div class="kao-facts-grid">
          {gl.facts.map((f) => (
            <article class="kao-fact-card kao-spotlight">
              <span class="kao-fact-date mono">{f.date}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="sl-card sl-card-danger" aria-labelledby="kao-why-heading">
        <div class="sl-card-head">
          <span class="pill-badge pill-danger mono">{gl.whyBadge}</span>
          <h2 id="kao-why-heading">{gl.whyHeading}</h2>
        </div>

        <div class="kao-danger-list" id="kao-danger-list">
          {gl.whyItems.map((item, idx) => (
            <div class="kao-danger-item" style={`--stagger-i: ${idx};`}>
              <strong>{item.title}</strong>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
      </section>

      <div class="sl-two-col">
        <article class="sl-card sl-card-danger">
          <span class="pill-badge pill-danger mono">keepandroidopen.org</span>
          <h2>{gl.kaoTitle}</h2>
          <p>{gl.kaoBody}</p>
          <div class="sl-actions">
            <a
              href="https://keepandroidopen.org"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-danger"
            >
              keepandroidopen.org ↗
            </a>
            <a
              href="https://keepandroidopen.org/banner/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-danger-outline"
            >
              {gl.kaoBannerBtn}
            </a>
          </div>
        </article>

        <article class="sl-card has-spotlight">
          <span class="pill-badge pill-amber mono">{gl.impactBadge}</span>
          <h2>{gl.impactTitle}</h2>
          <p>{gl.impactBody}</p>
          <div class="sl-actions">
            <a href={localePath(lang, 'wiki/#doc-google-lock')} class="btn btn-secondary">
              {gl.wikiChapterBtn}
            </a>
            <a href={localePath(lang, 'wiki/#doc-shizuku-deep')} class="btn btn-ghost">
              {gl.rootBtn}
            </a>
            <a href={localePath(lang, 'wiki/#doc-shizuku-setup')} class="btn btn-ghost">
              {gl.shizukuBtn}
            </a>
          </div>
        </article>
      </div>

      <section class="sl-card sl-card-danger" id="sl-lock-section" aria-labelledby="sl-lock-steps">
        <div class="sl-card-head">
          <span class="pill-badge pill-danger mono">{gl.unlockBadge}</span>
          <h2 id="sl-lock-steps">{gl.unlockHeading}</h2>
          <p class="sl-lead">{gl.unlockLead}</p>
          <div class="kao-progress-wrap" aria-live="polite">
            <div class="kao-progress-head mono">
              <span>{gl.checklistProgress}</span>
              <span class="kao-progress-right">
                <span id="kao-steps-count">0 / 4</span>
                <button type="button" class="kao-reset-btn" id="kao-steps-reset" hidden>
                  {gl.resetBtn}
                </button>
              </span>
            </div>
            <div class="kao-progress-track">
              <div class="kao-progress-fill" id="kao-steps-fill"></div>
            </div>
          </div>
        </div>

        <ol class="sl-steps" id="kao-steps-list">
          <li data-step-idx="0">
            <button
              type="button"
              role="checkbox"
              aria-checked="false"
              class="sl-num sl-num-danger mono"
              id="kao-step1-badge"
              data-step-toggle="0"
              aria-label={`01 — ${gl.steps[0].title}`}
              title="Tap 7×!"
            >
              <span class="sl-num-text" aria-hidden="true">01</span>
              <svg class="sl-num-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            </button>
            <div>
              <strong class="sl-step-title">{gl.steps[0].title}</strong>
              <p>{gl.steps[0].body}</p>
              {gl.steps[0].chips && (
                <div class="kao-path-chips mono">
                  <span class="kao-chip">{gl.steps[0].chips[0]}</span>
                  <span class="kao-chip-arrow" aria-hidden="true">→</span>
                  <span class="kao-chip">{gl.steps[0].chips[1]}</span>
                  <span class="kao-chip-arrow" aria-hidden="true">→</span>
                  <span class="kao-chip kao-chip-hl">{gl.steps[0].chips[2]}</span>
                </div>
              )}
              <div class="kao-dev-toast mono" id="kao-dev-toast" hidden role="status" aria-live="polite">
                {gl.steps[0].toast}
              </div>
            </div>
          </li>
          <li data-step-idx="1">
            <button
              type="button"
              role="checkbox"
              aria-checked="false"
              class="sl-num sl-num-danger mono"
              data-step-toggle="1"
              aria-label={`02 — ${gl.steps[1].title}`}
            >
              <span class="sl-num-text" aria-hidden="true">02</span>
              <svg class="sl-num-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            </button>
            <div>
              <strong class="sl-step-title">{gl.steps[1].title}</strong>
              <p>{gl.steps[1].body}</p>
              {gl.steps[1].chips && (
                <div class="kao-path-chips mono">
                  <span class="kao-chip">{gl.steps[1].chips[0]}</span>
                  <span class="kao-chip-arrow" aria-hidden="true">→</span>
                  <span class="kao-chip">{gl.steps[1].chips[1]}</span>
                  <span class="kao-chip-arrow" aria-hidden="true">→</span>
                  <span class="kao-chip kao-chip-hl">{gl.steps[1].chips[2]}</span>
                </div>
              )}
            </div>
          </li>
          <li data-step-idx="2">
            <button
              type="button"
              role="checkbox"
              aria-checked="false"
              class="sl-num sl-num-danger mono"
              data-step-toggle="2"
              aria-label={`03 — ${gl.steps[2].title}`}
            >
              <span class="sl-num-text" aria-hidden="true">03</span>
              <svg class="sl-num-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            </button>
            <div>
              <strong class="sl-step-title">{gl.steps[2].title}</strong>
              <p>{gl.steps[2].body}</p>
              <div class="kao-ics-hint">
                <button type="button" class="kao-ics-link mono" id="kao-timer-ics">
                  {gl.steps[2].icsBtn}
                </button>
              </div>
            </div>
          </li>
          <li data-step-idx="3">
            <button
              type="button"
              role="checkbox"
              aria-checked="false"
              class="sl-num sl-num-danger mono"
              data-step-toggle="3"
              aria-label={`04 — ${gl.steps[3].title}`}
            >
              <span class="sl-num-text" aria-hidden="true">04</span>
              <svg class="sl-num-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            </button>
            <div>
              <strong class="sl-step-title">{gl.steps[3].title}</strong>
              <p>{gl.steps[3].body}</p>
            </div>
          </li>
        </ol>

        <div class="kao-trap-alert" role="note">
          <strong>{gl.trapTitle}</strong>
          <p>{gl.trapBody}</p>
          <div class="kao-trap-sim" id="kao-trap-sim">
            <div class="kao-trap-tabs" role="tablist" aria-label={gl.trapTitle}>
              <button type="button" class="kao-trap-tab is-active" id="kao-trap-tab-7d" data-trap-mode="7d" role="tab" aria-selected="true" aria-controls="kao-trap-result" tabindex="0">
                {gl.trapTab7d}
              </button>
              <button type="button" class="kao-trap-tab" id="kao-trap-tab-forever" data-trap-mode="forever" role="tab" aria-selected="false" aria-controls="kao-trap-result" tabindex="-1">
                {gl.trapTabForever}
              </button>
            </div>
            <div class="kao-trap-result is-bad mono" id="kao-trap-result" role="tabpanel" aria-labelledby="kao-trap-tab-7d" aria-live="polite">
              {gl.trapRes7d}
            </div>
          </div>
        </div>
      </section>

      <section class="sl-card" aria-labelledby="kao-compare-heading">
        <div class="sl-card-head">
          <span class="pill-badge pill-neutral mono">{gl.compareBadge}</span>
          <h2 id="kao-compare-heading">{gl.compareHeading}</h2>
        </div>

        <div class="kao-table-wrap" tabindex="0" role="region" aria-label={gl.compareHeading}>
          <table class="kao-table" id="kao-compare-table">
            <thead>
              <tr>
                <th>{gl.compareThScenario}</th>
                <th>{gl.compareThLocked}</th>
                <th class="kao-col-safe-th" id="kao-col-safe-th">
                  {gl.compareThSafe}
                </th>
              </tr>
            </thead>
            <tbody>
              {gl.compareRows.map((r, i) => (
                <tr class={i < 2 ? 'kao-row-warn' : 'kao-row-safe'}>
                  <td><strong>{r.scenario}</strong></td>
                  <td class={i < 2 ? 'kao-td-bad' : 'kao-td-good'}>{r.locked}</td>
                  <td class="kao-td-good">{r.safe}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="sl-card" aria-labelledby="kao-adb-heading">
        <div class="sl-card-head">
          <span class="pill-badge pill-green mono">ADB • Shizuku • Root</span>
          <h2 id="kao-adb-heading">{gl.adbHeading}</h2>
          <p>{gl.adbLead}</p>
        </div>
        <div class="kao-code-wrap">
          <pre class="kao-code mono"><code>adb install -r ApkUp.apk</code></pre>
          <button type="button" class="kao-copy-btn mono" id="kao-copy-adb" aria-label={`${gl.copy} — adb install -r ApkUp.apk`}>
            <span class="kao-copy-icon kao-icon-default" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </span>
            <span class="kao-copy-icon kao-icon-done" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <span class="kao-copy-label">{gl.copy}</span>
          </button>
        </div>
        <div class="sl-actions">
          <a href={localePath(lang, 'sideloading/')} class="btn btn-secondary">
            {gl.backUnknownBtn}
          </a>
          <a href={localePath(lang, 'wiki/#doc-sideloading')} class="btn btn-ghost">
            {gl.generalWikiBtn}
          </a>
          <a href={localePath(lang, 'wiki/#doc-shizuku-deep')} class="btn btn-ghost">
            {gl.rootBtn}
          </a>
          <a href={localePath(lang, 'wiki/#doc-shizuku-setup')} class="btn btn-ghost">
            {gl.shizukuBtn}
          </a>
        </div>
      </section>
    </div>
  </main>

  <a href="#sl-lock-steps" class="kao-quick-jump mono" id="kao-quick-jump" data-kao-jump-steps hidden>
    {gl.quickJump}
  </a>

  <Footer lang={lang} subPath="sideloading/google-lock/" />
</BaseLayout>

<script
  is:inline
  define:vars={{
    resAffected: gl.checkerResultAffected,
    resAdb: gl.checkerResultAdb,
    resDeGoogled: gl.checkerResultDeGoogled,
    trap7dText: gl.trapRes7d,
    trapForeverText: gl.trapResForever,
    shareTitle: gl.h1,
    shareLead: gl.lead,
    copiedToast: t.meta.copiedToast,
  }}
>
  (function () {
    var ROLLOUT_UTC_MS = Date.UTC(2027, 0, 1, 0, 0, 0);
    var HOURS_24_MS = 24 * 3600 * 1000;
    var CHECKLIST_STORAGE_KEY = 'apkup-24h-steps-v1';
    var ADB_INSTALL_COMMAND = 'adb install -r ApkUp.apk';

    function initGlobalCountdown() {
      var countdownEl = document.getElementById('kao-global-countdown');
      if (!countdownEl) return;

      function render() {
        var remainingMs = ROLLOUT_UTC_MS - Date.now();
        if (remainingMs <= 0) {
          countdownEl.textContent = 'Global Rollout: Active';
          return;
        }
        var days = Math.floor(remainingMs / 86400000);
        var hours = Math.floor((remainingMs % 86400000) / 3600000);
        countdownEl.textContent = 'Jan 2027 • ' + days + 'd ' + hours + 'h';
      }

      render();
      setInterval(render, 60000);
    }

    function initCardSpotlights() {
      document.querySelectorAll('.kao-spotlight').forEach(function (card) {
        card.addEventListener('pointermove', function (event) {
          var rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', (event.clientX - rect.left) + 'px');
          card.style.setProperty('--my', (event.clientY - rect.top) + 'px');
        });
      });
    }

    function initScrollReveal() {
      var dangerItems = document.querySelectorAll('.kao-danger-item');
      if (!dangerItems.length) return;
      if (!('IntersectionObserver' in window)) {
        dangerItems.forEach(function (item) { item.classList.add('is-visible'); });
        return;
      }

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.15 });

      dangerItems.forEach(function (item) { observer.observe(item); });
    }

    function loadSavedSteps() {
      try {
        var parsed = JSON.parse(localStorage.getItem(CHECKLIST_STORAGE_KEY) || '[]');
        if (Array.isArray(parsed) && parsed.length === 4) return parsed.map(Boolean);
      } catch (e) {}
      return [false, false, false, false];
    }

    function initUnlockChecklist() {
      var stepsList = document.getElementById('kao-steps-list');
      if (!stepsList) return;

      var countEl = document.getElementById('kao-steps-count');
      var fillEl = document.getElementById('kao-steps-fill');
      var resetBtn = document.getElementById('kao-steps-reset');
      var stepItems = stepsList.querySelectorAll('li[data-step-idx]');
      var stepState = loadSavedSteps();

      function render() {
        var doneCount = 0;
        stepItems.forEach(function (li, index) {
          var isDone = stepState[index];
          if (isDone) doneCount++;
          li.classList.toggle('is-done', isDone);
          var toggleBtn = li.querySelector('[data-step-toggle]');
          if (toggleBtn) toggleBtn.setAttribute('aria-checked', isDone ? 'true' : 'false');
        });
        if (countEl) countEl.textContent = doneCount + ' / 4';
        if (fillEl) fillEl.style.width = (doneCount * 25) + '%';
        if (resetBtn) resetBtn.hidden = doneCount < 4;
        try { localStorage.setItem(CHECKLIST_STORAGE_KEY, JSON.stringify(stepState)); } catch (e) {}
      }

      stepItems.forEach(function (li, index) {
        function toggle() {
          stepState[index] = !stepState[index];
          render();
        }
        var toggleBtn = li.querySelector('[data-step-toggle]');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', function () {
            toggle();
          });
        }
        li.addEventListener('click', function (event) {
          if (event.target && event.target.closest('button, a')) return;
          toggle();
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          stepState = [false, false, false, false];
          render();
        });
      }

      render();
    }

    function initTrapSimulator() {
      var simulator = document.getElementById('kao-trap-sim');
      var resultEl = document.getElementById('kao-trap-result');
      if (!simulator || !resultEl) return;

      var tabs = Array.prototype.slice.call(simulator.querySelectorAll('.kao-trap-tab'));
      function activateTrapTab(tab, focusTab) {
        var isForever = tab.getAttribute('data-trap-mode') === 'forever';
        tabs.forEach(function (btn) {
          var active = btn === tab;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
          btn.setAttribute('tabindex', active ? '0' : '-1');
        });
        if (focusTab) tab.focus();
        resultEl.setAttribute('aria-labelledby', tab.id);
        resultEl.classList.toggle('is-good', isForever);
        resultEl.classList.toggle('is-bad', !isForever);
        resultEl.textContent = isForever ? trapForeverText : trap7dText;
      }

      tabs.forEach(function (tab, index) {
        tab.addEventListener('click', function () {
          activateTrapTab(tab, false);
        });
        tab.addEventListener('keydown', function (event) {
          var nextIndex = index;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          activateTrapTab(tabs[nextIndex], true);
        });
      });
    }

    function initAdbCopyButton() {
      var copyBtn = document.getElementById('kao-copy-adb');
      if (!copyBtn) return;

      var resetTimer = null;
      copyBtn.addEventListener('click', function () {
        if (navigator.clipboard) navigator.clipboard.writeText(ADB_INSTALL_COMMAND);
        copyBtn.classList.add('is-copied');
        clearTimeout(resetTimer);
        resetTimer = setTimeout(function () { copyBtn.classList.remove('is-copied'); }, 1800);
      });
    }

    function initQuickJumpButton() {
      var heroEl = document.getElementById('kao-hero');
      var stepsHeading = document.getElementById('sl-lock-steps');
      var jumpBtn = document.getElementById('kao-quick-jump');
      if (!heroEl || !stepsHeading || !jumpBtn || !('IntersectionObserver' in window)) return;

      var heroVisible = true;
      var stepsVisible = false;
      function syncVisibility() {
        jumpBtn.hidden = heroVisible || stepsVisible;
      }

      new IntersectionObserver(function (entries) {
        heroVisible = entries[0].isIntersecting;
        syncVisibility();
      }).observe(heroEl);

      new IntersectionObserver(function (entries) {
        stepsVisible = entries[0].isIntersecting;
        syncVisibility();
      }).observe(stepsHeading);
    }

    function initScrollProgressBar() {
      var progressBar = document.getElementById('kao-scroll-progress');
      if (!progressBar) return;

      function update() {
        var scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        var ratio = scrollableHeight > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollableHeight)) : 0;
        progressBar.style.transform = 'scaleX(' + ratio.toFixed(4) + ')';
      }

      window.addEventListener('scroll', update, { passive: true });
      update();
    }

    function initShareButton() {
      var shareBtn = document.getElementById('kao-share-btn');
      if (!shareBtn) return;

      var resetTimer = null;
      shareBtn.addEventListener('click', function () {
        var url = window.location.href;
        if (navigator.share) {
          navigator.share({
            title: shareTitle,
            text: shareLead,
            url: url,
          }).catch(function () {});
          return;
        }
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(url);
        var previousText = shareBtn.textContent;
        shareBtn.textContent = copiedToast;
        clearTimeout(resetTimer);
        resetTimer = setTimeout(function () { shareBtn.textContent = previousText; }, 1800);
      });
    }

    function initAffectedChecker() {
      var checker = document.getElementById('kao-checker');
      var resultEl = document.getElementById('kao-checker-result');
      if (!checker || !resultEl) return;

      var answers = { gms: 'yes', method: 'apk' };

      function renderResult() {
        var isSafe = answers.gms === 'no' || answers.method === 'adb';
        resultEl.classList.toggle('is-safe', isSafe);
        resultEl.classList.toggle('is-affected', !isSafe);

        if (answers.gms === 'no') {
          resultEl.textContent = resDeGoogled;
          return;
        }
        if (answers.method === 'adb') {
          resultEl.textContent = resAdb;
          return;
        }
        resultEl.textContent = resAffected;
      }

      checker.querySelectorAll('.kao-q-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var question = btn.getAttribute('data-q');
          answers[question] = btn.getAttribute('data-val');
          checker.querySelectorAll('.kao-q-btn[data-q="' + question + '"]').forEach(function (option) {
            var isSel = option === btn;
            option.classList.toggle('is-selected', isSel);
            option.setAttribute('aria-pressed', isSel ? 'true' : 'false');
          });
          renderResult();
        });
      });
    }

    function initDeveloperEasterEgg() {
      var stepBadge = document.getElementById('kao-step1-badge');
      var toast = document.getElementById('kao-dev-toast');
      if (!stepBadge || !toast) return;

      var tapCount = 0;
      var hideTimer = null;
      stepBadge.addEventListener('click', function (event) {
        event.stopPropagation();
        tapCount++;
        if (tapCount < 7) return;
        tapCount = 0;
        toast.hidden = false;
        clearTimeout(hideTimer);
        hideTimer = setTimeout(function () { toast.hidden = true; }, 2600);
      });
    }

    function formatIcsUtc(date) {
      return date.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');
    }

    function initCalendarReminder() {
      var icsBtn = document.getElementById('kao-timer-ics');
      if (!icsBtn) return;

      icsBtn.addEventListener('click', function (event) {
        event.stopPropagation();
        var startTime = new Date(Date.now() + HOURS_24_MS);
        var endTime = new Date(startTime.getTime() + 15 * 60 * 1000);
        var summary = 'Android 24h Lock: Allow indefinitely';
        var description = 'Settings -> System -> Developer Options -> Apps from unverified developers -> Allow indefinitely';
        var icsText = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//ApkUp//24h Lock Reminder//EN',
          'BEGIN:VEVENT',
          'UID:apkup-24h-' + startTime.getTime() + '@durcheins.github.io',
          'DTSTAMP:' + formatIcsUtc(new Date()),
          'DTSTART:' + formatIcsUtc(startTime),
          'DTEND:' + formatIcsUtc(endTime),
          'SUMMARY:' + summary,
          'DESCRIPTION:' + description,
          'BEGIN:VALARM',
          'TRIGGER:-PT0M',
          'ACTION:DISPLAY',
          'DESCRIPTION:' + summary,
          'END:VALARM',
          'END:VEVENT',
          'END:VCALENDAR',
        ].join('\r\n');
        var blob = new Blob([icsText], { type: 'text/calendar;charset=utf-8' });
        var downloadLink = document.createElement('a');
        downloadLink.href = URL.createObjectURL(blob);
        downloadLink.download = 'apkup-android-24h-unlock.ics';
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
        setTimeout(function () { URL.revokeObjectURL(downloadLink.href); }, 1000);
      });
    }

    function initSafeColumnHighlight() {
      var table = document.getElementById('kao-compare-table');
      var safeHeader = document.getElementById('kao-col-safe-th');
      if (!table || !safeHeader) return;

      safeHeader.addEventListener('mouseenter', function () { table.classList.add('is-col-safe-hl'); });
      safeHeader.addEventListener('mouseleave', function () { table.classList.remove('is-col-safe-hl'); });
      safeHeader.addEventListener('click', function () { table.classList.toggle('is-col-safe-hl'); });
    }

    function initAnchorHighlightFlash() {
      var lockSection = document.getElementById('sl-lock-section');
      if (!lockSection) return;

      document.querySelectorAll('[data-kao-jump-steps]').forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          lockSection.classList.remove('kao-anchor-flash');
          void lockSection.offsetWidth;
          lockSection.classList.add('kao-anchor-flash');
        });
      });
    }

    initGlobalCountdown();
    initCardSpotlights();
    initScrollReveal();
    initUnlockChecklist();
    initTrapSimulator();
    initAdbCopyButton();
    initQuickJumpButton();
    initScrollProgressBar();
    initShareButton();
    initAffectedChecker();
    initDeveloperEasterEgg();
    initCalendarReminder();
    initSafeColumnHighlight();
    initAnchorHighlightFlash();
  })();
</script>
