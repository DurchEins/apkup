---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  DEFAULT_LOCALE,
  absoluteLocaleUrl,
  getTranslations,
  type Locale,
} from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(lang);
const c = t.comparePage;
---

<BaseLayout
  lang={lang}
  subPath="compare/"
  title={c.title}
  description={c.metaDesc}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: c.title,
    url: absoluteLocaleUrl(lang, 'compare/'),
    author: { '@type': 'Person', name: 'DurchEins', url: 'https://github.com/DurchEins' },
    about: { '@type': 'SoftwareApplication', name: 'ApkUp' },
  }}
>
  <Navbar lang={lang} />
  <main id="main-content" class="section">
    <div class="container subpage-wrap">
      <div id="comparison" class="compare-block">
        <div class="section-header">
          <h1 class="section-title">{c.h1}</h1>
          <p class="section-subtitle">{c.lead}</p>
        </div>

        <div class="compare-table-card">
          <div class="compare-scroll">
            <table class="compare-table">
              <thead>
                <tr>
                  <th>{c.thCapability}</th>
                  <th class="is-apkup">ApkUp</th>
                  <th>Obtainium</th>
                  <th>Aurora Store</th>
                  <th>F-Droid</th>
                </tr>
              </thead>
              <tbody>
                {
                  c.rows.map((row) => (
                    <tr>
                      <td>{row.cap}</td>
                      <td class="is-apkup mono">{row.apkup}</td>
                      <td class="mono">{row.obt}</td>
                      <td class="mono">{row.aur}</td>
                      <td class="mono">{row.fdr}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div id="checker" class="checker-block">
        <div class="section-header">
          <h2 class="section-title">{c.checkerTitle}</h2>
          <p class="section-subtitle">{c.checkerLead}</p>
        </div>

        <div class="compat-card">
          <div class="compat-actions">
            <label class="btn btn-primary" for="obt-file-input">
              {c.chooseFile}
            </label>
            <input type="file" id="obt-file-input" accept=".json,application/json" hidden />
            <button type="button" class="btn btn-secondary" id="obt-sample-btn">
              {c.loadSample}
            </button>
          </div>

          <textarea
            id="obt-json-input"
            class="compat-textarea mono"
            rows="7"
            placeholder='{"apps": [{"id": "com.apkup", "url": "https://github.com/DurchEins/apkup", "name": "ApkUp"}]}'
            aria-label={c.textareaAria}
          ></textarea>

          <div id="obt-report" class="compat-report" hidden></div>
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} subPath="compare/" />
</BaseLayout>

<script is:inline define:vars={{ reportMsg: c.report }}>
  (function () {
    var fileInput = document.getElementById('obt-file-input');
    var textarea = document.getElementById('obt-json-input');
    var sampleBtn = document.getElementById('obt-sample-btn');
    var report = document.getElementById('obt-report');

    if (textarea) {
      textarea.addEventListener('dragover', function (e) {
        e.preventDefault();
        textarea.classList.add('is-dragover');
      });
      textarea.addEventListener('dragleave', function () {
        textarea.classList.remove('is-dragover');
      });
      textarea.addEventListener('drop', function (e) {
        e.preventDefault();
        textarea.classList.remove('is-dragover');
        var file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function () {
          textarea.value = String(reader.result || '');
          textarea.dispatchEvent(new Event('input', { bubbles: true }));
        };
        reader.readAsText(file);
      });
    }

    function classifyUrl(url) {
      var u = (url || '').toLowerCase();
      if (u.includes('github.com')) return 'GitHub';
      if (u.includes('gitlab')) return 'GitLab';
      if (u.includes('codeberg.org') || u.includes('forgejo') || u.includes('gitea')) return 'Codeberg / Forgejo';
      if (u.includes('izzysoft.de')) return 'IzzyOnDroid';
      if (u.includes('f-droid.org') || u.includes('fdroid')) return 'F-Droid Index V2';
      if (u.includes('apkmirror.com')) return 'APKMirror';
      if (u.includes('play.google.com')) return 'Google Play';
      return reportMsg.custom;
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function analyze(raw) {
      if (!report) return;
      var text = (raw || '').trim();
      if (!text) {
        report.hidden = true;
        return;
      }
      try {
        var parsed = JSON.parse(text);
        var apps = Array.isArray(parsed) ? parsed : Array.isArray(parsed.apps) ? parsed.apps : [];
        if (!apps.length) {
          report.hidden = false;
          report.innerHTML = '<p class="compat-err">' + escapeHtml(reportMsg.empty) + '</p>';
          return;
        }
        var rows = apps.map(function (a) {
          var name = escapeHtml(a.name || a.id || 'Unknown App');
          var rawUrl = String(a.url || '');
          var url = escapeHtml(rawUrl);
          var src = classifyUrl(rawUrl);
          var ok = src !== reportMsg.custom;
          return (
            '<div class="compat-row">' +
            '<div><strong>' + name + '</strong><div class="mono compat-url">' + url + '</div></div>' +
            '<span class="pill-badge ' + (ok ? 'pill-emerald' : 'pill-amber') + ' mono">' + escapeHtml(src) + '</span>' +
            '</div>'
          );
        });
        report.hidden = false;
        report.innerHTML =
          '<div class="compat-summary mono">' + apps.length + ' ' + escapeHtml(reportMsg.appsFound) + '</div>' +
          '<div class="compat-rows">' + rows.join('') + '</div>';
      } catch (e) {
        report.hidden = false;
        report.innerHTML = '<p class="compat-err">' + escapeHtml(reportMsg.invalidJson) + '</p>';
      }
    }

    if (textarea) {
      textarea.addEventListener('input', function () {
        analyze(textarea.value);
      });
    }

    if (fileInput && textarea) {
      fileInput.addEventListener('change', function () {
        var file = fileInput.files && fileInput.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function () {
          textarea.value = String(reader.result || '');
          analyze(textarea.value);
        };
        reader.readAsText(file);
      });
    }

    if (sampleBtn && textarea) {
      sampleBtn.addEventListener('click', function () {
        var sample = {
          apps: [
            { id: 'com.apkup', name: 'ApkUp', url: 'https://github.com/DurchEins/apkup' },
            { id: 'com.aurora.store', name: 'Aurora Store', url: 'https://gitlab.com/AuroraOSS/AuroraStore' },
            { id: 'nodomain.freeyourgadget.gadgetbridge', name: 'Gadgetbridge', url: 'https://codeberg.org/Freeyourgadget/Gadgetbridge' },
            { id: 'app.organicmaps', name: 'Organic Maps', url: 'https://apt.izzysoft.de/fdroid/index/apk/app.organicmaps' },
          ],
        };
        textarea.value = JSON.stringify(sample, null, 2);
        analyze(textarea.value);
      });
    }
  })();
</script>

<style>
  .subpage-wrap {
    max-width: 1060px;
  }

  .compare-block {
    margin-block-end: 56px;
  }

  .checker-block {
    scroll-margin-block-start: calc(var(--header-height) + 24px);
  }

  .compare-table-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: 8px 18px;
  }

  .compare-scroll {
    overflow-x: auto;
  }

  .compare-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    text-align: start;
    font-size: 0.86rem;
  }

  .compare-table th:first-child,
  .compare-table td:first-child {
    width: 34%;
  }

  .compare-table th:nth-child(2),
  .compare-table td:nth-child(2) {
    width: 18%;
  }

  .compare-table th:nth-child(n + 3),
  .compare-table td:nth-child(n + 3) {
    width: 16%;
  }

  .compare-table th,
  .compare-table td {
    padding: 12px 10px;
    border-block-end: 1px solid var(--outline);
    overflow-wrap: break-word;
    vertical-align: top;
  }

  .compare-table tr:last-child td {
    border-block-end: none;
  }

  .compare-table tbody tr {
    transition: background-color 140ms ease-out;
  }

  @media (hover: hover) {
    .compare-table tbody tr:hover {
      background-color: var(--surface);
    }
  }

  .compare-table th {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 800;
  }

  .compare-table td.is-apkup {
    color: var(--accent);
    font-weight: 700;
    background: rgba(245, 158, 11, 0.05);
  }

  @media (max-width: 720px) {
    .compare-table {
      table-layout: auto;
      min-width: 560px;
    }
  }

  .compat-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .compat-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .compat-textarea {
    width: 100%;
    padding: 14px;
    border-radius: var(--radius-md);
    border: 1px solid var(--outline-strong);
    background: var(--bg);
    color: var(--text);
    font-size: 0.85rem;
    resize: vertical;
  }

  .compat-summary {
    font-size: 0.85rem;
    color: var(--accent);
    margin-bottom: 12px;
    font-weight: 700;
  }

  .compat-rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .compat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--bg);
    border: 1px solid var(--outline);
  }

  .compat-url {
    font-size: 0.76rem;
    color: var(--text-muted);
    word-break: break-all;
  }

  .compat-err {
    color: var(--danger);
    margin: 0;
  }
</style>
