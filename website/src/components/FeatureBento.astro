---
import { DEFAULT_LOCALE, getTranslations, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(lang);
const cards = t.bento.cards;
---

<section id="features" class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t.bento.title}</h2>
      <p class="section-subtitle">{t.bento.subtitle}</p>
    </div>

    <div class="bento-grid">
      <article class="bento-card has-spotlight bento-highlight">
        <div class="bento-head">
          <div class="bento-icon amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M3.6 9h16.8M3.6 15h16.8" />
              <path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
            </svg>
          </div>
          <span class="pill-badge pill-amber mono">{cards[0].badge}</span>
        </div>
        <h3>{cards[0].title}</h3>
        <p>{cards[0].desc}</p>
      </article>

      <article class="bento-card has-spotlight">
        <div class="bento-head">
          <div class="bento-icon emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />
            </svg>
          </div>
          <span class="pill-badge pill-emerald mono">{cards[1].badge}</span>
        </div>
        <h3>{cards[1].title}</h3>
        <p>{cards[1].desc}</p>
      </article>

      <article class="bento-card has-spotlight">
        <div class="bento-head">
          <div class="bento-icon amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </div>
          <span class="pill-badge pill-neutral mono">{cards[2].badge}</span>
        </div>
        <h3>{cards[2].title}</h3>
        <p>{cards[2].desc}</p>
      </article>

      <article class="bento-card has-spotlight">
        <div class="bento-head">
          <div class="bento-icon neutral">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
          </div>
          <span class="pill-badge pill-neutral mono">{cards[3].badge}</span>
        </div>
        <h3>{cards[3].title}</h3>
        <p>{cards[3].desc}</p>
      </article>

      <article class="bento-card has-spotlight">
        <div class="bento-head">
          <div class="bento-icon neutral">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
            </svg>
          </div>
          <span class="pill-badge pill-neutral mono">{cards[4].badge}</span>
        </div>
        <h3>{cards[4].title}</h3>
        <p>{cards[4].desc}</p>
      </article>

      <article class="bento-card has-spotlight">
        <div class="bento-head">
          <div class="bento-icon amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <path d="M8 12h8M12 8v8" />
            </svg>
          </div>
          <span class="pill-badge pill-neutral mono">{cards[5].badge}</span>
        </div>
        <h3>{cards[5].title}</h3>
        <p>{cards[5].desc}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .bento-card {
    position: relative;
    overflow: hidden;
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .bento-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 50%),
      rgba(245, 158, 11, 0.11),
      transparent 70%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease-out;
  }

  @media (hover: hover) {
    .bento-card:hover::before {
      opacity: 1;
    }
  }

  .bento-wide {
    grid-column: span 2;
  }

  .bento-highlight {
    background:
      radial-gradient(360px 200px at 95% 5%, rgba(245, 158, 11, 0.1), transparent 70%),
      var(--surface-low);
    border-color: var(--outline-strong);
  }

  .bento-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .bento-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    display: grid;
    place-items: center;
  }

  .bento-icon.amber {
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
  }

  .bento-icon.emerald {
    background: var(--tertiary-soft);
    color: var(--tertiary-soft-ink);
  }

  .bento-icon.neutral {
    background: var(--surface);
    color: var(--text);
  }

  .bento-card h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .bento-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.96rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 960px) {
    .bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bento-wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .bento-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .bento-wide {
      grid-column: span 1;
    }
  }
</style>
