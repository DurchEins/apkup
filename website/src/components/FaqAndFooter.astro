---
import { FAQS, SITE } from '../data/content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section id="faq" class="section">
  <div class="container faq-container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="i18n-en">Frequently asked questions</span>
        <span class="i18n-de">Häufige Fragen</span>
      </h2>
      <p class="section-subtitle">
        <span class="i18n-en">
          Clear answers on permissions, signature checks, privacy, and migrating from other
          updaters.
        </span>
        <span class="i18n-de">
          Klare Antworten zu Berechtigungen, Signaturprüfungen, Datenschutz und dem Umstieg von
          anderen Updaters.
        </span>
      </p>
    </div>

    <div class="faq-list">
      {
        FAQS.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span class="i18n-en">{item.qEn}</span>
              <span class="i18n-de">{item.qDe}</span>
              <svg
                class="faq-chevron"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq-answer">
              <p class="i18n-en">{item.aEn}</p>
              <p class="i18n-de">{item.aDe}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src={`${base}assets/logo.png`} alt="" width="32" height="32" class="footer-icon" />
      <div>
        <strong>ApkUp</strong>
        <p class="footer-copy">
          Copyright © 2026 DurchEins • GPL-3.0 •{' '}
          <span class="i18n-en">Based on APKUpdater by rumboalla</span>
          <span class="i18n-de">Basiert auf APKUpdater von rumboalla</span>
        </p>
      </div>
    </div>

    <nav class="footer-links" aria-label="Footer links">
      <a href={SITE.repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={SITE.wikiUrl} target="_blank" rel="noopener noreferrer">Wiki</a>
      <a href={SITE.privacyUrl} target="_blank" rel="noopener noreferrer">Privacy</a>
      <a href={SITE.securityUrl} target="_blank" rel="noopener noreferrer">Security</a>
      <a href={SITE.licenseUrl} target="_blank" rel="noopener noreferrer">GPL-3.0</a>
      <a href={SITE.issuesUrl} target="_blank" rel="noopener noreferrer">Issues</a>
    </nav>
  </div>
</footer>

<style>
  .faq-container {
    max-width: 860px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 4px 20px;
  }

  .faq-item[open] {
    border-color: var(--outline-strong);
    background: var(--surface);
  }

  .faq-question {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding-block: 12px;
    font-weight: 700;
    font-size: 1.02rem;
    cursor: pointer;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 150ms ease-out;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .faq-answer {
    padding-block-end: 18px;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .faq-answer p {
    margin: 0;
    max-width: 70ch;
  }

  .site-footer {
    border-block-start: 1px solid var(--outline);
    background: var(--surface-lowest);
    padding-block: 32px;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-icon {
    border-radius: 8px;
  }

  .footer-copy {
    margin: 2px 0 0;
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .footer-links a {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    padding-block: 6px;
  }

  @media (hover: hover) {
    .footer-links a:hover {
      color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none;
    }
  }
</style>
