---
import { getBaseUrl } from '../utils/site';
import { DEFAULT_LOCALE, getTranslations, localePath, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(lang);
const base = getBaseUrl();
const homeHref = localePath(lang, '');
---

<header class="site-header">
  <div class="container nav-inner">
    <a class="brand" href={homeHref} aria-label={t.nav.homeAria}>
      <img src={`${base}assets/logo.png`} alt="" width="36" height="36" class="brand-icon" />
      <span class="brand-name">ApkUp</span>
    </a>

    <nav class="nav-links" aria-label={t.nav.primaryAria}>
      <a href={`${homeHref}#features`}>{t.nav.features}</a>
      <a href={`${homeHref}#showcase`}>{t.nav.showcase}</a>
      <a href={`${homeHref}#sources`}>{t.nav.sources}</a>
      <a href={localePath(lang, 'changelog/')}>{t.nav.whatsNew}</a>
      <a href={localePath(lang, 'wiki/')}>{t.nav.wiki}</a>
      <a href={localePath(lang, 'privacy/')}>{t.nav.privacy}</a>
      <a href={localePath(lang, 'downloads/')}>{t.nav.downloads}</a>
    </nav>

    <div class="nav-actions">
      <button
        id="theme-toggle"
        type="button"
        class="icon-pill icon-only"
        aria-label={t.nav.toggleThemeAria}
        title={t.nav.toggleThemeAria}
      >
        <svg
          class="theme-icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg
          class="theme-icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>

      <a class="btn btn-primary nav-cta" href={`${homeHref}#downloads`}>
        {t.nav.download}
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="icon-pill icon-only mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label={t.nav.toggleMenuAria}
      >
        <svg class="menu-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <svg class="menu-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav-panel" class="mobile-nav-panel" aria-label={t.nav.mobileAria} hidden>
    <div class="container mobile-nav-list">
      <a href={`${homeHref}#features`}>{t.nav.features}</a>
      <a href={`${homeHref}#showcase`}>{t.nav.showcase}</a>
      <a href={`${homeHref}#sources`}>{t.nav.sources}</a>
      <a href={localePath(lang, 'changelog/')}>{t.nav.whatsNew}</a>
      <a href={localePath(lang, 'wiki/')}>{t.nav.wiki}</a>
      <a href={localePath(lang, 'privacy/')}>{t.nav.privacy}</a>
      <a href={localePath(lang, 'downloads/')}>{t.nav.downloads}</a>
      <a class="btn btn-primary mobile-nav-cta" href={`${homeHref}#downloads`}>
        {t.nav.download}
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('mobile-menu-toggle');
    var panel = document.getElementById('mobile-nav-panel');

    var path = window.location.pathname.replace(/\/$/, '');
    var navLinks = Array.prototype.slice.call(document.querySelectorAll('.nav-links a'));
    navLinks.forEach(function (a) {
      var href = (a.getAttribute('href') || '').replace(/\/$/, '');
      if (href.indexOf('#') === -1 && href && path === href) {
        a.classList.add('is-current');
      }
    });

    var secIds = ['features', 'showcase', 'sources'];
    var secEls = secIds.map(function (id) { return document.getElementById(id); }).filter(Boolean);
    if (secEls.length && 'IntersectionObserver' in window) {
      var spy = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var hash = '#' + entry.target.id;
          navLinks.forEach(function (a) {
            var h = a.getAttribute('href') || '';
            if (h.indexOf('#') !== -1) {
              a.classList.toggle('is-current', h.slice(h.indexOf('#')) === hash);
            }
          });
        });
      }, { rootMargin: '-30% 0px -60% 0px' });
      secEls.forEach(function (el) { spy.observe(el); });
    }

    if (!btn || !panel) return;

    function closeMenu() {
      panel.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var nextOpen = panel.hidden;
      panel.hidden = !nextOpen;
      btn.setAttribute('aria-expanded', String(nextOpen));
    });

    panel.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) closeMenu();
    });

    document.addEventListener('click', function (e) {
      if (!panel.hidden && !panel.contains(e.target) && !btn.contains(e.target)) {
        closeMenu();
      }
    });

    // Easter Egg: 5 rapid clicks on ApkUp logo -> amber sparks + toast
    var brand = document.querySelector('.site-header .brand');
    if (brand) {
      var clicks = 0;
      var clickTimer = null;
      brand.addEventListener('click', function (e) {
        clicks++;
        clearTimeout(clickTimer);
        clickTimer = setTimeout(function () { clicks = 0; }, 1200);
        if (clicks >= 5) {
          e.preventDefault();
          clicks = 0;
          var rect = brand.getBoundingClientRect();
          for (var i = 0; i < 12; i++) {
            var spark = document.createElement('span');
            spark.className = 'brand-spark';
            var angle = (Math.PI * 2 * i) / 12;
            var dist = 28 + Math.random() * 24;
            spark.style.left = rect.left + 20 + 'px';
            spark.style.top = rect.top + 20 + 'px';
            spark.style.setProperty('--dx', Math.cos(angle) * dist + 'px');
            spark.style.setProperty('--dy', Math.sin(angle) * dist + 'px');
            document.body.appendChild(spark);
            setTimeout((function (el) { return function () { el.remove(); }; })(spark), 700);
          }
          var toast = document.createElement('div');
          toast.className = 'brand-toast mono';
          toast.textContent = 'Open Source since 2026 ⚡';
          document.body.appendChild(toast);
          setTimeout(function () { toast.remove(); }, 2400);
        }
      });
    }
  })();
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    height: var(--header-height);
    background: var(--nav-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-block-end: 1px solid var(--outline);
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .brand-icon {
    border-radius: 10px;
    transition: transform 220ms cubic-bezier(0.2, 0, 0, 1), filter 220ms ease-out;
  }

  @media (prefers-reduced-motion: no-preference) {
    .brand:hover .brand-icon,
    .brand:focus-visible .brand-icon {
      transform: rotate(-7deg) scale(1.07);
      filter: drop-shadow(0 0 10px rgba(245, 158, 11, 0.45));
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-links a {
    position: relative;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--text-muted);
    white-space: nowrap;
    transition: background-color 150ms ease-out, color 150ms ease-out;
  }

  .nav-links a.is-current {
    color: var(--text);
    background-color: var(--surface);
  }

  .nav-links a.is-current::after {
    content: '';
    position: absolute;
    inset-inline: 18px;
    bottom: 2px;
    height: 2px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.7);
  }

  @media (hover: hover) {
    .nav-links a:hover {
      background-color: var(--surface);
      color: var(--text);
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .icon-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding-inline: 12px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--outline);
    font-size: 0.85rem;
    font-weight: 700;
    transition: background-color 150ms ease-out, transform 150ms ease-out;
  }

  .icon-pill.icon-only {
    padding-inline: 0;
  }

  .icon-pill:active {
    transform: scale(0.96);
  }

  @media (hover: hover) {
    .icon-pill:hover {
      background: var(--surface-high);
    }
  }

  [data-theme='dark'] .theme-icon-moon {
    display: none;
  }
  [data-theme='light'] .theme-icon-sun {
    display: none;
  }

  .nav-cta {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 0.9rem;
  }

  #theme-toggle svg {
    transition: transform 280ms cubic-bezier(0.2, 0, 0, 1);
  }

  #theme-toggle:active svg {
    transform: rotate(180deg) scale(0.88);
  }

  .brand-spark {
    position: fixed;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #f59e0b;
    pointer-events: none;
    z-index: 9999;
    animation: brandSparkFly 650ms cubic-bezier(0.2, 0, 0, 1) forwards;
  }

  @keyframes brandSparkFly {
    from {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }
    to {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) scale(0.3);
    }
  }

  .brand-toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--surface-high);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
    animation: qrDialogIn 220ms ease-out;
  }

  .mobile-menu-btn {
    display: none;
  }

  .mobile-menu-btn .menu-icon-close {
    display: none;
  }

  .mobile-menu-btn[aria-expanded='true'] .menu-icon-open {
    display: none;
  }

  .mobile-menu-btn[aria-expanded='true'] .menu-icon-close {
    display: block;
  }

  .mobile-nav-panel {
    position: absolute;
    inset-block-start: 100%;
    inset-inline: 0;
    background: var(--surface-low);
    border-block-end: 1px solid var(--outline-strong);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    padding-block: 12px 18px;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-nav-list a:not(.btn) {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 14px;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 600;
    color: var(--text);
  }

  .mobile-nav-list a:not(.btn):hover,
  .mobile-nav-list a:not(.btn):focus-visible {
    background: var(--surface-high);
  }

  .mobile-nav-cta {
    display: none;
    margin-top: 8px;
    justify-content: center;
  }

  @media (max-width: 960px) {
    .nav-links {
      display: none;
    }

    .mobile-menu-btn {
      display: inline-flex;
    }
  }

  @media (max-width: 400px) {
    .nav-cta {
      display: none;
    }

    .mobile-nav-cta {
      display: inline-flex;
    }
  }
</style>
