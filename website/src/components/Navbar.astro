---
import { SITE } from '../data/content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <div class="container nav-inner">
    <a class="brand" href={base} aria-label="ApkUp Home">
      <img src={`${base}assets/logo.png`} alt="" width="36" height="36" class="brand-icon" />
      <span class="brand-name">ApkUp</span>
    </a>

    <nav class="nav-links" aria-label="Primary navigation">
      <a href={`${base}#features`}>
        <span class="i18n-en">Features</span>
        <span class="i18n-de">Funktionen</span>
      </a>
      <a href={`${base}#showcase`}>
        <span class="i18n-en">Showcase</span>
        <span class="i18n-de">Einblicke</span>
      </a>
      <a href={`${base}#sources`}>
        <span class="i18n-en">Sources</span>
        <span class="i18n-de">Quellen</span>
      </a>
      <a href={`${base}changelog/`}>
        <span class="i18n-en">What’s New?</span>
        <span class="i18n-de">Was ist neu?</span>
      </a>
      <a href={`${base}wiki/`}>Wiki</a>
      <a href={`${base}privacy/`}>Privacy</a>
      <a href={`${base}downloads/`}>Downloads</a>
    </nav>

    <div class="nav-actions">
      <button
        id="lang-toggle"
        type="button"
        class="icon-pill"
        aria-label="Switch language between English and German"
        title="EN / DE"
      >
        <span class="i18n-en">DE</span>
        <span class="i18n-de">EN</span>
      </button>

      <button
        id="theme-toggle"
        type="button"
        class="icon-pill icon-only"
        aria-label="Toggle light and dark theme"
        title="Toggle theme"
      >
        <!-- Sun icon (shown in dark mode to switch to light) -->
        <svg
          class="theme-icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <!-- Moon icon (shown in light mode to switch to dark) -->
        <svg
          class="theme-icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>

      <a class="btn btn-primary nav-cta" href={`${base}#downloads`}>
        <span class="i18n-en">Download</span>
        <span class="i18n-de">Herunterladen</span>
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="icon-pill icon-only mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Toggle navigation menu"
      >
        <svg class="menu-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <svg class="menu-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav-panel" class="mobile-nav-panel" aria-label="Mobile navigation" hidden>
    <div class="container mobile-nav-list">
      <a href={`${base}#features`}>
        <span class="i18n-en">Features</span>
        <span class="i18n-de">Funktionen</span>
      </a>
      <a href={`${base}#showcase`}>
        <span class="i18n-en">Showcase</span>
        <span class="i18n-de">Einblicke</span>
      </a>
      <a href={`${base}#sources`}>
        <span class="i18n-en">Sources</span>
        <span class="i18n-de">Quellen</span>
      </a>
      <a href={`${base}changelog/`}>
        <span class="i18n-en">What’s New?</span>
        <span class="i18n-de">Was ist neu?</span>
      </a>
      <a href={`${base}wiki/`}>Wiki</a>
      <a href={`${base}privacy/`}>Privacy</a>
      <a href={`${base}downloads/`}>Downloads</a>
      <a class="btn btn-primary mobile-nav-cta" href={`${base}#downloads`}>
        <span class="i18n-en">Download</span>
        <span class="i18n-de">Herunterladen</span>
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('mobile-menu-toggle');
    var panel = document.getElementById('mobile-nav-panel');
    if (!btn || !panel) return;

    function closeMenu() {
      panel.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var nextOpen = panel.hidden;
      panel.hidden = !nextOpen;
      btn.setAttribute('aria-expanded', String(nextOpen));
    });

    panel.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) closeMenu();
    });

    document.addEventListener('click', function (e) {
      if (!panel.hidden && !panel.contains(e.target) && !btn.contains(e.target)) {
        closeMenu();
      }
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    height: var(--header-height);
    background: var(--nav-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-block-end: 1px solid var(--outline);
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .brand-icon {
    border-radius: 10px;
    transition: transform 220ms cubic-bezier(0.2, 0, 0, 1), filter 220ms ease-out;
  }

  @media (prefers-reduced-motion: no-preference) {
    .brand:hover .brand-icon,
    .brand:focus-visible .brand-icon {
      transform: rotate(-7deg) scale(1.07);
      filter: drop-shadow(0 0 10px rgba(245, 158, 11, 0.45));
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-links a {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--text-muted);
    transition: background-color 150ms ease-out, color 150ms ease-out;
  }

  @media (hover: hover) {
    .nav-links a:hover {
      background-color: var(--surface);
      color: var(--text);
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .icon-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding-inline: 12px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--outline);
    font-size: 0.85rem;
    font-weight: 700;
    transition: background-color 150ms ease-out, transform 150ms ease-out;
  }

  .icon-pill.icon-only {
    padding-inline: 0;
  }

  .icon-pill:active {
    transform: scale(0.96);
  }

  @media (hover: hover) {
    .icon-pill:hover {
      background: var(--surface-high);
    }
  }

  [data-theme='dark'] .theme-icon-moon {
    display: none;
  }
  [data-theme='light'] .theme-icon-sun {
    display: none;
  }

  .nav-cta {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 0.9rem;
  }

  .mobile-menu-btn {
    display: none;
  }

  .mobile-menu-btn .menu-icon-close {
    display: none;
  }

  .mobile-menu-btn[aria-expanded='true'] .menu-icon-open {
    display: none;
  }

  .mobile-menu-btn[aria-expanded='true'] .menu-icon-close {
    display: block;
  }

  .mobile-nav-panel {
    position: absolute;
    inset-block-start: 100%;
    inset-inline: 0;
    background: var(--surface-low);
    border-block-end: 1px solid var(--outline-strong);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    padding-block: 12px 18px;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-nav-list a:not(.btn) {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 14px;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 600;
    color: var(--text);
  }

  .mobile-nav-list a:not(.btn):hover,
  .mobile-nav-list a:not(.btn):focus-visible {
    background: var(--surface-high);
  }

  .mobile-nav-cta {
    display: none;
    margin-top: 8px;
    justify-content: center;
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }

    .mobile-menu-btn {
      display: inline-flex;
    }
  }

  @media (max-width: 400px) {
    .nav-cta {
      display: none;
    }

    .mobile-nav-cta {
      display: inline-flex;
    }
  }
</style>
