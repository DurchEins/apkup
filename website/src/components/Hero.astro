---
import { SITE } from '../data/content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section id="top" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="hero-badges">
        <span class="pill-badge pill-amber mono" id="hero-version-pill">
          v{SITE.fallbackVersion} ({SITE.fallbackBuild})
        </span>
        <span class="pill-badge pill-emerald">
          <span class="i18n-en">GPL-3.0 Open Source</span>
          <span class="i18n-de">GPL-3.0 Open Source</span>
        </span>
      </div>

      <h1 class="hero-title">
        <span class="i18n-en">Every Android app update. One privacy-first hub.</span>
        <span class="i18n-de">Alle Android-App-Updates. Eine sichere App.</span>
      </h1>

      <p class="hero-lead">
        <span class="i18n-en">
          ApkUp discovers, verifies, and autonomously installs app updates across Google Play,
          F-Droid Index V2, IzzyOnDroid, APKMirror, GitHub, GitLab, and Codeberg — with zero ads,
          zero tracking, and silent Shizuku or Root background installs.
        </span>
        <span class="i18n-de">
          ApkUp findet, prüft und installiert App-Updates über Google Play, F-Droid Index V2,
          IzzyOnDroid, APKMirror, GitHub, GitLab und Codeberg – komplett werbefrei, ohne Tracking
          und auf Wunsch lautlos im Hintergrund per Shizuku oder Root.
        </span>
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary hero-download" href={SITE.releasesUrl} data-apk-link>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3v12" />
            <path d="m7 10 5 5 5-5" />
            <path d="M5 21h14" />
          </svg>
          <span class="i18n-en">Download <span class="apk-light">Apk</span><strong class="apk-up">Up</strong> <span data-apk-meta>(v{SITE.fallbackVersion})</span></span>
          <span class="i18n-de"><span class="apk-light">Apk</span><strong class="apk-up">Up</strong> laden <span data-apk-meta>(v{SITE.fallbackVersion})</span></span>
        </a>

        <button type="button" class="btn btn-secondary" data-open-qr>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <path d="M14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 18v3" />
          </svg>
          <span>QR-Code</span>
        </button>

        <button class="btn btn-ghost" type="button" data-share-btn>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="18" cy="5" r="3" />
            <circle cx="6" cy="12" r="3" />
            <circle cx="18" cy="19" r="3" />
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
          </svg>
          <span data-share-label>
            <span class="i18n-en">Share</span>
            <span class="i18n-de">Teilen</span>
          </span>
          <span data-share-copied hidden>
            <span class="i18n-en">Link copied!</span>
            <span class="i18n-de">Link kopiert!</span>
          </span>
        </button>
      </div>

      <p class="hero-meta mono" id="hero-meta">
        <span class="i18n-en">Android 10.0 – 17 (API 29+) • Verified SHA-256 • 9 Languages</span>
        <span class="i18n-de">Android 10.0 – 17 (API 29+) • SHA-256-geprüft • 9 Sprachen</span>
      </p>

      <div class="hero-install-hint" id="hero-install-hint">
        <span class="android-detected-pill mono" id="android-detected-pill" hidden>
          <span class="i18n-en">📱 Install directly on this Android device</span>
          <span class="i18n-de">📱 Direkt auf diesem Android-Gerät installieren</span>
        </span>
        <div class="sideload-pop-wrap">
          <a href={`${base}sideloading/`} class="sideload-trigger">
            <span class="i18n-en">How to install unknown APKs &amp; unlock Google’s 24h lock?</span>
            <span class="i18n-de">Unbekannte Apps installieren &amp; Googles 24h-Sperre lösen?</span>
          </a>
          <div class="sideload-popover">
            <strong>
              <span class="i18n-en">Quick Install Guide (Android 10–17)</span>
              <span class="i18n-de">Kurzanleitung zur APK-Installation</span>
            </strong>
            <ol class="sideload-pop-list">
              <li>
                <span class="i18n-en">Tap the downloaded APK and enable <em>“Allow from this source”</em>.</span>
                <span class="i18n-de">Heruntergeladene APK antippen &amp; <em>„Aus dieser Quelle zulassen“</em> aktivieren.</span>
              </li>
              <li>
                <span class="i18n-en"><strong>New 24h Play Protect Lock (2026/27):</strong> Developer Options (7× Build No.) → <em>Apps from unverified developers</em> → Restart → After 24h pick <em>Allow indefinitely</em>.</span>
                <span class="i18n-de"><strong>Neue 24h-Sperre (2026/27):</strong> Entwickleroptionen (7× Build-Nr.) → <em>Apps von nicht verifizierten Entwicklern</em> → Neustart → Nach 24h <em>Dauerhaft erlauben</em> wählen.</span>
              </li>
            </ol>
            <div class="sideload-pop-links">
              <a href={`${base}sideloading/`} class="sideload-pop-link">
                <span class="i18n-en">Install guide →</span>
                <span class="i18n-de">Installationshilfe →</span>
              </a>
              <a href={`${base}sideloading/google-lock/`} class="sideload-pop-link">
                <span class="i18n-en">Google 24h lock →</span>
                <span class="i18n-de">24h-Sperre &amp; Keep Android Open →</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="phone-frame">
        <img
          class="phone-screen i18n-en"
          src={`${base}assets/screenshots/en/01_updates.png`}
          alt="ApkUp Updates screen showing available app updates and batch install button"
          width="360"
          height="780"
          loading="eager"
          decoding="async"
        />
        <img
          class="phone-screen i18n-de"
          src={`${base}assets/screenshots/de/01_updates.png`}
          alt="ApkUp-Update-Ansicht mit verfügbaren App-Updates und Sammel-Installation"
          width="360"
          height="780"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <div class="trust-strip">
    <div class="container trust-grid">
      <div class="trust-item">
        <strong class="mono" data-count-to="100" data-count-suffix="%">100%</strong>
        <span class="i18n-en">Zero Ads &amp; Zero Telemetry</span>
        <span class="i18n-de">Werbefrei &amp; ohne Tracking</span>
      </div>
      <div class="trust-item">
        <strong class="mono" data-count-to="7" data-count-suffix="+">7+</strong>
        <span class="i18n-en">Independent Update Sources</span>
        <span class="i18n-de">Unabhängige Update-Quellen</span>
      </div>
      <div class="trust-item">
        <strong>v2 / v3</strong>
        <span class="i18n-en">APK Signature Verification</span>
        <span class="i18n-de">APK-Signaturprüfung</span>
      </div>
      <div class="trust-item">
        <strong>AES-256</strong>
        <span class="i18n-en">Google Tink Local Keystore</span>
        <span class="i18n-de">Google-Tink-Verschlüsselung</span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var els = document.querySelectorAll('[data-count-to]');
    if (!els.length || !('IntersectionObserver' in window)) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        io.unobserve(el);
        var target = parseInt(el.getAttribute('data-count-to') || '0', 10);
        var suffix = el.getAttribute('data-count-suffix') || '';
        var start = performance.now();
        var dur = 1150;
        function tick(now) {
          var p = Math.min(1, (now - start) / dur);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });

    els.forEach(function (el) { io.observe(el); });

    // Auto-detect Android visitor
    var androidPill = document.getElementById('android-detected-pill');
    if (androidPill && /android/i.test(navigator.userAgent || '')) {
      androidPill.hidden = false;
    }

    // Subtle ±2deg parallax tilt on hero phone mockup
    var frame = document.querySelector('.hero-visual .phone-frame');
    if (frame && window.matchMedia('(hover: hover)').matches) {
      frame.addEventListener('pointermove', function (e) {
        var r = frame.getBoundingClientRect();
        var nx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        var ny = ((e.clientY - r.top) / r.height - 0.5) * 2;
        frame.style.transform = 'perspective(900px) rotateY(' + (nx * 2.2).toFixed(2) + 'deg) rotateX(' + (-ny * 2.2).toFixed(2) + 'deg)';
      });
      frame.addEventListener('pointerleave', function () {
        frame.style.transform = '';
      });
    }
  })();
</script>

<style>
  .hero {
    padding-block-start: clamp(40px, 6vw, 76px);
    padding-block-end: 0;
    background:
      radial-gradient(640px 420px at 82% 14%, rgba(245, 158, 11, 0.14), transparent 70%),
      radial-gradient(520px 380px at 14% 72%, rgba(110, 231, 183, 0.08), transparent 70%);
  }

  .hero-visual .phone-frame {
    transition: transform 220ms cubic-bezier(0.2, 0, 0, 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * {
      animation: heroStaggerIn 420ms cubic-bezier(0.2, 0, 0, 1) both;
    }
    .hero-copy > :nth-child(1) { animation-delay: 0ms; }
    .hero-copy > :nth-child(2) { animation-delay: 60ms; }
    .hero-copy > :nth-child(3) { animation-delay: 120ms; }
    .hero-copy > :nth-child(4) { animation-delay: 180ms; }
    .hero-copy > :nth-child(5) { animation-delay: 240ms; }
    .hero-visual {
      animation: heroStaggerIn 480ms cubic-bezier(0.2, 0, 0, 1) 140ms both;
    }
  }

  @keyframes heroStaggerIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
    padding-block-end: clamp(44px, 6vw, 72px);
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block-end: 20px;
  }

  .hero-title {
    margin: 0 0 18px;
    font-size: clamp(2.15rem, 4.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.07;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero-lead {
    margin: 0 0 28px;
    max-width: 60ch;
    color: var(--text-muted);
    font-size: clamp(1.03rem, 1.4vw, 1.18rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-end: 18px;
  }

  .hero-meta {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.84rem;
  }

  .hero-install-hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 8px;
  }

  .android-detected-pill {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--tertiary-soft);
    color: var(--tertiary-soft-ink);
    border: 1px solid rgba(110, 231, 183, 0.35);
    font-size: 0.74rem;
    font-weight: 700;
  }

  .sideload-pop-wrap {
    position: relative;
    display: inline-block;
  }

  .sideload-trigger {
    font-size: 0.82rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sideload-popover {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 45;
    width: min(410px, 90vw);
    padding: 16px 18px;
    border-radius: var(--radius-md);
    background: var(--surface-high);
    border: 1px solid var(--accent);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 10px;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 160ms ease-out, transform 160ms ease-out;
  }

  .sideload-pop-wrap:hover .sideload-popover,
  .sideload-pop-wrap:focus-within .sideload-popover {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .sideload-popover > strong {
    font-size: 0.88rem;
    color: var(--text);
  }

  .sideload-pop-list {
    margin: 0;
    padding-inline-start: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .sideload-pop-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 4px;
    border-top: 1px solid var(--outline);
  }

  .sideload-pop-link {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
  }

  .sideload-pop-link:hover {
    text-decoration: underline;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .phone-frame {
    width: min(320px, 84vw);
    padding: 10px;
    border-radius: 34px;
    background: var(--surface-low);
    border: 1px solid var(--outline-strong);
    box-shadow: var(--shadow-elevated);
  }

  .phone-screen {
    width: 100%;
    border-radius: 24px;
    outline: 1px solid var(--img-ring);
    outline-offset: -1px;
  }

  .trust-strip {
    border-block: 1px solid var(--outline);
    background: var(--surface-low);
    padding-block: 22px;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 24px;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .trust-item strong {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent);
  }

  .trust-item span {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  @media (max-width: 920px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .trust-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
