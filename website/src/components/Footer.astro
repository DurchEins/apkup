---
import { getBaseUrl } from '../utils/site';
import { SITE } from '../data/content';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_META,
  getTranslations,
  localePath,
  type Locale,
} from '../i18n';

interface Props {
  lang?: Locale;
  subPath?: string;
}

const { lang = DEFAULT_LOCALE, subPath = '' } = Astro.props;
const t = getTranslations(lang);
const base = getBaseUrl();
const activeMeta = LOCALE_META[lang];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src={`${base}assets/logo.png`} alt="" width="34" height="34" class="footer-icon" />
      <div class="footer-brand-text">
        <strong>ApkUp</strong>
        <p class="footer-copy">
          Copyright © 2026{' '}
          <a href="https://github.com/DurchEins" target="_blank" rel="noopener noreferrer" class="footer-author-link">DurchEins</a>
        </p>
      </div>
    </div>

    <nav class="footer-links" aria-label={t.footer.navAria}>
      <a href={localePath(lang, 'downloads/')}>{t.footer.downloads}</a>
      <a href={localePath(lang, 'sideloading/')}>{t.footer.installUnknownApps}</a>
      <a href={localePath(lang, 'sideloading/google-lock/')}>{t.footer.googleLock}</a>
      <a href={localePath(lang, 'changelog/')}>{t.footer.whatsNew}</a>
      <a href={localePath(lang, 'wiki/')}>{t.footer.wiki}</a>
      <a href={localePath(lang, 'compare/')}>{t.footer.sourceChecker}</a>
      <a href={localePath(lang, 'privacy/')}>{t.footer.privacy}</a>
      <a href={localePath(lang, 'security/')}>{t.footer.security}</a>
      <a href={localePath(lang, 'accessibility/')}>{t.footer.accessibility}</a>
      <a href={SITE.repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={SITE.wikiUrl} target="_blank" rel="noopener noreferrer">GitHub Wiki</a>
      <a href={SITE.licenseUrl} target="_blank" rel="noopener noreferrer" class="footer-build-pill mono">GPL-3.0</a>
      <a
        href={SITE.releasesUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-build-pill mono"
        title={t.footer.canonicalRelease}
      >
        v{SITE.fallbackVersion} ({SITE.fallbackBuild})
      </a>
      <a
        href="https://u24.gov.ua/"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-build-pill footer-ukraine-pill"
        aria-label="Stand with Ukraine — Official United24 Support"
      >
        <svg width="16" height="11" viewBox="0 0 16 11" aria-hidden="true" class="ua-flag">
          <defs>
            <clipPath id="ua-clip"><rect width="16" height="11" rx="2" /></clipPath>
          </defs>
          <g clip-path="url(#ua-clip)">
            <rect width="16" height="5.5" fill="#0057B7" />
            <rect y="5.5" width="16" height="5.5" fill="#FFD700" />
          </g>
        </svg>
        <span>Stand with Ukraine</span>
      </a>
    </nav>

    <div class="footer-i18n-bar">
      <div class="lang-picker-wrap" id="footer-lang-wrap">
        <button
          type="button"
          id="footer-lang-btn"
          class="lang-picker-btn"
          aria-expanded="false"
          aria-haspopup="menu"
          aria-controls="footer-lang-menu"
          aria-label={`${activeMeta.nativeName} (${activeMeta.code}) — ${t.footer.langPickerAria}`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span>{activeMeta.nativeName} <span class="mono lang-code">({activeMeta.code})</span></span>
          <svg class="lang-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>

        <div id="footer-lang-menu" class="lang-picker-menu" role="menu" aria-label={t.footer.langPickerAria} hidden>
          {LOCALES.map((loc) => {
            const lm = LOCALE_META[loc];
            const isCurrent = loc === lang;
            return (
              <a
                href={localePath(loc, subPath)}
                role="menuitemradio"
                aria-checked={isCurrent ? 'true' : 'false'}
                class={`lang-menu-item ${isCurrent ? 'is-active' : ''}`}
                data-lang-option={loc}
                lang={lm.hreflang}
              >
                <span class="lang-item-name">{lm.nativeName}</span>
                <span class="lang-item-right mono">
                  <span>{lm.code}</span>
                  {isCurrent && <span aria-hidden="true">✓</span>}
                </span>
              </a>
            );
          })}
        </div>
      </div>

      <a
        href="https://hosted.weblate.org/engage/apkup/"
        target="_blank"
        rel="noopener noreferrer"
        class="help-translate-link"
      >
        {t.footer.helpTranslate}
      </a>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var wrap = document.getElementById('footer-lang-wrap');
    var btn = document.getElementById('footer-lang-btn');
    var menu = document.getElementById('footer-lang-menu');
    if (!wrap || !btn || !menu) return;

    var menuItems = Array.prototype.slice.call(menu.querySelectorAll('[role="menuitemradio"]'));

    function closeMenu(focusBtn) {
      if (menu.hidden) return;
      menu.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
      if (focusBtn) btn.focus();
    }

    function openMenu(focusTarget) {
      menu.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      var target = focusTarget || menu.querySelector('[aria-checked="true"]') || menuItems[0];
      if (target) target.focus();
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      if (menu.hidden) openMenu();
      else closeMenu(false);
    });

    btn.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        openMenu(e.key === 'ArrowUp' ? menuItems[menuItems.length - 1] : menuItems[0]);
      }
    });

    menu.addEventListener('keydown', function (e) {
      if (!menuItems.length) return;
      var idx = menuItems.indexOf(document.activeElement);
      var nextIdx = -1;
      if (e.key === 'ArrowDown') nextIdx = (idx + 1) % menuItems.length;
      else if (e.key === 'ArrowUp') nextIdx = (idx - 1 + menuItems.length) % menuItems.length;
      else if (e.key === 'Home') nextIdx = 0;
      else if (e.key === 'End') nextIdx = menuItems.length - 1;
      else if (e.key === 'Tab') {
        closeMenu(false);
        return;
      }
      if (nextIdx >= 0) {
        e.preventDefault();
        menuItems[nextIdx].focus();
      }
    });

    document.addEventListener('click', function (e) {
      if (!menu.hidden && !wrap.contains(e.target)) {
        closeMenu(false);
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.hidden) {
        closeMenu(true);
      }
    });

    menu.querySelectorAll('[data-lang-option]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        var targetLang = link.getAttribute('data-lang-option');
        if (targetLang) {
          try {
            localStorage.setItem('apkup-lang', targetLang);
          } catch (err) {}
        }
        var dest = link.getAttribute('href');
        if (dest && (window.location.search || window.location.hash)) {
          e.preventDefault();
          window.location.href = dest + window.location.search + window.location.hash;
        }
      });
    });
  })();
</script>

<style>
  .site-footer {
    border-block-start: 1px solid var(--outline);
    background: var(--surface-lowest);
    padding-block: 36px;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 18px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .footer-icon {
    border-radius: 9px;
  }

  .footer-copy {
    margin: 2px 0 0;
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
  }

  .footer-links a {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    padding-block: 4px;
  }

  @media (hover: hover) {
    .footer-links a:hover {
      color: var(--accent);
    }
  }

  .footer-author-link {
    color: var(--text);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-author-link:hover {
    color: var(--accent);
  }

  .footer-links a.footer-build-pill {
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--outline);
    background: var(--surface);
    font-size: 0.7rem;
    line-height: 1.25;
    align-self: center;
    color: var(--text-muted);
  }

  @media (hover: hover) {
    .footer-links a.footer-build-pill:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  .footer-i18n-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 18px;
    padding-top: 6px;
  }

  .lang-picker-wrap {
    position: relative;
    display: inline-block;
  }

  .lang-picker-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--outline-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 700;
    transition: background-color 150ms ease-out, border-color 150ms ease-out;
  }

  @media (hover: hover) {
    .lang-picker-btn:hover {
      background: var(--surface-high);
      border-color: var(--accent);
    }
  }

  .lang-code {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .lang-chev {
    color: var(--text-muted);
    transition: transform 160ms ease-out;
  }

  .lang-picker-btn[aria-expanded='true'] .lang-chev {
    transform: rotate(180deg);
  }

  .lang-picker-menu {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    width: 240px;
    padding: 6px;
    border-radius: var(--radius-md);
    background: var(--surface-high);
    border: 1px solid var(--outline-strong);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.48);
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: start;
  }

  .lang-menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 600;
  }

  @media (hover: hover) {
    .lang-menu-item:hover {
      background: var(--surface);
    }
  }

  .lang-menu-item.is-active {
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
    font-weight: 700;
  }

  .lang-item-right {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    opacity: 0.85;
  }

  .help-translate-link {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--outline-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
  }

  .footer-ukraine-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border-color: rgba(255, 215, 0, 0.28);
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .ua-flag {
    flex-shrink: 0;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  @media (hover: hover) {
    .footer-ukraine-pill:hover {
      border-color: rgba(255, 215, 0, 0.7);
      box-shadow: 0 0 12px rgba(0, 87, 183, 0.28);
      transform: translateY(-1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-ukraine-pill {
      transition: none;
    }
    .footer-ukraine-pill:hover {
      transform: none;
    }
  }

  @media (hover: hover) {
    .help-translate-link:hover {
      border-color: var(--accent);
      color: var(--accent);
      background: var(--surface-high);
    }
  }
</style>
