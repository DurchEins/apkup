---
import { SITE } from '../data/content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src={`${base}assets/logo.png`} alt="" width="34" height="34" class="footer-icon" />
      <div class="footer-brand-text">
        <strong>ApkUp</strong>
        <p class="footer-copy">
          Copyright © 2026 DurchEins • GPL-3.0 •{' '}
          <span class="i18n-en">Based on APKUpdater by rumboalla</span>
          <span class="i18n-de">Basiert auf APKUpdater von rumboalla</span>
        </p>
      </div>
    </div>

    <nav class="footer-links" aria-label="Footer links">
      <a href={`${base}downloads/`}>Downloads</a>
      <a href={`${base}changelog/`}>
        <span class="i18n-en">What’s New?</span>
        <span class="i18n-de">Was ist neu?</span>
      </a>
      <a href={`${base}wiki/`}>Wiki</a>
      <a href={`${base}compare/`}>
        <span class="i18n-en">Source Checker</span>
        <span class="i18n-de">Quellen-Check</span>
      </a>
      <a href={`${base}privacy/`}>Privacy</a>
      <a href={`${base}security/`}>Security</a>
      <a href={SITE.repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={SITE.wikiUrl} target="_blank" rel="noopener noreferrer">GitHub Wiki</a>
      <a href={SITE.licenseUrl} target="_blank" rel="noopener noreferrer">GPL-3.0</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--outline);
    background: var(--surface-lowest);
    padding-block: 36px;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 18px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .footer-icon {
    border-radius: 9px;
  }

  .footer-copy {
    margin: 2px 0 0;
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
  }

  .footer-links a {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    padding-block: 4px;
  }

  @media (hover: hover) {
    .footer-links a:hover {
      color: var(--accent);
    }
  }
</style>
