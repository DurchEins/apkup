---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const PERMISSIONS = [
  {
    name: 'QUERY_ALL_PACKAGES',
    enTitle: 'Inspect installed apps & signing certificates',
    deTitle: 'Installierte Apps & Signaturzertifikate prüfen',
    enDesc:
      'Used strictly on-device to read installed package names, version codes, and v2/v3 signing certificates so ApkUp can detect updates and block certificate mismatches before installation.',
    deDesc:
      'Wird ausschließlich lokal auf dem Gerät genutzt, um Paketnamen, Versionscodes und v2/v3-Signaturzertifikate auszulesen – damit ApkUp Updates erkennt und Signaturkonflikte blockiert.',
  },
  {
    name: 'REQUEST_INSTALL_PACKAGES',
    enTitle: 'Hand off verified APKs to Android or Shizuku',
    deTitle: 'Geprüfte APKs an Android oder Shizuku übergeben',
    enDesc:
      'Required to launch the system PackageInstaller or delegate silent installation to your authorized Shizuku session after cryptographic checks pass.',
    deDesc:
      'Erforderlich, um den Android-PackageInstaller zu starten oder lautlose Updates nach bestandener Signaturprüfung an Shizuku zu übergeben.',
  },
  {
    name: 'INTERNET & ACCESS_NETWORK_STATE',
    enTitle: 'Fetch updates only from consented sources',
    deTitle: 'Updates nur über gewählte Quellen abrufen',
    enDesc:
      'Zero external requests happen before first-launch source consent. Used only to query enabled sources over HTTPS and enforce Wi-Fi-only guards.',
    deDesc:
      'Vor der Quellenauswahl beim Erststart finden null Netzwerkabfragen statt. Dient ausschließlich HTTPS-Abfragen an aktivierte Quellen sowie der WLAN-Prüfung.',
  },
  {
    name: 'FOREGROUND_SERVICE_DATA_SYNC & POST_NOTIFICATIONS',
    enTitle: 'Reliable batch downloads & update alerts',
    deTitle: 'Zuverlässige Batch-Downloads & Benachrichtigungen',
    enDesc:
      'Powers AndroidX WorkManager user-initiated data transfers with live overall ETA progress and optional notifications when updates are ready.',
    deDesc:
      'Ermöglicht zuverlässige WorkManager-Downloads samt Gesamtfortschritt und optionalen Benachrichtigungen bei neuen Updates.',
  },
];
---

<section id="privacy" class="section">
  <div class="container">
    <div class="privacy-top">
      <div class="section-header" style="margin-block-end: 0;">
        <h2 class="section-title">
          <span class="i18n-en">Transparent permissions &amp; local encryption</span>
          <span class="i18n-de">Transparente Berechtigungen &amp; lokale Verschlüsselung</span>
        </h2>
        <p class="section-subtitle">
          <span class="i18n-en">
            Every Android permission explained in plain language. Preferences and optional tokens are
            encrypted at rest via Google Tink (AES-256-GCM) with cloud backups disabled.
          </span>
          <span class="i18n-de">
            Jede Android-Berechtigung verständlich erklärt. Einstellungen und optionale Tokens
            liegen per Google Tink (AES-256-GCM) verschlüsselt lokal – ohne Cloud-Backup.
          </span>
        </p>
      </div>
      <a class="btn btn-secondary" href={`${base}privacy/`}>
        <span class="i18n-en">Full Privacy Policy</span>
        <span class="i18n-de">Vollständige Datenschutzerklärung</span>
      </a>
    </div>

    <div class="perm-list">
      {
        PERMISSIONS.map((perm) => (
          <details class="perm-item">
            <summary class="perm-summary">
              <div class="perm-head">
                <code class="perm-code mono">{perm.name}</code>
                <span class="perm-title">
                  <span class="i18n-en">{perm.enTitle}</span>
                  <span class="i18n-de">{perm.deTitle}</span>
                </span>
              </div>
              <svg class="perm-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="perm-body">
              <p class="i18n-en">{perm.enDesc}</p>
              <p class="i18n-de">{perm.deDesc}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .privacy-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-block-end: 28px;
  }

  .perm-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 14px;
  }

  .perm-item {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 4px 18px;
  }

  .perm-item[open] {
    border-color: var(--outline-strong);
    background: var(--surface);
  }

  .perm-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 14px;
    cursor: pointer;
  }

  .perm-summary::-webkit-details-marker {
    display: none;
  }

  .perm-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .perm-code {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 700;
    word-break: break-word;
  }

  .perm-title {
    font-weight: 700;
    font-size: 0.96rem;
  }

  .perm-chev {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 150ms ease-out;
  }

  .perm-item[open] .perm-chev {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .perm-body {
    padding-block-end: 16px;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .perm-body p {
    margin: 0;
  }

  @media (max-width: 820px) {
    .perm-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
