---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const PERMISSIONS = [
  {
    name: 'QUERY_ALL_PACKAGES',
    enTitle: 'Inspect installed apps & signing certificates',
    deTitle: 'Installierte Apps & Signaturzertifikate prüfen',
    enDesc:
      'Used strictly on-device to read installed package names, version codes, and v2/v3 signing certificates so ApkUp can detect updates and block certificate mismatches before installation.',
    deDesc:
      'Wird ausschließlich lokal auf dem Gerät genutzt, um Paketnamen, Versionscodes und v2/v3-Signaturzertifikate auszulesen – damit ApkUp Updates erkennt und Signaturkonflikte blockiert.',
  },
  {
    name: 'REQUEST_INSTALL_PACKAGES & UPDATE_PACKAGES_WITHOUT_USER_ACTION',
    enTitle: 'Install verified APKs & seamless updates',
    deTitle: 'Geprüfte APKs installieren & nahtlose Updates',
    enDesc:
      'Required to hand over verified packages to the system PackageInstaller or an authorized Shizuku session, and to apply unattended updates smoothly on Android 12+.',
    deDesc:
      'Erforderlich, um geprüfte Pakete an den Android-PackageInstaller oder Shizuku zu übergeben und bestätigungsfreie Updates ab Android 12+ auszuführen.',
  },
  {
    name: 'REQUEST_DELETE_PACKAGES',
    enTitle: 'Uninstall apps & guided non-Root rollbacks',
    deTitle: 'Apps deinstallieren & geführter Non-Root-Rollback',
    enDesc:
      'Used only when you explicitly trigger an app uninstall or a two-step non-Root rollback to restore an older backed-up APK version.',
    deDesc:
      'Wird nur genutzt, wenn du aktiv eine Deinstallation oder einen geführten Zweischritt-Rollback ohne Root auf eine gesicherte Vorgängerversion startest.',
  },
  {
    name: 'INTERNET & ACCESS_NETWORK_STATE',
    enTitle: 'Fetch updates only from consented sources',
    deTitle: 'Updates nur über gewählte Quellen abrufen',
    enDesc:
      'Zero external requests happen before first-launch source consent. Used only to query enabled sources over HTTPS and enforce Wi-Fi-only guards.',
    deDesc:
      'Vor der Quellenauswahl beim Erststart finden null Netzwerkabfragen statt. Dient ausschließlich HTTPS-Abfragen an aktivierte Quellen sowie der WLAN-Prüfung.',
  },
  {
    name: 'FOREGROUND_SERVICE & RUN_USER_INITIATED_JOBS',
    enTitle: 'Reliable batch downloads with live ETA',
    deTitle: 'Zuverlässige Batch-Downloads samt Restzeit',
    enDesc:
      'Powers AndroidX WorkManager data-sync foreground services and user-initiated transfer jobs so large multi-app update batches finish reliably.',
    deDesc:
      'Ermöglicht AndroidX-WorkManager-Datentransfers im Vordergrund, damit auch große Sammel-Updates mit Gesamtfortschritt sauber durchlaufen.',
  },
  {
    name: 'POST_NOTIFICATIONS & VIBRATE',
    enTitle: 'Optional update alerts & haptic feedback',
    deTitle: 'Optionale Update-Hinweise & haptisches Feedback',
    enDesc:
      'Optional permission to notify you about available updates, background install summaries, and download progress with subtle haptic feedback.',
    deDesc:
      'Optionale Berechtigung für Benachrichtigungen über verfügbare Updates, Sammel-Zusammenfassungen und dezentes haptisches Feedback.',
  },
  {
    name: 'REQUEST_IGNORE_BATTERY_OPTIMIZATIONS',
    enTitle: 'Optional background check reliability',
    deTitle: 'Optionale Hintergrund-Zuverlässigkeit',
    enDesc:
      'Optional exemption you can grant in Setup so scheduled background checks and quiet-hour catch-up jobs are not deferred by aggressive OEM battery savers.',
    deDesc:
      'Optionale Freigabe im Setup, damit geplante Hintergrundprüfungen nicht durch strenge Hersteller-Energiesparmodi blockiert werden.',
  },
  {
    name: 'HIDE_OVERLAY_WINDOWS',
    enTitle: 'Tapjacking protection during installs',
    deTitle: 'Tapjacking-Schutz bei Installationen',
    enDesc:
      'Prevents malicious third-party screen overlays from obscuring sensitive installation or permission dialogs while ApkUp is active.',
    deDesc:
      'Verhindert, dass fremde Overlay-Fenster sensible Installations- oder Berechtigungsdialoge überdecken, während ApkUp aktiv ist.',
  },
];
---

<section id="privacy" class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="i18n-en">Transparent permissions &amp; local encryption</span>
        <span class="i18n-de">Transparente Berechtigungen &amp; lokale Verschlüsselung</span>
      </h2>
      <p class="section-subtitle">
        <span class="i18n-en">
          Every Android permission from AndroidManifest.xml explained in plain language.
          Preferences and optional tokens are encrypted via Google Tink (AES-256-GCM).
        </span>
        <span class="i18n-de">
          Alle Android-Berechtigungen aus der AndroidManifest.xml verständlich erklärt.
          Einstellungen und Tokens liegen per Google Tink (AES-256-GCM) lokal verschlüsselt.
        </span>
      </p>
      <div class="privacy-inline-links">
        <a href={`${base}privacy/`}>
          <span class="i18n-en">Full Privacy Policy →</span>
          <span class="i18n-de">Vollständige Datenschutzerklärung →</span>
        </a>
        <span aria-hidden="true">|</span>
        <a href={`${base}security/`}>
          <span class="i18n-en">Security Architecture (SECURITY.md) →</span>
          <span class="i18n-de">Sicherheitsarchitektur (SECURITY.md) →</span>
        </a>
      </div>
    </div>

    <div class="perm-list">
      {
        PERMISSIONS.map((perm) => (
          <details class="perm-item">
            <summary class="perm-summary">
              <div class="perm-head">
                <code class="perm-code mono">{perm.name}</code>
                <span class="perm-title">
                  <span class="i18n-en">{perm.enTitle}</span>
                  <span class="i18n-de">{perm.deTitle}</span>
                </span>
              </div>
              <svg class="perm-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="perm-body">
              <p class="i18n-en">{perm.enDesc}</p>
              <p class="i18n-de">{perm.deDesc}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .privacy-inline-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-block-start: 10px;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .privacy-inline-links a {
    color: var(--accent);
    text-decoration: none;
  }

  .privacy-inline-links span {
    color: var(--text-muted);
    opacity: 0.45;
  }

  .perm-list {
    columns: 2;
    column-gap: 14px;
  }

  .perm-item {
    break-inside: avoid;
    margin-block-end: 14px;
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 4px 18px;
  }

  @media (max-width: 820px) {
    .perm-list {
      columns: 1;
    }
  }

  .perm-item[open] {
    border-color: var(--outline-strong);
    background: var(--surface);
  }

  .perm-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 14px;
    cursor: pointer;
  }

  .perm-summary::-webkit-details-marker {
    display: none;
  }

  .perm-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .perm-code {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 700;
    word-break: break-word;
  }

  .perm-title {
    font-weight: 700;
    font-size: 0.96rem;
  }

  .perm-chev {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 150ms ease-out;
  }

  .perm-item[open] .perm-chev {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .perm-body {
    padding-block-end: 16px;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .perm-body p {
    margin: 0;
  }

  @media (max-width: 820px) {
    .perm-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
