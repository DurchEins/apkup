---
import { DEFAULT_LOCALE, getTranslations, localePath, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(lang);
type PermKey = keyof typeof t.permissions.items;
const PERM_KEYS = Object.keys(t.permissions.items) as PermKey[];
---

<section id="privacy" class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t.permissions.title}</h2>
      <p class="section-subtitle">{t.permissions.subtitle}</p>
      <div class="privacy-inline-links">
        <a href={localePath(lang, 'privacy/')}>{t.permissions.privacyLink}</a>
        <span aria-hidden="true">|</span>
        <a href={localePath(lang, 'security/')}>{t.permissions.securityLink}</a>
      </div>
    </div>

    <div class="perm-list">
      {
        PERM_KEYS.map((key) => {
          const perm = t.permissions.items[key];
          return (
            <details class="perm-item">
              <summary class="perm-summary">
                <div class="perm-head">
                  <code class="perm-code mono">{key}</code>
                  <span class="perm-title">{perm.title}</span>
                </div>
                <svg class="perm-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="perm-body">
                <p>{perm.desc}</p>
              </div>
            </details>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .privacy-inline-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-block-start: 10px;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .privacy-inline-links a {
    color: var(--accent);
    text-decoration: none;
  }

  .privacy-inline-links span {
    color: var(--text-muted);
    opacity: 0.45;
  }

  .perm-list {
    columns: 2;
    column-gap: 14px;
  }

  .perm-item {
    break-inside: avoid;
    margin-block-end: 14px;
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 4px 18px;
  }

  @media (max-width: 820px) {
    .perm-list {
      columns: 1;
    }
  }

  .perm-item[open] {
    border-color: var(--outline-strong);
    background: var(--surface);
  }

  .perm-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 14px;
    cursor: pointer;
  }

  .perm-summary::-webkit-details-marker {
    display: none;
  }

  .perm-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .perm-code {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 700;
    word-break: break-word;
  }

  .perm-title {
    font-weight: 700;
    font-size: 0.96rem;
  }

  .perm-chev {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 150ms ease-out;
  }

  .perm-item[open] .perm-chev {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .perm-body {
    padding-block-end: 16px;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .perm-body p {
    margin: 0;
  }
</style>
