---
import { MIRRORS, SITE } from '../data/content';
import MirrorIcon from './MirrorIcon.astro';
import { DEFAULT_LOCALE, getTranslations, localePath, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(lang);
---

<section id="downloads" class="section downloads-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t.downloadsSection.title}</h2>
      <p class="section-subtitle">{t.downloadsSection.subtitle}</p>
    </div>

    <div class="primary-download-card">
      <div class="primary-info">
        <div class="primary-badges">
          <span class="pill-badge pill-emerald">{t.downloadsSection.recommended}</span>
        </div>
        <h3>{t.downloadsSection.cardTitle}</h3>
        <p id="dl-release-meta">{t.downloadsSection.cardDesc}</p>
      </div>

      <div class="primary-actions">
        <a class="btn btn-primary" href={SITE.releasesUrl} data-apk-link>
          <span>
            {t.downloadsSection.downloadPrefix ? `${t.downloadsSection.downloadPrefix} ` : ''}
            <span class="apk-light">Apk</span><strong class="apk-up">Up</strong>
            {t.downloadsSection.downloadSuffix ? ` ${t.downloadsSection.downloadSuffix}` : ''}{' '}
            <span data-apk-meta>(v{SITE.fallbackVersion})</span>
          </span>
        </a>
        <button type="button" class="btn btn-secondary" data-open-qr>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <path d="M14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 18v3" />
          </svg>
          <span>{t.downloadsSection.qrCode}</span>
        </button>
        <a class="btn btn-ghost" href={localePath(lang, 'changelog/')}>
          {t.downloadsSection.whatsNew}
        </a>
      </div>

      <div class="primary-req-line mono">
        <span>{t.downloadsSection.reqLine}</span>
        <span class="req-sep" aria-hidden="true">|</span>
        <a href={localePath(lang, 'compare/#comparison')} class="why-apkup-link">
          {t.downloadsSection.whyApkUp}
        </a>
        <span class="req-sep" aria-hidden="true">|</span>
        <a href={localePath(lang, 'sideloading/')} class="why-apkup-link">
          {t.downloadsSection.installUnknownApps}
        </a>
        <span class="req-sep" aria-hidden="true">|</span>
        <a href={localePath(lang, 'sideloading/google-lock/')} class="why-apkup-link">
          {t.downloadsSection.googleLock}
        </a>
      </div>
    </div>

    <div class="mirrors-banner-card">
      <div class="mirrors-banner-left">
        <div class="mirrors-icon-stack" aria-hidden="true">
          {
            MIRRORS.slice(0, 6).map((mirror) => (
              <span
                class="mini-mirror-dot"
                style={mirror.name === 'itch.io' ? `background: ${mirror.color};` : 'background: #fff;'}
              >
                <MirrorIcon name={mirror.name} size={18} />
              </span>
            ))
          }
        </div>
        <div>
          <h3>{t.downloadsSection.mirrorsTitle}</h3>
          <p>{t.downloadsSection.mirrorsDesc}</p>
        </div>
      </div>
      <a href={localePath(lang, 'downloads/')} class="btn btn-secondary">
        {t.downloadsSection.mirrorsBtn}
      </a>
    </div>

    <div class="support-card" id="support">
      <div class="support-copy">
        <h3>{t.downloadsSection.supportTitle}</h3>
        <p>{t.downloadsSection.supportDesc}</p>
      </div>

      <div class="support-actions">
        <a
          class="btn btn-secondary support-pill"
          href={SITE.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true">
            <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z" />
          </svg>
          <span>{t.downloadsSection.starOnGithub}</span>
          <span class="star-count mono" data-gh-stars hidden></span>
        </a>
        <a
          class="btn btn-secondary support-pill"
          href="https://buymeacoffee.com/durcheins"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
            <line x1="6" y1="2" x2="6" y2="4" />
            <line x1="10" y1="2" x2="10" y2="4" />
            <line x1="14" y1="2" x2="14" y2="4" />
          </svg>
          <span>Buy Me a Coffee</span>
        </a>
        <a
          class="btn btn-secondary support-pill"
          href="https://coindrop.to/durcheins"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M14.8 9a2.8 2.8 0 0 0-2.8-2 3 3 0 0 0 0 6 3 3 0 0 1 0 6 2.8 2.8 0 0 1-2.8-2" />
            <path d="M12 5v2m0 10v2" />
          </svg>
          <span>Coindrop</span>
        </a>
        <button class="btn btn-secondary support-pill" type="button" data-share-btn>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#F59E0B"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="18" cy="5" r="3" />
            <circle cx="6" cy="12" r="3" />
            <circle cx="18" cy="19" r="3" />
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
          </svg>
          <span data-share-label>{t.downloadsSection.shareWebsite}</span>
          <span data-share-copied hidden>{t.downloadsSection.linkCopied}</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .downloads-section {
    background: var(--surface-low);
    border-block: 1px solid var(--outline);
  }

  .primary-download-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    background: var(--bg);
    border: 1px solid var(--outline-strong);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3.5vw, 32px);
    margin-block-end: 20px;
  }

  .primary-req-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-block-start: 4px;
  }

  .req-sep {
    opacity: 0.45;
  }

  .why-apkup-link {
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .primary-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-end: 12px;
  }

  .primary-info h3 {
    margin: 0 0 8px;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .primary-info p {
    margin: 0;
    color: var(--text-muted);
    max-width: 58ch;
  }

  .primary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .mirrors-banner-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    background: var(--bg);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: 20px 24px;
    margin-block-end: 24px;
  }

  .mirrors-banner-left {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .mirrors-icon-stack {
    display: flex;
    align-items: center;
  }

  .mini-mirror-dot {
    width: 30px;
    height: 30px;
    padding: 4px;
    border-radius: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--bg);
    margin-inline-start: -8px;
    transition: margin 220ms cubic-bezier(0.2, 0, 0, 1), transform 220ms cubic-bezier(0.2, 0, 0, 1);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .mirrors-banner-card:hover .mini-mirror-dot:not(:first-child) {
      margin-inline-start: 3px;
    }
    .support-pill:hover svg {
      transform: rotate(18deg) scale(1.12);
    }
  }

  .support-pill svg {
    transition: transform 220ms cubic-bezier(0.2, 0, 0, 1);
  }

  .star-count.is-popped {
    animation: starPop 380ms cubic-bezier(0.2, 0, 0, 1);
  }

  @keyframes starPop {
    0% { opacity: 0; transform: scale(0.75); }
    70% { transform: scale(1.12); }
    100% { opacity: 1; transform: scale(1); }
  }

  .mini-mirror-dot:first-child {
    margin-inline-start: 0;
  }

  .mirrors-banner-left h3 {
    margin: 0 0 3px;
    font-size: 1.04rem;
    font-weight: 700;
  }

  .mirrors-banner-left p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .support-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px 36px;
    background: var(--bg);
    border: 1px solid var(--outline-strong);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3.5vw, 32px);
  }

  .support-copy h3 {
    margin: 0 0 8px;
    font-size: 1.3rem;
    font-weight: 800;
  }

  .support-copy p {
    margin: 0;
    max-width: 56ch;
    color: var(--text-muted);
  }

  .support-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .support-pill {
    background: var(--surface-low);
    border-color: var(--outline-strong);
  }

  .star-count {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
    font-size: 0.78rem;
  }

  @media (max-width: 960px) {
    .support-card {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mirror-card,
    .mirror-card:active {
      transition: none;
      transform: none;
    }
  }
</style>
