---
import { MIRRORS, SITE } from '../data/content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section id="downloads" class="section downloads-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="i18n-en">Download ApkUp</span>
        <span class="i18n-de">ApkUp herunterladen</span>
      </h2>
      <p class="section-subtitle">
        <span class="i18n-en">
          Requires Android 10.0 (API 29) or higher. GitHub Releases is the primary canonical build
          with matching SHA256SUMS.
        </span>
        <span class="i18n-de">
          Erfordert mindestens Android 10.0 (API 29). GitHub Releases liefert den kanonischen Build
          inklusive SHA256SUMS-Prüfsumme.
        </span>
      </p>
    </div>

    <div class="primary-download-card">
      <div class="primary-info">
        <div class="primary-badges">
          <span class="pill-badge pill-amber mono" id="dl-version-badge">
            v{SITE.fallbackVersion}
          </span>
          <span class="pill-badge pill-emerald">
            <span class="i18n-en">Recommended</span>
            <span class="i18n-de">Empfohlen</span>
          </span>
        </div>
        <h3>GitHub Releases (Direct Signed APK)</h3>
        <p id="dl-release-meta">
          <span class="i18n-en">
            Official CI-signed release artifact with SHA256SUMS verification and built-in
            self-updater support.
          </span>
          <span class="i18n-de">
            Offiziell signiertes CI-Release-Artefakt mit SHA256SUMS-Prüfung und integriertem
            Selbst-Updater.
          </span>
        </p>
      </div>

      <div class="primary-actions">
        <a class="btn btn-primary" href={SITE.releasesUrl} data-apk-link>
          <span class="i18n-en" data-apk-label-en>Download Latest APK</span>
          <span class="i18n-de" data-apk-label-de>Aktuelle APK herunterladen</span>
        </a>
        <button type="button" class="btn btn-secondary" data-open-qr>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <path d="M14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 18v3" />
          </svg>
          <span>QR-Code</span>
        </button>
        <a class="btn btn-ghost" href={`${base}changelog/`}>
          <span class="i18n-en">What’s New?</span>
          <span class="i18n-de">Was ist neu?</span>
        </a>
      </div>

      <div class="primary-req-line mono">
        <span>Android 10.0 – 17 (API 29+) • ABIs: arm64-v8a, armeabi-v7a, x86_64</span>
        <span class="req-sep" aria-hidden="true">|</span>
        <a href={`${base}compatibility/#comparison`} class="why-apkup-link">
          <span class="i18n-en">Why ApkUp?</span>
          <span class="i18n-de">Warum ApkUp?</span>
        </a>
      </div>
    </div>

    <div class="downloads-subpage-cta">
      <a href={`${base}downloads/`} class="btn btn-secondary">
        <span class="i18n-en">All Mirrors, SHA-256 &amp; Verification →</span>
        <span class="i18n-de">Alle Mirrors, SHA-256 &amp; Prüfung →</span>
      </a>
    </div>

    <div class="mirrors-grid">
      {
        MIRRORS.map((mirror) => (
          <a
            class={`mirror-card ${mirror.outdated ? 'is-outdated' : ''}`}
            href={mirror.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="mirror-left">
              <span class="mirror-icon" style={`background: ${mirror.color};`} aria-hidden="true">
                {mirror.name === 'Zapstore' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff">
                    <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />
                  </svg>
                )}
                {mirror.name === 'GitLab Releases' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff">
                    <path d="m22.65 14.39-1.4-4.32L18.47 1.5a.46.46 0 0 0-.88 0l-2.78 8.57H9.19L6.41 1.5a.46.46 0 0 0-.88 0L2.75 10.07l-1.4 4.32a.94.94 0 0 0 .34 1.05L12 22.92l10.31-7.48a.94.94 0 0 0 .34-1.05Z" />
                  </svg>
                )}
                {mirror.name === 'APKPure' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff">
                    <path d="M5.2 2.4C4.2 1.8 3 2.5 3 3.7v16.6c0 1.2 1.2 1.9 2.2 1.3l14.6-8.3c1-.6 1-2 0-2.6L5.2 2.4zm4.9 5.5l4.9 4.1-4.9 4.1V7.9z" />
                  </svg>
                )}
                {mirror.name === 'itch.io' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff">
                    <path d="M3.13 1.338C2.08 1.96.02 4.328 0 4.95v1.03c0 1.303 1.22 2.45 2.325 2.45 1.33 0 2.436-1.102 2.436-2.41 0 1.308 1.07 2.41 2.4 2.41 1.328 0 2.362-1.102 2.362-2.41 0 1.308 1.137 2.41 2.466 2.41h.024c1.33 0 2.466-1.102 2.466-2.41 0 1.308 1.034 2.41 2.363 2.41 1.33 0 2.4-1.102 2.4-2.41 0 1.308 1.106 2.41 2.435 2.41C22.78 8.43 24 7.282 24 5.98V4.95c-.02-.622-2.082-2.99-3.13-3.612-3.253-.114-5.508-.134-8.87-.133-3.362 0-5.617.019-8.87.133zm6.968 8.532c-.862.03-1.694.492-2.163 1.23-.614.078-1.48.078-2.094 0-.47-.738-1.301-1.2-2.163-1.23-.844-.03-1.74.383-2.203 1.123-.496.79-.658 2.138-.734 3.63-.076 1.494.084 3.237.768 4.442.842 1.482 2.467 1.802 3.743 1.306.922-.358 1.662-1.084 2.26-1.883h5.004c.598.8 1.338 1.525 2.26 1.883 1.276.496 2.901.176 3.743-1.306.684-1.205.844-2.948.768-4.442-.076-1.492-.238-2.84-.734-3.63-.463-.74-1.36-1.153-2.203-1.123-.862.03-1.693.492-2.163 1.23-.614.078-1.48.078-2.094 0-.47-.738-1.3-1.2-2.163-1.23z" />
                  </svg>
                )}
                {mirror.name === 'Appteka' && (
                  <svg width="20" height="20" viewBox="0 0 260 260" fill="#fff">
                    <path d="M23.9276 120.32L120.32 23.9276C152.36 -7.97588 204.032 -7.97588 236.072 23.9276C267.976 55.8311 267.976 107.64 236.072 139.68L139.68 236.072C107.64 267.976 55.8311 267.976 23.9276 236.072C-7.97588 204.032 -7.97588 152.36 23.9276 120.32ZM43.2879 139.68C28.9722 153.859 24.2003 174.174 29.1085 192.307L110.776 110.776L168.584 168.584L216.712 120.32C238.117 99.0509 238.117 64.5569 216.712 43.2879C195.443 21.8825 160.949 21.8825 139.68 43.2879L43.2879 139.68Z" />
                  </svg>
                )}
                {mirror.name === 'Komi Store' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                    <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
                  </svg>
                )}
                {mirror.name === 'AlternativeTo' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff">
                    <path d="M19.5 3h-15A1.5 1.5 0 0 0 3 4.5v15A1.5 1.5 0 0 0 4.5 21h15a1.5 1.5 0 0 0 1.5-1.5v-15A1.5 1.5 0 0 0 19.5 3zM9.8 16.5H7.6l3-9h2.8l3 9h-2.2l-.6-2h-3.2l-.6 2zm1.1-3.8h2.2L12 9l-1.1 3.7z" />
                  </svg>
                )}
                {mirror.name === 'Amazon Appstore' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff">
                    <path d="M13.958 10.09c0 1.232.029 2.256-.591 3.351-.502.891-1.301 1.438-2.186 1.438-1.214 0-1.922-.924-1.922-2.292 0-2.692 2.415-3.182 4.7-3.182v.685zm3.186 7.705a.66.66 0 0 1-.753.077c-1.059-.879-1.248-1.287-1.829-2.125-1.747 1.781-2.984 2.313-5.249 2.313-2.679 0-4.765-1.653-4.765-4.962 0-2.585 1.402-4.345 3.397-5.206 1.729-.759 4.147-.896 5.999-1.106v-.413c0-.759.058-1.656-.389-2.313-.389-.588-1.132-.829-1.787-.829-1.214 0-2.297.622-2.561 1.912-.054.287-.265.57-.553.584l-3.091-.332c-.26-.058-.549-.269-.476-.669C5.764 1.653 9.218.5 12.238.5c1.546 0 3.567.412 4.786 1.584 1.546 1.445 1.398 3.37 1.398 5.469v4.953c0 1.49.619 2.142 1.201 2.948.204.287.249.631-.011.846-.65.543-1.805 1.551-2.441 2.114l-.027-.019zm2.515 2.094C17.078 21.797 13.34 22.8 10.123 22.8c-4.513 0-8.573-1.669-11.644-4.444-.241-.218-.026-.515.265-.346 3.314 1.93 7.412 3.091 11.645 3.091 2.855 0 5.995-.591 8.881-1.817.436-.186.801.286.389.605z" />
                  </svg>
                )}
              </span>
              <div class="mirror-main">
                <strong>{mirror.name}</strong>
                <span class={`mirror-badge ${mirror.outdated ? 'badge-warn' : ''}`}>
                  <span class="i18n-en">{mirror.badgeEn}</span>
                  <span class="i18n-de">{mirror.badgeDe}</span>
                </span>
              </div>
            </div>
            <svg
              class="mirror-arrow"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          </a>
        ))
      }
    </div>

    <div class="support-card" id="support">
      <div class="support-copy">
        <h3>
          <span class="i18n-en">Support ApkUp’s development</span>
          <span class="i18n-de">ApkUp unterstützen</span>
        </h3>
        <p>
          <span class="i18n-en">
            ApkUp is free, ad-free, and open source. If it saves you time keeping your apps up to
            date, consider starring the repository on GitHub or buying a coffee.
          </span>
          <span class="i18n-de">
            ApkUp ist kostenlos, werbefrei und Open Source. Wenn dir die App Zeit spart, freue ich
            mich über einen Stern auf GitHub oder einen kleinen Kaffee.
          </span>
        </p>
      </div>

      <div class="support-actions">
        <a
          class="btn btn-secondary support-pill"
          href={SITE.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true">
            <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z" />
          </svg>
          <span class="i18n-en">Star on GitHub</span>
          <span class="i18n-de">Auf GitHub sternen</span>
          <span class="star-count mono" data-gh-stars hidden></span>
        </a>
        <a
          class="btn btn-secondary support-pill"
          href="https://buymeacoffee.com/durcheins"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
            <line x1="6" y1="2" x2="6" y2="4" />
            <line x1="10" y1="2" x2="10" y2="4" />
            <line x1="14" y1="2" x2="14" y2="4" />
          </svg>
          <span>Buy Me a Coffee</span>
        </a>
        <a
          class="btn btn-secondary support-pill"
          href="https://coindrop.to/durcheins"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M14.8 9a2.8 2.8 0 0 0-2.8-2 3 3 0 0 0 0 6 3 3 0 0 1 0 6 2.8 2.8 0 0 1-2.8-2" />
            <path d="M12 5v2m0 10v2" />
          </svg>
          <span>Coindrop</span>
        </a>
        <button class="btn btn-secondary support-pill" type="button" data-share-btn>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#F59E0B"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="18" cy="5" r="3" />
            <circle cx="6" cy="12" r="3" />
            <circle cx="18" cy="19" r="3" />
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
          </svg>
          <span data-share-label>
            <span class="i18n-en">Share Website</span>
            <span class="i18n-de">Website teilen</span>
          </span>
          <span data-share-copied hidden>
            <span class="i18n-en">Link copied!</span>
            <span class="i18n-de">Link kopiert!</span>
          </span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .downloads-section {
    background: var(--surface-low);
    border-block: 1px solid var(--outline);
  }

  .primary-download-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    background: var(--bg);
    border: 1px solid var(--outline-strong);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3.5vw, 32px);
    margin-block-end: 20px;
  }

  .primary-req-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-block-start: 4px;
  }

  .req-sep {
    opacity: 0.45;
  }

  .why-apkup-link {
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .primary-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-end: 12px;
  }

  .primary-info h3 {
    margin: 0 0 8px;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .primary-info p {
    margin: 0;
    color: var(--text-muted);
    max-width: 58ch;
  }

  .primary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .downloads-subpage-cta {
    display: flex;
    justify-content: center;
    margin-block: 4px 20px;
  }

  .mirrors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
    margin-block-end: 40px;
  }

  .mirror-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 68px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--bg);
    border: 1px solid var(--outline);
    text-decoration: none;
    transition: background-color 150ms ease-out, border-color 150ms ease-out, transform 150ms ease-out;
  }

  .mirror-card:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .mirror-card:hover {
      background: var(--surface);
      border-color: var(--outline-strong);
    }
  }

  .mirror-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .mirror-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 12px;
    display: grid;
    place-items: center;
  }

  .mirror-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .mirror-badge {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .mirror-arrow {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .mirror-card.is-outdated {
    opacity: 0.78;
  }

  .badge-warn {
    color: var(--danger);
  }

  .support-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px 36px;
    background: var(--bg);
    border: 1px solid var(--outline-strong);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3.5vw, 32px);
  }

  .support-copy h3 {
    margin: 0 0 8px;
    font-size: 1.3rem;
    font-weight: 800;
  }

  .support-copy p {
    margin: 0;
    max-width: 56ch;
    color: var(--text-muted);
  }

  .support-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .support-pill {
    background: var(--surface-low);
    border-color: var(--outline-strong);
  }

  .star-count {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
    font-size: 0.78rem;
  }

  @media (max-width: 960px) {
    .support-card {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mirror-card,
    .mirror-card:active {
      transition: none;
      transform: none;
    }
  }
</style>
