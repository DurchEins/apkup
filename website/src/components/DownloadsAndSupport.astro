---
import { MIRRORS, SITE } from '../data/content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section id="downloads" class="section downloads-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="i18n-en">Download ApkUp</span>
        <span class="i18n-de">ApkUp herunterladen</span>
      </h2>
      <p class="section-subtitle">
        <span class="i18n-en">
          Requires Android 10.0 (API 29) or higher. GitHub Releases is the primary canonical build
          with matching SHA256SUMS.
        </span>
        <span class="i18n-de">
          Erfordert mindestens Android 10.0 (API 29). GitHub Releases liefert den kanonischen Build
          inklusive SHA256SUMS-Prüfsumme.
        </span>
      </p>
    </div>

    <div class="primary-download-card">
      <div class="primary-info">
        <div class="primary-badges">
          <span class="pill-badge pill-amber mono" id="dl-version-badge">
            v{SITE.fallbackVersion}
          </span>
          <span class="pill-badge pill-emerald">
            <span class="i18n-en">Recommended</span>
            <span class="i18n-de">Empfohlen</span>
          </span>
        </div>
        <h3>GitHub Releases (Direct Signed APK)</h3>
        <p id="dl-release-meta">
          <span class="i18n-en">
            Official CI-signed release artifact with SHA256SUMS verification and built-in
            self-updater support.
          </span>
          <span class="i18n-de">
            Offiziell signiertes CI-Release-Artefakt mit SHA256SUMS-Prüfung und integriertem
            Selbst-Updater.
          </span>
        </p>
      </div>

      <div class="primary-actions">
        <a class="btn btn-primary" href={SITE.releasesUrl} data-apk-link>
          <span class="i18n-en" data-apk-label-en>Download Latest APK</span>
          <span class="i18n-de" data-apk-label-de>Aktuelle APK laden</span>
        </a>
        <a class="btn btn-secondary" href={SITE.releasesUrl} target="_blank" rel="noopener noreferrer">
          <span class="i18n-en">Release Notes &amp; SHA256</span>
          <span class="i18n-de">Release Notes &amp; SHA256</span>
        </a>
      </div>
    </div>

    <div class="mirrors-grid">
      {
        MIRRORS.map((mirror) => (
          <a
            class={`mirror-card ${mirror.outdated ? 'is-outdated' : ''}`}
            href={mirror.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="mirror-main">
              <strong>{mirror.name}</strong>
              <span class={`mirror-badge ${mirror.outdated ? 'badge-warn' : ''}`}>
                <span class="i18n-en">{mirror.badgeEn}</span>
                <span class="i18n-de">{mirror.badgeDe}</span>
              </span>
            </div>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          </a>
        ))
      }
    </div>

    <div class="support-card" id="support">
      <div class="support-copy">
        <h3>
          <span class="i18n-en">Support ApkUp’s development</span>
          <span class="i18n-de">ApkUp unterstützen</span>
        </h3>
        <p>
          <span class="i18n-en">
            ApkUp is free, ad-free, and open source. If it saves you time keeping your apps up to
            date, consider starring the repository or buying a coffee.
          </span>
          <span class="i18n-de">
            ApkUp ist kostenlos, werbefrei und Open Source. Wenn dir die App Zeit spart, freue ich
            mich über einen Stern auf GitHub oder einen kleinen Kaffee.
          </span>
        </p>
      </div>

      <div class="support-actions">
        <a
          class="btn btn-secondary"
          href={SITE.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="i18n-en">Star on GitHub</span>
          <span class="i18n-de">Stern auf GitHub</span>
        </a>
        <a
          class="btn btn-primary"
          href="https://buymeacoffee.com/durcheins"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Buy Me a Coffee</span>
        </a>
        <a
          class="coindrop-link"
          href="https://coindrop.to/durcheins"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Support via Coindrop"
        >
          <img src={`${base}assets/coindrop-button.png`} alt="Coindrop.to me" width="192" height="48" loading="lazy" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .downloads-section {
    background: var(--surface-low);
    border-block: 1px solid var(--outline);
  }

  .primary-download-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    background: var(--bg);
    border: 1px solid var(--outline-strong);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3.5vw, 34px);
    margin-block-end: 20px;
  }

  .primary-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-end: 12px;
  }

  .primary-info h3 {
    margin: 0 0 8px;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .primary-info p {
    margin: 0;
    color: var(--text-muted);
    max-width: 58ch;
  }

  .primary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .mirrors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 12px;
    margin-block-end: 40px;
  }

  .mirror-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
    padding: 14px 18px;
    border-radius: var(--radius-md);
    background: var(--bg);
    border: 1px solid var(--outline);
    text-decoration: none;
    transition: background-color 150ms ease-out, border-color 150ms ease-out, transform 150ms ease-out;
  }

  .mirror-card:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .mirror-card:hover {
      background: var(--surface);
      border-color: var(--outline-strong);
    }
  }

  .mirror-main {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .mirror-badge {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .mirror-card.is-outdated {
    opacity: 0.78;
  }

  .badge-warn {
    color: var(--danger);
  }

  .support-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    background: var(--surface);
    border: 1px solid var(--outline-strong);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3.5vw, 34px);
  }

  .support-copy h3 {
    margin: 0 0 8px;
    font-size: 1.3rem;
    font-weight: 800;
  }

  .support-copy p {
    margin: 0;
    max-width: 56ch;
    color: var(--text-muted);
  }

  .support-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .coindrop-link {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .coindrop-link img {
    height: 48px;
    width: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .mirror-card,
    .mirror-card:active {
      transition: none;
      transform: none;
    }
  }
</style>
