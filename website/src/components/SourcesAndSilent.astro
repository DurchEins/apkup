---
import { SOURCES, SITE } from '../data/content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section id="sources" class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="i18n-en">All your app sources, unified &amp; prioritized</span>
        <span class="i18n-de">Alle Update-Quellen, vereint &amp; priorisiert</span>
      </h2>
      <p class="section-subtitle">
        <span class="i18n-en">
          First-launch source consent guarantees zero external requests until you pick what to
          enable. Reorder priorities globally or pin individual apps.
        </span>
        <span class="i18n-de">
          Durch die bewusste Quellenauswahl beim Erststart sendet ApkUp keine Anfragen ohne deine
          Zustimmung. Prioritäten lassen sich global sortieren oder pro App festpinnen.
        </span>
      </p>
    </div>

    <div class="sources-grid">
      {
        SOURCES.map((source) => (
          <article class="source-card">
            <div class="source-top">
              <h3>{source.name}</h3>
              <span class="pill-badge pill-neutral mono">{source.tag}</span>
            </div>
            <p>
              <span class="i18n-en">{source.en}</span>
              <span class="i18n-de">{source.de}</span>
            </p>
          </article>
        ))
      }
    </div>

    <div class="quick-compat-box">
      <div class="quick-compat-head">
        <div>
          <h3>
            <span class="i18n-en">Quick source &amp; repo compatibility check</span>
            <span class="i18n-de">Schneller Quellen- &amp; Repo-Kompatibilitätstest</span>
          </h3>
          <p>
            <span class="i18n-en">
              Paste any repository, F-Droid index, or app store URL to verify support instantly.
            </span>
            <span class="i18n-de">
              Füge eine Repository-, F-Droid- oder Store-URL ein und prüfe die Unterstützung sofort.
            </span>
          </p>
        </div>
        <a class="btn btn-secondary" href={`${base}compatibility/`}>
          <span class="i18n-en">Source &amp; Obtainium Checker →</span>
          <span class="i18n-de">Quellen- &amp; Obtainium-Check →</span>
        </a>
      </div>

      <div class="quick-compat-form">
        <input
          type="url"
          id="quick-compat-input"
          class="quick-compat-input mono"
          placeholder="https://github.com/owner/repo or https://gitlab.com/group/sub/repo"
          aria-label="Repository or store URL"
        />
        <div class="quick-compat-presets">
          <button type="button" class="preset-chip mono" data-preset-url="https://github.com/DurchEins/apkup">GitHub</button>
          <button type="button" class="preset-chip mono" data-preset-url="https://gitlab.com/AuroraOSS/AuroraStore">GitLab</button>
          <button type="button" class="preset-chip mono" data-preset-url="https://codeberg.org/Freeyourgadget/Gadgetbridge">Codeberg</button>
          <button type="button" class="preset-chip mono" data-preset-url="https://apt.izzysoft.de/fdroid/repo">IzzyOnDroid</button>
          <button type="button" class="preset-chip mono" data-preset-url="https://www.apkmirror.com/apk/google-inc/android-auto/">APKMirror</button>
          <button type="button" class="preset-chip mono" data-preset-url="https://play.google.com/store/apps/details?id=org.thoughtcrime.securesms">Play Store</button>
        </div>
      </div>

      <div class="quick-compat-result" id="quick-compat-result" role="status" hidden></div>
    </div>

    <div class="silent-box">
      <div class="silent-intro">
        <span class="pill-badge pill-emerald">
          <span class="i18n-en">Optional • Shizuku or Root (su)</span>
          <span class="i18n-de">Optional • Shizuku oder Root (su)</span>
        </span>
        <h3>
          <span class="i18n-en">Optional silent background updates</span>
          <span class="i18n-de">Optionale Hintergrund-Updates (Shizuku &amp; Root)</span>
        </h3>
        <p>
          <span class="i18n-en">
            Standard Android installs work out of the box without any extra setup. If you want
            hands-free background installs, pair ApkUp with Shizuku (no Root required) or enable
            optional Root (su) with Wi-Fi and charging guards.
          </span>
          <span class="i18n-de">
            Der normale Android-Installationsweg funktioniert jederzeit ohne Einrichtung. Wer
            lautlose Hintergrund-Updates möchte, kann optional Shizuku (ohne Root) oder Root (su)
            samt WLAN- und Lade-Regeln aktivieren.
          </span>
        </p>
        <a
          class="btn btn-secondary"
          href={`${SITE.wikiUrl}/Setting-up-Shizuku`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="i18n-en">Shizuku Setup Guide</span>
          <span class="i18n-de">Shizuku-Anleitung im Wiki</span>
        </a>
      </div>

      <ol class="silent-steps">
        <li>
          <span class="step-num mono">01</span>
          <div>
            <h4>
              <span class="i18n-en">Start Shizuku via Wireless Debugging</span>
              <span class="i18n-de">Shizuku per Wireless Debugging starten</span>
            </h4>
            <p>
              <span class="i18n-en">
                Enable Shizuku on Android 11+ in under a minute without unlocking your bootloader.
              </span>
              <span class="i18n-de">
                Aktiviere Shizuku ab Android 11 in unter einer Minute – ganz ohne Bootloader-Unlock.
              </span>
            </p>
          </div>
        </li>
        <li>
          <span class="step-num mono">02</span>
          <div>
            <h4>
              <span class="i18n-en">Grant ApkUp permission &amp; set guards</span>
              <span class="i18n-de">Berechtigung erteilen &amp; Regeln setzen</span>
            </h4>
            <p>
              <span class="i18n-en">
                Toggle silent updates in Setup and configure Wi-Fi-only, charging-only, and quiet
                hours.
              </span>
              <span class="i18n-de">
                Aktiviere Hintergrund-Updates im Setup und lege WLAN-, Lade- sowie Ruhezeit-Regeln
                fest.
              </span>
            </p>
          </div>
        </li>
        <li>
          <span class="step-num mono">03</span>
          <div>
            <h4>
              <span class="i18n-en">Verified auto-install with rollback safety</span>
              <span class="i18n-de">Verifizierte Installation samt Rollback-Schutz</span>
            </h4>
            <p>
              <span class="i18n-en">
                Every APK passes v2/v3 signature and compatibility checks first, with optional
                pre-update backup.
              </span>
              <span class="i18n-de">
                Jede APK durchläuft zuerst Signatur- und Kompatibilitätsprüfungen – auf Wunsch mit
                Backup vorab.
              </span>
            </p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var input = document.getElementById('quick-compat-input');
    var result = document.getElementById('quick-compat-result');
    if (!input || !result) return;

    function detectSource(raw) {
      var url = (raw || '').trim();
      if (!url) return null;
      var lower = url.toLowerCase();
      if (lower.includes('github.com/')) {
        return {
          ok: true,
          source: 'GitHub Releases',
          en: 'Supported natively — supports GraphQL batching (with PAT), asset regex filters, and SHA-256 verification.',
          de: 'Nativ unterstützt – inklusive gebündelter GraphQL-Abfragen (mit Token), Regex-Asset-Filter und SHA-256-Prüfung.',
        };
      }
      if (lower.includes('gitlab.com/') || lower.includes('gitlab.')) {
        return {
          ok: true,
          source: 'GitLab (incl. Subgroups)',
          en: 'Supported natively — handles multi-level subgroup paths and host-isolated personal access tokens.',
          de: 'Nativ unterstützt – verarbeitet auch mehrstufige Subgroup-Pfade sowie host-isolierte Tokens.',
        };
      }
      if (lower.includes('codeberg.org/') || lower.includes('forgejo') || lower.includes('gitea')) {
        return {
          ok: true,
          source: 'Codeberg / Forgejo',
          en: 'Supported natively — automatic ABI matching and custom self-hosted Forgejo/Gitea instance support.',
          de: 'Nativ unterstützt – inklusive automatischer ABI-Erkennung und selbst gehosteter Forgejo/Gitea-Instanzen.',
        };
      }
      if (lower.includes('f-droid.org') || lower.includes('izzysoft.de') || lower.includes('/fdroid/')) {
        return {
          ok: true,
          source: 'F-Droid Index V2 / IzzyOnDroid',
          en: 'Supported natively — uses RFC 7396 incremental diffs with cryptographic JAR fingerprint verification.',
          de: 'Nativ unterstützt – nutzt inkrementelle RFC-7396-Diffs samt kryptografischer JAR-Fingerprint-Prüfung.',
        };
      }
      if (lower.includes('apkmirror.com/')) {
        return {
          ok: true,
          source: 'APKMirror (.apkm)',
          en: 'Supported natively — direct in-app downloads, .apkm split-bundle extraction, and Cloudflare WebView fallback.',
          de: 'Nativ unterstützt – direkter In-App-Download, .apkm-Split-Entpackung und Cloudflare-WebView-Fallback.',
        };
      }
      if (lower.includes('play.google.com/')) {
        return {
          ok: true,
          source: 'Google Play Store',
          en: 'Supported anonymously — checks compatible updates via Aurora Dispenser without a Google account.',
          de: 'Anonym unterstützt – prüft kompatible Updates über Aurora Dispenser ganz ohne Google-Konto.',
        };
      }
      return {
        ok: false,
        source: 'Custom Host',
        en: 'Could be a self-hosted GitLab, Forgejo, or custom HTTPS F-Droid repo — add it via Custom Repo Binding or F-Droid ?fingerprint= in Setup.',
        de: 'Möglicherweise selbst gehostetes GitLab, Forgejo oder ein eigenes HTTPS-F-Droid-Repo – lässt sich im Setup als Custom-Repo oder ?fingerprint= hinzufügen.',
      };
    }

    function render(val) {
      var info = detectSource(val);
      if (!info) {
        result.hidden = true;
        return;
      }
      var isDe = document.documentElement.getAttribute('data-lang') === 'de';
      result.hidden = false;
      result.className = 'quick-compat-result ' + (info.ok ? 'is-ok' : 'is-warn');
      result.innerHTML =
        '<strong>' +
        info.source +
        '</strong><span>' +
        (isDe ? info.de : info.en) +
        '</span>';
    }

    input.addEventListener('input', function () {
      render(input.value);
    });

    document.querySelectorAll('[data-preset-url]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        input.value = btn.getAttribute('data-preset-url') || '';
        render(input.value);
      });
    });

    window.addEventListener('apkup:langchange', function () {
      if (input.value) render(input.value);
    });
  })();
</script>

<style>
  .sources-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-block-end: 40px;
  }

  @media (max-width: 1024px) {
    .sources-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .sources-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .source-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .source-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .source-card h3 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 700;
  }

  .source-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .silent-box {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    background: var(--surface-low);
    border: 1px solid var(--outline-strong);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 4vw, 40px);
  }

  .silent-intro h3 {
    margin: 14px 0 12px;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .silent-intro p {
    margin: 0 0 22px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .silent-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .silent-steps li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding: 16px;
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px solid var(--outline);
  }

  .step-num {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--tertiary-soft);
    color: var(--tertiary-soft-ink);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .silent-steps h4 {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 700;
  }

  .silent-steps p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .silent-box {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .quick-compat-box {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 3vw, 30px);
    margin-block-end: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .quick-compat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .quick-compat-head h3 {
    margin: 0 0 4px;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .quick-compat-head p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.94rem;
  }

  .quick-compat-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .quick-compat-input {
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--outline-strong);
    background: var(--bg);
    color: var(--text);
    font-size: 0.9rem;
  }

  .quick-compat-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .preset-chip {
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--outline);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .quick-compat-result {
    padding: 14px 16px;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.92rem;
  }

  .quick-compat-result.is-ok {
    background: var(--tertiary-soft);
    color: var(--tertiary-soft-ink);
  }

  .quick-compat-result.is-warn {
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
  }
</style>
