---
import { SOURCES } from '../data/content';
import { DEFAULT_LOCALE, getTranslations, localePath, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(lang);
type SourceKey = keyof typeof t.sources.items;
const wikiSourcesHref = localePath(lang, 'wiki/#doc-sources');
---

<section id="sources" class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t.sources.title}</h2>
      <p class="section-subtitle">{t.sources.subtitle}</p>
    </div>

    <div class="sources-grid">
      {
        SOURCES.map((source) => {
          const item = t.sources.items[source.id as SourceKey];
          return (
            <article class="source-card has-spotlight">
              <div class="source-top">
                <h3>{source.name}</h3>
                <span class="pill-badge pill-neutral mono">{item.tag}</span>
              </div>
              <p>{item.desc}</p>
            </article>
          );
        })
      }
    </div>

    <div class="quick-compat-box">
      <div class="quick-compat-row">
        <strong class="quick-compat-title">{t.sources.quickTest.title}</strong>
        <input
          type="url"
          id="quick-compat-input"
          class="quick-compat-input mono"
          placeholder={t.sources.quickTest.placeholder}
          aria-label={t.sources.quickTest.ariaLabel}
        />
        <a class="quick-compat-link" href={localePath(lang, 'compare/#checker')}>
          {t.sources.quickTest.checkerLink}
        </a>
      </div>
      <div class="quick-compat-bottom">
        <div class="quick-compat-presets">
          <button type="button" class="preset-chip mono" data-preset-url="https://github.com/DurchEins/apkup">GitHub</button>
          <button type="button" class="preset-chip mono" data-preset-url="https://gitlab.com/AuroraOSS/AuroraStore">GitLab</button>
          <button type="button" class="preset-chip mono" data-preset-url="https://codeberg.org/Freeyourgadget/Gadgetbridge">Codeberg</button>
          <button type="button" class="preset-chip mono" data-preset-url="https://apt.izzysoft.de/fdroid/repo">IzzyOnDroid</button>
          <button type="button" class="preset-chip mono" data-preset-url="https://www.apkmirror.com/apk/google-inc/android-auto/">APKMirror</button>
          <button type="button" class="preset-chip mono" data-preset-url="https://play.google.com/store/apps/details?id=org.thoughtcrime.securesms">Play Store</button>
        </div>
        <span class="quick-compat-hint">{t.sources.quickTest.hint}</span>
      </div>
      <div class="quick-compat-result" id="quick-compat-result" role="status" hidden></div>
    </div>

    <div class="silent-box">
      <div class="silent-intro">
        <span class="pill-badge pill-emerald">{t.sources.silent.badge}</span>
        <h3>{t.sources.silent.title}</h3>
        <p>{t.sources.silent.desc}</p>
        <div class="silent-mode-toggle" role="group" aria-label={t.sources.silent.modeAria}>
          <button type="button" class="mode-pill is-active" data-silent-mode="shizuku">
            {t.sources.silent.shizukuBtn}
          </button>
          <button type="button" class="mode-pill" data-silent-mode="root">
            {t.sources.silent.rootBtn}
          </button>
        </div>
        <a
          class="btn btn-secondary"
          id="silent-wiki-btn"
          href={localePath(lang, 'wiki/#doc-shizuku-setup')}
          data-shizuku-href={localePath(lang, 'wiki/#doc-shizuku-setup')}
          data-root-href={localePath(lang, 'wiki/#doc-shizuku-deep')}
          data-shizuku-label={t.sources.silent.shizukuGuideBtn}
          data-root-label={t.sources.silent.rootGuideBtn}
        >
          {t.sources.silent.shizukuGuideBtn}
        </a>
      </div>

      <ol class="silent-steps" data-mode-panel="shizuku">
        {t.sources.silent.shizukuSteps.map((step, i) => (
          <li>
            <span class="step-num mono">0{i + 1}</span>
            <div>
              <h4>{step.title}</h4>
              <p>{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>

      <ol class="silent-steps" data-mode-panel="root" hidden>
        {t.sources.silent.rootSteps.map((step, i) => (
          <li>
            <span class="step-num mono">0{i + 1}</span>
            <div>
              <h4>{step.title}</h4>
              <p>{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var modeBtns = document.querySelectorAll('[data-silent-mode]');
    var modePanels = document.querySelectorAll('[data-mode-panel]');
    var wikiBtn = document.getElementById('silent-wiki-btn');
    modeBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var mode = btn.getAttribute('data-silent-mode');
        modeBtns.forEach(function (b) {
          b.classList.toggle('is-active', b.getAttribute('data-silent-mode') === mode);
        });
        modePanels.forEach(function (p) {
          p.hidden = p.getAttribute('data-mode-panel') !== mode;
        });
        if (wikiBtn) {
          var isRoot = mode === 'root';
          wikiBtn.setAttribute('href', wikiBtn.getAttribute(isRoot ? 'data-root-href' : 'data-shizuku-href') || '');
          wikiBtn.textContent = wikiBtn.getAttribute(isRoot ? 'data-root-label' : 'data-shizuku-label') || '';
        }
      });
    });
  })();
</script>

<script
  is:inline
  define:vars={{
    detectedMap: t.sources.quickTest.detected,
    wikiLinkText: t.sources.quickTest.wikiLink,
    wikiSourcesHref,
  }}
>
  (function () {
    var input = document.getElementById('quick-compat-input');
    var result = document.getElementById('quick-compat-result');
    if (!input || !result) return;

    function detectSource(raw) {
      var url = (raw || '').trim();
      if (!url) return null;
      var lower = url.toLowerCase();
      if (lower.includes('github.com/')) return Object.assign({ ok: true }, detectedMap.github);
      if (lower.includes('gitlab.com/') || lower.includes('gitlab.')) return Object.assign({ ok: true }, detectedMap.gitlab);
      if (lower.includes('codeberg.org/') || lower.includes('forgejo') || lower.includes('gitea')) return Object.assign({ ok: true }, detectedMap.codeberg);
      if (lower.includes('f-droid.org') || lower.includes('izzysoft.de') || lower.includes('/fdroid/')) return Object.assign({ ok: true }, detectedMap.fdroid);
      if (lower.includes('apkmirror.com/')) return Object.assign({ ok: true }, detectedMap.apkmirror);
      if (lower.includes('play.google.com/')) return Object.assign({ ok: true }, detectedMap.playstore);
      return Object.assign({ ok: false }, detectedMap.custom);
    }

    function render(val) {
      var info = detectSource(val);
      if (!info) {
        result.hidden = true;
        return;
      }
      result.hidden = false;
      result.className = 'quick-compat-result ' + (info.ok ? 'is-ok' : 'is-warn');
      result.innerHTML = '';
      var strong = document.createElement('strong');
      strong.textContent = info.source;
      var span = document.createElement('span');
      span.textContent = info.msg + ' ';
      var a = document.createElement('a');
      a.href = wikiSourcesHref;
      a.style.cssText = 'color:var(--accent);font-weight:700;';
      a.textContent = wikiLinkText;
      span.appendChild(a);
      result.appendChild(strong);
      result.appendChild(span);
    }

    input.addEventListener('input', function () {
      render(input.value);
    });

    document.querySelectorAll('[data-preset-url]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        input.value = btn.getAttribute('data-preset-url') || '';
        render(input.value);
      });
    });
  })();
</script>

<style>
  .sources-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-block-end: 40px;
  }

  @media (max-width: 1024px) {
    .sources-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .sources-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .source-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .source-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .source-card h3 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 700;
  }

  .source-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .silent-box {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    background: var(--surface-low);
    border: 1px solid var(--outline-strong);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 4vw, 40px);
  }

  .silent-intro h3 {
    margin: 14px 0 12px;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .silent-intro p {
    margin: 0 0 22px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .silent-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .silent-steps li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding: 16px;
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px solid var(--outline);
  }

  .step-num {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--tertiary-soft);
    color: var(--tertiary-soft-ink);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .silent-steps h4 {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 700;
  }

  .silent-steps p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .silent-box {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .quick-compat-box {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 14px 18px;
    margin-block-end: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .quick-compat-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .quick-compat-title {
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .quick-compat-input {
    flex: 1;
    min-width: 220px;
    height: 38px;
    padding: 6px 12px;
    border-radius: 10px;
    border: 1px solid var(--outline-strong);
    background: var(--bg);
    color: var(--text);
    font-size: 0.84rem;
  }

  .quick-compat-link {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .quick-compat-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 16px;
  }

  .quick-compat-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .quick-compat-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .preset-chip {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--outline);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.74rem;
    font-weight: 700;
  }

  .silent-mode-toggle {
    display: inline-flex;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--bg);
    border: 1px solid var(--outline);
    gap: 4px;
    margin-block: 10px 14px;
  }

  .mode-pill {
    min-height: 36px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 700;
    transition: background-color 160ms ease-out, color 160ms ease-out;
  }

  .mode-pill.is-active {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .quick-compat-result {
    padding: 14px 16px;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.92rem;
  }

  .quick-compat-result[hidden] {
    display: none;
  }

  .quick-compat-result.is-ok {
    background: var(--tertiary-soft);
    color: var(--tertiary-soft-ink);
    animation: quickBounce 260ms cubic-bezier(0.2, 0, 0, 1);
  }

  .quick-compat-result.is-warn {
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
  }

  @keyframes quickBounce {
    0% { opacity: 0.5; transform: scale(0.97); }
    70% { transform: scale(1.015); }
    100% { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-compat-result.is-ok { animation: none; }
  }
</style>
