---
import { SHOWCASE_SCREENS } from '../data/content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section id="showcase" class="section showcase-section">
  <div class="container">
    <div class="showcase-top-row">
      <div class="section-header" style="margin-block-end: 0;">
        <h2 class="section-title">
          <span class="i18n-en">Try the real ApkUp interface</span>
          <span class="i18n-de">Die echte ApkUp-App direkt ausprobieren</span>
        </h2>
        <p class="section-subtitle">
          <span class="i18n-en">
            Interactive 1:1 replica of ApkUp’s Material 3 Expressive screens — tap Detail, History,
            Install All, filter chips, Apps User/System tabs, and Setup switches.
          </span>
          <span class="i18n-de">
            Originalgetreue interaktive Nachbildung der echten ApkUp-Oberfläche – tippe auf
            Details, Verlauf, Alle aktualisieren, Filter-Chips, Apps-Tabs oder die Quellen-Schalter.
          </span>
        </p>
      </div>

      <div class="mode-switch" role="group" aria-label="Showcase mode">
        <button type="button" class="mode-btn is-active" data-showcase-mode="demo" aria-pressed="true">
          <span class="i18n-en">Interactive App</span>
          <span class="i18n-de">Interaktive App</span>
        </button>
        <button type="button" class="mode-btn" data-showcase-mode="shots" aria-pressed="false">
          <span class="i18n-en">Real Screenshots</span>
          <span class="i18n-de">Echte Screenshots</span>
        </button>
      </div>
    </div>

    <!-- MODE 1: 1:1 INTERACTIVE APKUP APP -->
    <div class="showcase-shell" id="showcase-demo-view">
      <div class="demo-guide">
        <div class="guide-card">
          <span class="pill-badge pill-amber mono">1:1 Interactive UI</span>
          <h3>
            <span class="i18n-en">Explore every screen &amp; sheet</span>
            <span class="i18n-de">Alle Screens &amp; Bottom Sheets testen</span>
          </h3>
          <ul class="guide-list">
            <li>
              <span class="i18n-en">Tap <strong>Detail</strong> on any update card to open the full <strong>Update Details</strong> sheet (with Save APK &amp; Skip version)</span>
              <span class="i18n-de">Tippe auf <strong>Details</strong> für das komplette <strong>Update-Details</strong>-Sheet (inkl. APK speichern &amp; Überspringen)</span>
            </li>
            <li>
              <span class="i18n-en">Tap the <strong>History</strong> clock icon in the top bar to open <strong>Update History</strong> with rollback links</span>
              <span class="i18n-de">Tippe oben auf das <strong>Verlauf</strong>-Symbol für den Update-Verlauf mit Rollback-Links</span>
            </li>
            <li>
              <span class="i18n-en">Switch to <strong>Apps</strong> (User / System, Grid / List, search) or <strong>Settings</strong> (live source toggles &amp; theme)</span>
              <span class="i18n-de">Wechsle unten zu <strong>Apps</strong> (Benutzer / System, Raster / Liste) oder <strong>Setup</strong> (Quellen-Schalter)</span>
            </li>
          </ul>
          <button type="button" class="btn btn-secondary" id="sim-reset-btn">
            <span class="i18n-en">Reset Demo State</span>
            <span class="i18n-de">Demo zurücksetzen</span>
          </button>
        </div>
      </div>

      <div class="showcase-device">
        <div class="apkup-phone" aria-label="Interactive ApkUp 1:1 Android app">
          <!-- Status Bar -->
          <div class="apkup-statusbar mono">
            <span>16:47</span>
            <span class="apkup-camera" aria-hidden="true"></span>
            <span class="apkup-status-icons">5G • 54%</span>
          </div>

          <div class="apkup-viewport">
            <!-- SCREEN 1: UPDATES -->
            <div class="apkup-screen" data-sim-screen="updates">
              <div class="apkup-topbar">
                <div class="apkup-topbar-left">
                  <span class="apkup-title-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><circle cx="12" cy="12" r="1.5"/></svg>
                  </span>
                  <strong class="apkup-screen-title">Updates</strong>
                  <span class="apkup-count-badge mono" id="sim-badge-header">4</span>
                </div>
                <div class="apkup-topbar-actions">
                  <button type="button" class="apkup-icon-btn" id="sim-updates-search-toggle" aria-label="Search updates">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                  </button>
                  <button type="button" class="apkup-icon-btn" id="sim-history-open" aria-label="Open Update History">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg>
                  </button>
                  <button type="button" class="apkup-icon-btn" id="sim-refresh-btn" aria-label="Refresh updates">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
                  </button>
                </div>
              </div>

              <input type="search" class="apkup-search-bar" id="sim-updates-search" placeholder="Search updates…" hidden />

              <!-- Updates Summary Card -->
              <div class="apkup-summary-card">
                <div class="apkup-summary-left">
                  <span class="apkup-summary-circle">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M12 8v6m-3-3 3 3 3-3"/></svg>
                  </span>
                  <div class="apkup-summary-text">
                    <strong class="i18n-en" data-sim-avail-en>4 updates available</strong>
                    <strong class="i18n-de" data-sim-avail-de>4 Updates verfügbar</strong>
                    <span>Updates</span>
                  </div>
                </div>
                <button type="button" class="apkup-primary-pill" id="sim-install-all">
                  <span class="i18n-en">Install All</span>
                  <span class="i18n-de">Alle aktualisieren</span>
                </button>
              </div>

              <!-- Filter Chips -->
              <div class="apkup-chips">
                <button type="button" class="apkup-chip is-active" data-sim-filter="all">
                  <span>✓</span>
                  <span class="i18n-en">All apps</span>
                  <span class="i18n-de">Alle Apps</span>
                  <span class="apkup-chip-num mono">4</span>
                </button>
                <button type="button" class="apkup-chip" data-sim-filter="Google Play Store">
                  <span>▶</span>
                  <span>Google Play Store</span>
                  <span class="apkup-chip-num mono">1</span>
                </button>
                <button type="button" class="apkup-chip" data-sim-filter="ApkMirror">
                  <span>M</span>
                  <span>ApkMirror</span>
                  <span class="apkup-chip-num mono">2</span>
                </button>
                <button type="button" class="apkup-chip" data-sim-filter="GitHub">
                  <span>◎</span>
                  <span>GitHub</span>
                  <span class="apkup-chip-num mono">1</span>
                </button>
              </div>

              <!-- Update Cards -->
              <div class="apkup-card-list" id="sim-update-list">
                <article class="apkup-card" data-sim-app="aicore" data-sim-source="ApkMirror" data-sim-name="aicore">
                  <div class="apkup-card-row">
                    <div class="apkup-app-icon" style="background:#EFF6FF;color:#3B82F6;">✦</div>
                    <div class="apkup-card-info">
                      <strong>AICore</strong>
                      <div class="apkup-ver mono">0.release.aicore → <span>26.10.15…</span></div>
                      <span class="apkup-source-tag">M ApkMirror</span>
                    </div>
                  </div>
                  <div class="apkup-notes-box">
                    <span class="apkup-info-dot">i</span>
                    <div>
                      <div>* Operating system improvements and capabilities.</div>
                      <div>* Bug fixes and various optimizations.</div>
                    </div>
                  </div>
                  <div class="apkup-card-footer">
                    <button type="button" class="apkup-text-btn" data-sim-detail="aicore">
                      <span class="i18n-en">Detail</span>
                      <span class="i18n-de">Details</span>
                    </button>
                    <button type="button" class="apkup-primary-pill" data-sim-install="aicore">
                      <span class="i18n-en">Get update</span>
                      <span class="i18n-de">Update starten</span>
                    </button>
                  </div>
                </article>

                <article class="apkup-card" data-sim-app="auto" data-sim-source="ApkMirror" data-sim-name="android auto">
                  <div class="apkup-card-row">
                    <div class="apkup-app-icon" style="background:#ECFDF5;color:#10B981;">▲</div>
                    <div class="apkup-card-info">
                      <strong>Android Auto</strong>
                      <div class="apkup-ver mono">18.0.664264-release → <span>18.1.6644</span></div>
                      <span class="apkup-source-tag">M ApkMirror</span>
                    </div>
                  </div>
                  <div class="apkup-notes-box">
                    <span class="apkup-info-dot">i</span>
                    <div>
                      <div>What's new?</div>
                      <div>• Bug fixes and other improvements…</div>
                    </div>
                  </div>
                  <div class="apkup-card-footer">
                    <button type="button" class="apkup-text-btn" data-sim-detail="auto">
                      <span class="i18n-en">Detail</span>
                      <span class="i18n-de">Details</span>
                    </button>
                    <button type="button" class="apkup-primary-pill" data-sim-install="auto">
                      <span class="i18n-en">Get update</span>
                      <span class="i18n-de">Update starten</span>
                    </button>
                  </div>
                </article>

                <article class="apkup-card" data-sim-app="keyverifier" data-sim-source="Google Play Store" data-sim-name="android system key verifier">
                  <div class="apkup-card-row">
                    <div class="apkup-app-icon" style="background:#EFF6FF;color:#2563EB;">🛡</div>
                    <div class="apkup-card-info">
                      <strong>Android System Key Verifier</strong>
                      <div class="apkup-ver mono">1.483.1014711393 → <span>1.487.1016999859</span></div>
                      <span class="apkup-source-tag">▶ Google Play Store</span>
                    </div>
                  </div>
                  <div class="apkup-notes-box">
                    <span class="apkup-info-dot">i</span>
                    <div>Initial release: Store and verify end-to-end encryption contact keys.</div>
                  </div>
                  <div class="apkup-card-footer">
                    <button type="button" class="apkup-text-btn" data-sim-detail="keyverifier">
                      <span class="i18n-en">Detail</span>
                      <span class="i18n-de">Details</span>
                    </button>
                    <button type="button" class="apkup-primary-pill" data-sim-install="keyverifier">
                      <span class="i18n-en">Get update</span>
                      <span class="i18n-de">Update starten</span>
                    </button>
                  </div>
                </article>

                <article class="apkup-card" data-sim-app="apkup" data-sim-source="GitHub" data-sim-name="apkup">
                  <div class="apkup-card-row">
                    <div class="apkup-app-icon" style="background:#181A1F;color:#F59E0B;border:1px solid #F59E0B;">▲</div>
                    <div class="apkup-card-info">
                      <strong>ApkUp</strong>
                      <div class="apkup-ver mono">1.44.0 (203) → <span>1.45.0 (211)</span></div>
                      <span class="apkup-source-tag">◎ GitHub</span>
                    </div>
                  </div>
                  <div class="apkup-notes-box">
                    <span class="apkup-info-dot">i</span>
                    <div>• Material 3 Expressive &amp; Opt-in Self-Update Beta Channel.</div>
                  </div>
                  <div class="apkup-card-footer">
                    <button type="button" class="apkup-text-btn" data-sim-detail="apkup">
                      <span class="i18n-en">Detail</span>
                      <span class="i18n-de">Details</span>
                    </button>
                    <button type="button" class="apkup-primary-pill" data-sim-install="apkup">
                      <span class="i18n-en">Get update</span>
                      <span class="i18n-de">Update starten</span>
                    </button>
                  </div>
                </article>
              </div>
            </div>

            <!-- SCREEN 2: APPS -->
            <div class="apkup-screen" data-sim-screen="apps" hidden>
              <div class="apkup-topbar">
                <div class="apkup-topbar-left">
                  <span class="apkup-title-icon">⌂</span>
                  <strong class="apkup-screen-title">Apps</strong>
                  <span class="apkup-count-badge mono" id="sim-apps-count">111</span>
                </div>
                <div class="apkup-topbar-actions">
                  <button type="button" class="apkup-icon-btn" id="sim-apps-grid-toggle" aria-label="Toggle list or grid view">⊞</button>
                </div>
              </div>

              <div class="apkup-segmented">
                <button type="button" class="apkup-seg-btn is-active" data-sim-apptype="user">
                  ✓ User apps (111)
                </button>
                <button type="button" class="apkup-seg-btn" data-sim-apptype="system">
                  System apps (364)
                </button>
              </div>

              <input type="search" class="apkup-search-bar" id="sim-app-search" placeholder="Search apps… / Apps suchen…" />

              <div class="apkup-alpha-bar mono"><span>A</span><span>11</span></div>

              <div class="apkup-apps-list" id="sim-app-list">
                <div class="apkup-app-row" data-app-name="amber" data-app-type="user">
                  <div class="apkup-app-icon" style="background:#FEF3C7;color:#D97706;">◆</div>
                  <div class="apkup-app-meta">
                    <strong>Amber</strong>
                    <span class="mono">com.greenart7c3.nostrsigner</span>
                    <div class="apkup-app-pills">
                      <span class="apkup-ver-pill mono">v7.0.0-pre4</span>
                      <span class="apkup-source-tag">M APKMirror</span>
                    </div>
                  </div>
                </div>
                <div class="apkup-app-row" data-app-name="amethyst" data-app-type="user">
                  <div class="apkup-app-icon" style="background:#EDE9FE;color:#7C3AED;">❖</div>
                  <div class="apkup-app-meta">
                    <strong>Amethyst</strong>
                    <span class="mono">com.vitorpamplona.amethyst</span>
                    <div class="apkup-app-pills">
                      <span class="apkup-ver-pill mono">v1.21.0</span>
                      <span class="apkup-source-tag">Sideload</span>
                    </div>
                  </div>
                </div>
                <div class="apkup-app-row" data-app-name="android system key verifier" data-app-type="system">
                  <div class="apkup-app-icon" style="background:#EFF6FF;color:#2563EB;">🛡</div>
                  <div class="apkup-app-meta">
                    <strong>Android System Key Verifier</strong>
                    <span class="mono">com.google.android.contactkeys</span>
                    <div class="apkup-app-pills">
                      <span class="apkup-ver-pill mono">v1.483.1014711393</span>
                      <span class="apkup-source-tag">▶ Google Play</span>
                    </div>
                  </div>
                </div>
                <div class="apkup-app-row" data-app-name="ant radio service" data-app-type="system">
                  <div class="apkup-app-icon" style="background:#F3F4F6;color:#374151;">◉</div>
                  <div class="apkup-app-meta">
                    <strong>ANT Radio Service</strong>
                    <span class="mono">com.dsi.ant.service.socket</span>
                    <div class="apkup-app-pills">
                      <span class="apkup-ver-pill mono">v4.18.00</span>
                      <span class="apkup-source-tag">▶ Google Play</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- SCREEN 3: SETTINGS -->
            <div class="apkup-screen" data-sim-screen="settings" hidden>
              <div class="apkup-topbar">
                <div class="apkup-topbar-left">
                  <span class="apkup-title-icon">⚙</span>
                  <strong class="apkup-screen-title">
                    <span class="i18n-en">Settings</span>
                    <span class="i18n-de">Einstellungen</span>
                  </strong>
                </div>
              </div>

              <div class="apkup-settings-card">
                <div class="apkup-settings-heading">Appearance &amp; Layout</div>
                <div class="apkup-settings-sub">Theme</div>
                <div class="apkup-segmented">
                  <button type="button" class="apkup-seg-btn is-active" data-sim-theme="dark">✓ Dark</button>
                  <button type="button" class="apkup-seg-btn" data-sim-theme="light">Light</button>
                </div>
              </div>

              <div class="apkup-settings-card">
                <div class="apkup-settings-heading">Update Sources</div>

                <label class="apkup-source-switch-row">
                  <div>
                    <strong>ApkMirror</strong>
                    <span>Direct downloads active</span>
                  </div>
                  <input type="checkbox" checked class="apkup-m3-switch" />
                </label>

                <label class="apkup-source-switch-row">
                  <div>
                    <strong>Google Play Store</strong>
                  </div>
                  <input type="checkbox" checked class="apkup-m3-switch" />
                </label>

                <label class="apkup-source-switch-row">
                  <div>
                    <strong>IzzyOnDroid / F-Droid V2</strong>
                    <span>Tap to configure repositories</span>
                  </div>
                  <input type="checkbox" checked class="apkup-m3-switch" />
                </label>

                <label class="apkup-source-switch-row">
                  <div>
                    <strong>GitHub</strong>
                    <span>Check GitHub releases</span>
                  </div>
                  <input type="checkbox" checked class="apkup-m3-switch" />
                </label>

                <label class="apkup-source-switch-row">
                  <div>
                    <strong>GitLab &amp; Codeberg</strong>
                    <span>Self-hosted &amp; subgroups</span>
                  </div>
                  <input type="checkbox" checked class="apkup-m3-switch" />
                </label>
              </div>
            </div>
          </div>

          <!-- MODAL BOTTOM SHEET: UPDATE DETAILS -->
          <div class="apkup-sheet" id="sim-detail-sheet" hidden>
            <div class="apkup-sheet-handle"></div>
            <div class="apkup-sheet-top">
              <div class="apkup-app-icon" id="sim-sheet-icon">✦</div>
              <div style="flex:1;min-width:0;">
                <strong id="sim-sheet-title">AICore</strong>
                <div class="apkup-pkg mono" id="sim-sheet-pkg">com.google.android.aicore</div>
              </div>
              <button type="button" class="apkup-icon-btn" id="sim-detail-close" aria-label="Close details">✕</button>
            </div>
            <div class="apkup-sheet-ver-pill mono" id="sim-sheet-ver">0.release → 26.10.15</div>
            <div class="apkup-sheet-tags">
              <span class="apkup-source-tag" id="sim-sheet-src">M ApkMirror</span>
              <span class="apkup-source-tag mono">2026-11-15 00:57:07</span>
            </div>
            <div class="apkup-notes-box" style="margin-block:10px;">
              <div>
                <div style="color:var(--accent);font-weight:700;margin-bottom:4px;">What's new</div>
                <div id="sim-sheet-notes"></div>
              </div>
            </div>
            <button type="button" class="apkup-primary-pill" style="width:100%;justify-content:center;margin-bottom:8px;" id="sim-sheet-install">
              <span class="i18n-en">Get update</span>
              <span class="i18n-de">Update starten</span>
            </button>
            <button type="button" class="apkup-tonal-pill" style="width:100%;justify-content:center;">
              <span class="i18n-en">Save APK</span>
              <span class="i18n-de">APK speichern</span>
            </button>
          </div>

          <!-- MODAL BOTTOM SHEET: UPDATE HISTORY -->
          <div class="apkup-sheet" id="sim-history-sheet" hidden>
            <div class="apkup-sheet-handle"></div>
            <div class="apkup-sheet-top">
              <span class="apkup-title-icon">↺</span>
              <div style="flex:1;">
                <strong>Update History <span class="apkup-count-badge mono">3</span></strong>
                <div class="apkup-pkg">App updates installed by ApkUp</div>
              </div>
              <button type="button" class="apkup-icon-btn" id="sim-history-close" aria-label="Close history">✕</button>
            </div>
            <div class="apkup-history-list">
              <div class="apkup-history-item">
                <strong>Reddit</strong>
                <span class="apkup-ver-pill mono">2026.45.0 → 2026.46.0</span>
                <div class="apkup-rollback-pill">↺ Get previous version (2026.45.0)</div>
              </div>
              <div class="apkup-history-item">
                <strong>Notebook</strong>
                <span class="apkup-ver-pill mono">1.66.7 → 1.67.7</span>
                <div class="apkup-rollback-pill">↺ Get previous version (1.66.7)</div>
              </div>
              <div class="apkup-history-item">
                <strong>Claude by Anthropic</strong>
                <span class="apkup-ver-pill mono">1.261112 → 1.261113</span>
                <div class="apkup-rollback-pill">↺ Get previous version (1.261112)</div>
              </div>
            </div>
          </div>

          <!-- FLOATING CAPSULE BOTTOM NAVIGATION -->
          <nav class="apkup-dock" aria-label="ApkUp bottom navigation">
            <button type="button" class="apkup-dock-btn" data-sim-nav="apps">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5 12 3l9 7.5V21a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
              <span>Apps</span>
            </button>
            <button type="button" class="apkup-dock-btn is-active" data-sim-nav="updates">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v5l3 2"/></svg>
              <span>Updates</span>
              <span class="apkup-dock-badge mono" id="sim-badge-dock">4</span>
            </button>
            <button type="button" class="apkup-dock-btn" data-sim-nav="settings">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.6.86 1 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
              <span>Settings</span>
            </button>
          </nav>
        </div>
      </div>
    </div>

    <!-- MODE 2: REAL SCREENSHOTS GALLERY -->
    <div class="showcase-shell" id="showcase-shots-view" hidden>
      <div class="showcase-controls">
        <div class="tab-list" role="tablist" aria-label="App screenshots">
          {
            SHOWCASE_SCREENS.map((screen, idx) => (
              <button
                type="button"
                role="tab"
                class={`tab-btn ${idx === 0 ? 'is-active' : ''}`}
                id={`tab-${screen.id}`}
                aria-selected={idx === 0 ? 'true' : 'false'}
                aria-controls={`panel-${screen.id}`}
                tabindex={idx === 0 ? 0 : -1}
                data-screen-tab={screen.id}
              >
                <span class="i18n-en">{screen.enLabel}</span>
                <span class="i18n-de">{screen.deLabel}</span>
              </button>
            ))
          }
        </div>

        <div class="showcase-panels">
          {
            SHOWCASE_SCREENS.map((screen, idx) => (
              <div
                id={`panel-${screen.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${screen.id}`}
                class={`tab-panel ${idx === 0 ? 'is-active' : ''}`}
                hidden={idx !== 0}
                data-screen-panel={screen.id}
              >
                <h3>
                  <span class="i18n-en">{screen.enTitle}</span>
                  <span class="i18n-de">{screen.deTitle}</span>
                </h3>
                <p>
                  <span class="i18n-en">{screen.enDesc}</span>
                  <span class="i18n-de">{screen.deDesc}</span>
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="showcase-device">
        <div class="device-bezel">
          {
            SHOWCASE_SCREENS.map((screen, idx) => (
              <div
                class={`screen-slot ${idx === 0 ? 'is-active' : ''}`}
                data-screen-media={screen.id}
                hidden={idx !== 0}
              >
                <img
                  class="i18n-en"
                  src={`${base}${screen.enImg}`}
                  alt={`ApkUp ${screen.enLabel} screen`}
                  width="360"
                  height="780"
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="i18n-de"
                  src={`${base}${screen.deImg}`}
                  alt={`ApkUp Ansicht ${screen.deLabel}`}
                  width="360"
                  height="780"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // 1. Mode switch
    var modeBtns = Array.prototype.slice.call(document.querySelectorAll('[data-showcase-mode]'));
    var demoView = document.getElementById('showcase-demo-view');
    var shotsView = document.getElementById('showcase-shots-view');

    modeBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var mode = btn.getAttribute('data-showcase-mode');
        modeBtns.forEach(function (b) {
          var active = b.getAttribute('data-showcase-mode') === mode;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        if (demoView) demoView.hidden = mode !== 'demo';
        if (shotsView) shotsView.hidden = mode !== 'shots';
      });
    });

    // 2. Real Screenshots Tablist
    var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-screen-tab]'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('[data-screen-panel]'));
    var media = Array.prototype.slice.call(document.querySelectorAll('[data-screen-media]'));

    function activateShot(id, focusTab) {
      tabs.forEach(function (tab) {
        var active = tab.getAttribute('data-screen-tab') === id;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.setAttribute('tabindex', active ? '0' : '-1');
        if (active && focusTab) tab.focus();
      });
      panels.forEach(function (p) {
        p.hidden = p.getAttribute('data-screen-panel') !== id;
      });
      media.forEach(function (m) {
        m.hidden = m.getAttribute('data-screen-media') !== id;
      });
    }

    tabs.forEach(function (tab, index) {
      tab.addEventListener('click', function () {
        activateShot(tab.getAttribute('data-screen-tab'), false);
      });
      tab.addEventListener('keydown', function (e) {
        var next = index;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (index + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        else return;
        e.preventDefault();
        activateShot(tabs[next].getAttribute('data-screen-tab'), true);
      });
    });

    // 3. 1:1 ApkUp Navigation
    var navBtns = Array.prototype.slice.call(document.querySelectorAll('[data-sim-nav]'));
    var screens = Array.prototype.slice.call(document.querySelectorAll('[data-sim-screen]'));
    navBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = btn.getAttribute('data-sim-nav');
        navBtns.forEach(function (b) {
          b.classList.toggle('is-active', b.getAttribute('data-sim-nav') === target);
        });
        screens.forEach(function (s) {
          s.hidden = s.getAttribute('data-sim-screen') !== target;
        });
      });
    });

    // Search updates toggle
    var updSearchBtn = document.getElementById('sim-updates-search-toggle');
    var updSearchInput = document.getElementById('sim-updates-search');
    var updateCards = Array.prototype.slice.call(document.querySelectorAll('#sim-update-list .apkup-card'));

    if (updSearchBtn && updSearchInput) {
      updSearchBtn.addEventListener('click', function () {
        updSearchInput.hidden = !updSearchInput.hidden;
        if (!updSearchInput.hidden) updSearchInput.focus();
      });
      updSearchInput.addEventListener('input', function () {
        var q = updSearchInput.value.trim().toLowerCase();
        updateCards.forEach(function (c) {
          var n = c.getAttribute('data-sim-name') || '';
          c.hidden = q.length > 0 && n.indexOf(q) === -1;
        });
      });
    }

    // Source Filter Chips
    var filterChips = Array.prototype.slice.call(document.querySelectorAll('[data-sim-filter]'));
    filterChips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var src = chip.getAttribute('data-sim-filter');
        filterChips.forEach(function (c) {
          c.classList.toggle('is-active', c.getAttribute('data-sim-filter') === src);
        });
        updateCards.forEach(function (card) {
          if (card.getAttribute('data-sim-done') === 'true') return;
          card.hidden = src !== 'all' && card.getAttribute('data-sim-source') !== src;
        });
      });
    });

    // Install & Badge Sync
    var badgeHeader = document.getElementById('sim-badge-header');
    var badgeDock = document.getElementById('sim-badge-dock');
    var availEn = document.querySelector('[data-sim-avail-en]');
    var availDe = document.querySelector('[data-sim-avail-de]');

    function syncCount() {
      var remaining = updateCards.filter(function (c) {
        return c.getAttribute('data-sim-done') !== 'true';
      }).length;
      if (badgeHeader) badgeHeader.textContent = String(remaining);
      if (badgeDock) badgeDock.textContent = String(remaining);
      if (availEn) availEn.textContent = remaining === 0 ? 'All apps up to date' : remaining + ' updates available';
      if (availDe) availDe.textContent = remaining === 0 ? 'Alle Apps aktuell' : remaining + ' Updates verfügbar';
    }

    function installCard(card) {
      if (!card || card.getAttribute('data-sim-done') === 'true') return;
      var btn = card.querySelector('[data-sim-install]');
      if (!btn) return;
      btn.disabled = true;
      btn.innerHTML = '<span class="i18n-en">Installing…</span><span class="i18n-de">Installiere…</span>';
      setTimeout(function () {
        card.setAttribute('data-sim-done', 'true');
        card.classList.add('is-installed');
        btn.innerHTML = '<span class="i18n-en">Installed ✓</span><span class="i18n-de">Installiert ✓</span>';
        syncCount();
      }, 420);
    }

    document.querySelectorAll('[data-sim-install]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        installCard(btn.closest('.apkup-card'));
      });
    });

    var installAllBtn = document.getElementById('sim-install-all');
    if (installAllBtn) {
      installAllBtn.addEventListener('click', function () {
        updateCards.forEach(function (card, i) {
          setTimeout(function () {
            installCard(card);
          }, i * 160);
        });
      });
    }

    var resetBtn = document.getElementById('sim-reset-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        updateCards.forEach(function (card) {
          card.removeAttribute('data-sim-done');
          card.classList.remove('is-installed');
          card.hidden = false;
          var btn = card.querySelector('[data-sim-install]');
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<span class="i18n-en">Get update</span><span class="i18n-de">Update starten</span>';
          }
        });
        filterChips.forEach(function (c) {
          c.classList.toggle('is-active', c.getAttribute('data-sim-filter') === 'all');
        });
        syncCount();
      });
    }

    // Update Detail Bottom Sheet
    var DETAILS = {
      aicore: {
        title: 'AICore',
        pkg: 'com.google.android.aicore',
        ver: '0.release.prod_aicore_20260917.00_RC04 → 26.10.15.11.release.qc8635',
        src: 'M ApkMirror',
        notes: '* Operating system improvements and capabilities.<br>* Bug fixes and various optimizations.',
      },
      auto: {
        title: 'Android Auto',
        pkg: 'com.google.android.projection.gearhead',
        ver: '18.0.664264-release → 18.1.6644',
        src: 'M ApkMirror',
        notes: '• Bug fixes and split-bundle (.apkm) optimizations.<br>• Verified arm64-v8a signature match.',
      },
      keyverifier: {
        title: 'Android System Key Verifier',
        pkg: 'com.google.android.contactkeys',
        ver: '1.483.1014711393 → 1.487.1016999859',
        src: '▶ Google Play Store',
        notes: '• Initial release: Store and verify end-to-end encryption contact keys.',
      },
      apkup: {
        title: 'ApkUp',
        pkg: 'com.apkup',
        ver: '1.44.0 (203) → 1.45.0 (211)',
        src: '◎ GitHub',
        notes: '• Material 3 Expressive look, wave progress indicators & opt-in Beta channel.<br>• SHA256SUMS verified.',
      },
    };

    var detailSheet = document.getElementById('sim-detail-sheet');
    var activeDetailKey = null;
    document.querySelectorAll('[data-sim-detail]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var key = btn.getAttribute('data-sim-detail');
        var item = DETAILS[key];
        if (!item || !detailSheet) return;
        activeDetailKey = key;
        document.getElementById('sim-sheet-title').textContent = item.title;
        document.getElementById('sim-sheet-pkg').textContent = item.pkg;
        document.getElementById('sim-sheet-ver').textContent = item.ver;
        document.getElementById('sim-sheet-src').textContent = item.src;
        document.getElementById('sim-sheet-notes').innerHTML = item.notes;
        detailSheet.hidden = false;
      });
    });

    var detailClose = document.getElementById('sim-detail-close');
    if (detailClose && detailSheet) {
      detailClose.addEventListener('click', function () {
        detailSheet.hidden = true;
      });
    }

    var sheetInstall = document.getElementById('sim-sheet-install');
    if (sheetInstall && detailSheet) {
      sheetInstall.addEventListener('click', function () {
        if (activeDetailKey) {
          var card = document.querySelector('[data-sim-app="' + activeDetailKey + '"]');
          installCard(card);
        }
        detailSheet.hidden = true;
      });
    }

    // History Bottom Sheet
    var histBtn = document.getElementById('sim-history-open');
    var histSheet = document.getElementById('sim-history-sheet');
    var histClose = document.getElementById('sim-history-close');
    if (histBtn && histSheet) {
      histBtn.addEventListener('click', function () {
        histSheet.hidden = false;
      });
    }
    if (histClose && histSheet) {
      histClose.addEventListener('click', function () {
        histSheet.hidden = true;
      });
    }

    // Apps User/System + Search + Grid
    var appTypeBtns = Array.prototype.slice.call(document.querySelectorAll('[data-sim-apptype]'));
    var appRows = Array.prototype.slice.call(document.querySelectorAll('#sim-app-list .apkup-app-row'));
    var appSearch = document.getElementById('sim-app-search');
    var appsCount = document.getElementById('sim-apps-count');

    appTypeBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var t = btn.getAttribute('data-sim-apptype');
        appTypeBtns.forEach(function (b) {
          b.classList.toggle('is-active', b.getAttribute('data-sim-apptype') === t);
        });
        if (appsCount) appsCount.textContent = t === 'user' ? '111' : '364';
        appRows.forEach(function (r) {
          r.hidden = r.getAttribute('data-app-type') !== t;
        });
      });
    });

    if (appSearch) {
      appSearch.addEventListener('input', function () {
        var q = appSearch.value.trim().toLowerCase();
        appRows.forEach(function (r) {
          var name = r.getAttribute('data-app-name') || '';
          r.hidden = q.length > 0 && name.indexOf(q) === -1;
        });
      });
    }

    var appsGridBtn = document.getElementById('sim-apps-grid-toggle');
    var appsListEl = document.getElementById('sim-app-list');
    if (appsGridBtn && appsListEl) {
      appsGridBtn.addEventListener('click', function () {
        appsListEl.classList.toggle('is-grid');
      });
    }

    // Settings Theme switcher sync
    document.querySelectorAll('[data-sim-theme]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var targetTheme = btn.getAttribute('data-sim-theme');
        document.querySelectorAll('[data-sim-theme]').forEach(function (b) {
          b.classList.toggle('is-active', b.getAttribute('data-sim-theme') === targetTheme);
        });
        document.documentElement.setAttribute('data-theme', targetTheme);
        try {
          localStorage.setItem('apkup-theme', targetTheme);
        } catch (e) {}
      });
    });
  })();
</script>

<style>
  .showcase-section {
    background: var(--surface-low);
    border-block: 1px solid var(--outline);
