---
import { getBaseUrl } from '../utils/site';
import { SHOWCASE_SCREENS } from '../data/content';
import { DEFAULT_LOCALE, LOCALE_META, getTranslations, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(lang);
const base = getBaseUrl();
const screenshotDir = LOCALE_META[lang].screenshotDir;
type ScreenKey = keyof typeof t.showcase.screens;
---

<section id="showcase" class="section showcase-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t.showcase.title}</h2>
      <p class="section-subtitle">{t.showcase.subtitle}</p>
    </div>

    <div class="showcase-shell">
      <div class="showcase-controls">
        <div class="showcase-toolbar">
          <div class="tab-list" role="tablist" aria-label={t.showcase.tablistAria}>
            {
              SHOWCASE_SCREENS.map((screen, idx) => {
                const s = t.showcase.screens[screen.id as ScreenKey];
                return (
                  <button
                    type="button"
                    role="tab"
                    class={`tab-btn ${idx === 0 ? 'is-active' : ''}`}
                    id={`tab-${screen.id}`}
                    aria-selected={idx === 0 ? 'true' : 'false'}
                    aria-controls={`panel-${screen.id}`}
                    tabindex={idx === 0 ? 0 : -1}
                    data-screen-tab={screen.id}
                  >
                    {s.label}
                  </button>
                );
              })
            }
          </div>
          <button
            type="button"
            id="showcase-pause-btn"
            class="showcase-pause-btn"
            aria-pressed="false"
            aria-label={t.showcase.pauseAria}
            title={t.showcase.pauseAria}
            data-pause-label={t.showcase.pauseAria}
            data-play-label={t.showcase.playAria}
          >
            <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <rect x="6" y="5" width="4" height="14" rx="1" />
              <rect x="14" y="5" width="4" height="14" rx="1" />
            </svg>
            <svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden>
              <path d="M8 5v14l11-7z" />
            </svg>
          </button>
        </div>

        <div class="showcase-panels">
          {
            SHOWCASE_SCREENS.map((screen, idx) => {
              const s = t.showcase.screens[screen.id as ScreenKey];
              return (
                <div
                  id={`panel-${screen.id}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${screen.id}`}
                  class={`tab-panel ${idx === 0 ? 'is-active' : ''}`}
                  hidden={idx !== 0}
                  data-screen-panel={screen.id}
                >
                  <h3>{s.title}</h3>
                  <p>{s.desc}</p>
                </div>
              );
            })
          }
        </div>
      </div>

      <div class="showcase-device">
        <button
          type="button"
          id="showcase-zoom-btn"
          class="device-zoom-btn"
          aria-label={t.showcase.lightboxAria}
        >
          <span class="device-bezel">
            {
              SHOWCASE_SCREENS.map((screen, idx) => {
                const s = t.showcase.screens[screen.id as ScreenKey];
                const imgRel = screen.enImg.replace('assets/screenshots/en/', `assets/screenshots/${screenshotDir}/`);
                return (
                  <span
                    class={`screen-slot ${idx === 0 ? 'is-active' : ''}`}
                    data-screen-media={screen.id}
                    hidden={idx !== 0}
                  >
                    <img
                      src={`${base}${imgRel}`}
                      alt={s.alt}
                      width="360"
                      height="780"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                );
              })
            }
          </span>
        </button>
      </div>
    </div>
  </div>
</section>

<dialog id="shot-lightbox" class="shot-lightbox" aria-label={t.showcase.lightboxAria}>
  <button type="button" id="shot-lightbox-close" class="shot-lightbox-close" aria-label={t.showcase.closePreviewAria}><span aria-hidden="true">✕</span></button>
  <img id="shot-lightbox-img" src="" alt="" />
</dialog>

<script is:inline>
  (function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-screen-tab]'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('[data-screen-panel]'));
    var media = Array.prototype.slice.call(document.querySelectorAll('[data-screen-media]'));

    if (!tabs.length) return;

    function activate(id, focusTab) {
      tabs.forEach(function (tab) {
        var active = tab.getAttribute('data-screen-tab') === id;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.setAttribute('tabindex', active ? '0' : '-1');
        if (active && focusTab) tab.focus();
      });

      panels.forEach(function (panel) {
        var active = panel.getAttribute('data-screen-panel') === id;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });

      media.forEach(function (slot) {
        var active = slot.getAttribute('data-screen-media') === id;
        slot.classList.toggle('is-active', active);
        slot.hidden = !active;
      });
    }

    tabs.forEach(function (tab, index) {
      tab.addEventListener('click', function () {
        activate(tab.getAttribute('data-screen-tab'), false);
      });

      tab.addEventListener('keydown', function (e) {
        var nextIndex = index;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          nextIndex = (index + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          nextIndex = 0;
        } else if (e.key === 'End') {
          nextIndex = tabs.length - 1;
        } else {
          return;
        }
        e.preventDefault();
        activate(tabs[nextIndex].getAttribute('data-screen-tab'), true);
      });
    });

    var showcaseEl = document.getElementById('showcase');
    var pauseBtn = document.getElementById('showcase-pause-btn');
    var autoIdx = 0;
    var userPaused = false;
    var hoverOrFocusPaused = false;
    var autoTimer = null;
    var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function syncPauseState() {
      var isPaused = userPaused || reducedMotion;
      if (showcaseEl) showcaseEl.classList.toggle('is-paused', isPaused);
      if (pauseBtn) {
        pauseBtn.setAttribute('aria-pressed', String(userPaused));
        var label = userPaused
          ? pauseBtn.getAttribute('data-play-label')
          : pauseBtn.getAttribute('data-pause-label');
        if (label) {
          pauseBtn.setAttribute('aria-label', label);
          pauseBtn.setAttribute('title', label);
        }
        var pauseIcon = pauseBtn.querySelector('.icon-pause');
        var playIcon = pauseBtn.querySelector('.icon-play');
        if (pauseIcon) pauseIcon.hidden = userPaused;
        if (playIcon) playIcon.hidden = !userPaused;
      }
    }

    if (reducedMotion && pauseBtn) {
      pauseBtn.hidden = true;
    }

    if (showcaseEl && !reducedMotion) {
      function startAuto() {
        clearInterval(autoTimer);
        autoTimer = setInterval(function () {
          if (userPaused || hoverOrFocusPaused) return;
          autoIdx = (autoIdx + 1) % tabs.length;
          activate(tabs[autoIdx].getAttribute('data-screen-tab'), false);
        }, 3200);
      }
      showcaseEl.addEventListener('mouseenter', function () { hoverOrFocusPaused = true; });
      showcaseEl.addEventListener('mouseleave', function () { hoverOrFocusPaused = false; });
      showcaseEl.addEventListener('focusin', function () { hoverOrFocusPaused = true; });
      showcaseEl.addEventListener('focusout', function (e) {
        if (!showcaseEl.contains(e.relatedTarget)) hoverOrFocusPaused = false;
      });
      if (pauseBtn) {
        pauseBtn.addEventListener('click', function () {
          userPaused = !userPaused;
          syncPauseState();
        });
      }
      tabs.forEach(function (t, i) {
        t.addEventListener('click', function () {
          autoIdx = i;
          userPaused = true;
          syncPauseState();
        });
      });
      syncPauseState();
      startAuto();
    } else {
      syncPauseState();
    }

    var lightbox = document.getElementById('shot-lightbox');
    var lightboxImg = document.getElementById('shot-lightbox-img');
    var lightboxClose = document.getElementById('shot-lightbox-close');
    var zoomBtn = document.getElementById('showcase-zoom-btn');
    if (zoomBtn && lightbox && lightboxImg) {
      zoomBtn.addEventListener('click', function () {
        var activeSlot = document.querySelector('[data-screen-media].is-active');
        if (!activeSlot) return;
        var img = activeSlot.querySelector('img');
        if (!img) return;
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt || 'ApkUp Screenshot';
        if (typeof lightbox.showModal === 'function') lightbox.showModal();
      });
      if (lightboxClose) lightboxClose.addEventListener('click', function () { lightbox.close(); });
      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) lightbox.close();
      });
      lightbox.addEventListener('close', function () {
        zoomBtn.focus();
      });
    }
  })();
</script>

<style>
  .showcase-section {
    background: var(--surface-low);
    border-block: 1px solid var(--outline);
  }

  .showcase-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(28px, 5vw, 56px);
  }

  .showcase-toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-block-end: 24px;
  }

  .tab-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .showcase-pause-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--outline);
    background: var(--surface);
    color: var(--text);
  }

  .showcase-pause-btn[hidden] {
    display: none;
  }

  .showcase-pause-btn[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (hover: hover) {
    .showcase-pause-btn:hover {
      background: var(--surface-high);
      border-color: var(--outline-strong);
    }
  }

  .tab-btn {
    position: relative;
    overflow: hidden;
    min-height: 44px;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--outline);
    background: var(--surface);
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.9rem;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out,
      border-color 150ms ease-out,
      transform 150ms ease-out;
  }

  .tab-btn.is-active::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 2px;
    height: 2px;
    border-radius: 999px;
    background: rgba(18, 19, 22, 0.45);
    transform-origin: left;
    animation: tabProgress 3.2s linear infinite;
  }

  #showcase:hover .tab-btn.is-active::after,
  #showcase:focus-within .tab-btn.is-active::after,
  #showcase.is-paused .tab-btn.is-active::after {
    animation-play-state: paused;
  }

  @keyframes tabProgress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .shot-lightbox {
    padding: 12px;
    border: 1px solid var(--outline-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-low);
    max-width: min(440px, 92vw);
    max-height: 90vh;
    box-shadow: var(--shadow-elevated);
  }

  .shot-lightbox::backdrop {
    background: rgba(10, 11, 14, 0.84);
    backdrop-filter: blur(8px);
  }

  .shot-lightbox img {
    max-height: 82vh;
    width: auto;
    margin: 0 auto;
    border-radius: 18px;
  }

  .shot-lightbox-close {
    position: absolute;
    top: 10px;
    right: 10px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 999px;
    border: 1px solid var(--outline-strong);
    background: var(--surface-high);
    color: var(--text);
    font-weight: 700;
  }

  .tab-btn:active {
    transform: scale(0.96);
  }

  .tab-btn.is-active {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  @media (hover: hover) {
    .tab-btn:not(.is-active):hover {
      background: var(--surface-high);
      color: var(--text);
    }
  }

  .showcase-panels {
    background: var(--bg);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3vw, 32px);
  }

  .tab-panel h3 {
    margin: 0 0 12px;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .tab-panel p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .showcase-device {
    display: flex;
    justify-content: center;
  }

  .device-zoom-btn {
    padding: 0;
    border: none;
    background: transparent;
    border-radius: 34px;
    cursor: zoom-in;
    display: block;
  }

  .device-bezel {
    display: block;
    width: min(310px, 82vw);
    padding: 10px;
    border-radius: 34px;
    background: var(--bg);
    border: 1px solid var(--outline-strong);
    box-shadow: var(--shadow-elevated);
  }

  .screen-slot {
    display: block;
  }

  .screen-slot[hidden] {
    display: none;
  }

  .screen-slot img {
    width: 100%;
    border-radius: 24px;
    outline: 1px solid var(--img-ring);
    outline-offset: -1px;
  }

  @media (max-width: 900px) {
    .showcase-shell {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-btn,
    .tab-btn:active {
      transition: none;
      transform: none;
    }
    .tab-btn.is-active::after {
      animation: none;
    }
  }
  [data-screen-media].is-active {
    animation: shotFadeIn 240ms cubic-bezier(0.2, 0, 0, 1);
  }

  @keyframes shotFadeIn {
    from {
      opacity: 0.45;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-screen-media].is-active {
      animation: none;
    }
  }
</style>
