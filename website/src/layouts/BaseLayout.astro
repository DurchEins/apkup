---
import { getBaseUrl } from '../utils/site';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_META,
  absoluteLocaleUrl,
  getTranslations,
  localePath,
  type Locale,
} from '../i18n';
import KaoBanner from '../components/KaoBanner.astro';

interface Props {
  lang?: Locale;
  subPath?: string;
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  kaoBannerSize?: 'normal' | 'mini';
}

const {
  lang = DEFAULT_LOCALE,
  subPath = '',
  title,
  description,
  jsonLd,
  kaoBannerSize = 'mini',
} = Astro.props;

const t = getTranslations(lang);
const metaInfo = LOCALE_META[lang];
const pageTitle = title || t.meta.defaultTitle;
const pageDesc = description || t.meta.defaultDescription;
const ldList = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

const base = getBaseUrl();
const siteOrigin = Astro.site ? Astro.site.origin : 'https://durcheins.github.io';
const canonical = absoluteLocaleUrl(lang, subPath, siteOrigin);
const xDefaultUrl = absoluteLocaleUrl(DEFAULT_LOCALE, subPath, siteOrigin);
const ogImage = new URL(`${base}og-card.png`, Astro.site).toString();
const shareUrl = absoluteLocaleUrl(lang, subPath, siteOrigin);
---

<!doctype html>
<html lang={metaInfo.hreflang} data-theme="dark" data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content="#121316" id="meta-theme-color" />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((loc) => (
      <link
        rel="alternate"
        hreflang={LOCALE_META[loc].hreflang}
        href={absoluteLocaleUrl(loc, subPath, siteOrigin)}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link rel="alternate" type="text/plain" title="LLMs.txt" href={`${base}llms.txt`} />
    <link rel="icon" type="image/png" href={`${base}assets/logo.png`} />
    <link rel="apple-touch-icon" href={`${base}assets/logo.png`} />
    <link rel="stylesheet" href={`${base}assets/styles.css`} />

    <!-- OpenGraph & Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={metaInfo.hreflang.replace('-', '_')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts CDN (Plus Jakarta Sans + JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {ldList.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Prevent theme flash & auto-detect language on default root URLs before first paint -->
    <script is:inline define:vars={{ currentLang: lang, basePath: base, cleanSubPath: subPath }}>
      (function () {
        try {
          var savedTheme = localStorage.getItem('apkup-theme');
          var theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
          var meta = document.getElementById('meta-theme-color');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#F4F1EA' : '#121316');

          if (currentLang === 'en') {
            var nonDefault = ['de', 'es', 'fr', 'it', 'ja', 'pt', 'ru', 'zh-cn'];
            var savedLang = null;
            try {
              savedLang = localStorage.getItem('apkup-lang');
            } catch (e) {}

            var targetLang = null;
            if (savedLang === 'en') {
              targetLang = 'en';
            } else if (savedLang && nonDefault.indexOf(savedLang) !== -1) {
              targetLang = savedLang;
            } else {
              var langs = navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language || 'en'];
              for (var i = 0; i < langs.length; i++) {
                var raw = String(langs[i] || '').toLowerCase().replace(/_/g, '-');
                if (!raw) continue;
                if (raw === 'en' || raw.indexOf('en-') === 0) { targetLang = 'en'; break; }
                if (raw === 'de' || raw.indexOf('de-') === 0) { targetLang = 'de'; break; }
                if (raw === 'es' || raw.indexOf('es-') === 0) { targetLang = 'es'; break; }
                if (raw === 'fr' || raw.indexOf('fr-') === 0) { targetLang = 'fr'; break; }
                if (raw === 'it' || raw.indexOf('it-') === 0) { targetLang = 'it'; break; }
                if (raw === 'ja' || raw.indexOf('ja-') === 0) { targetLang = 'ja'; break; }
                if (raw === 'pt' || raw.indexOf('pt-') === 0) { targetLang = 'pt'; break; }
                if (raw === 'ru' || raw.indexOf('ru-') === 0) { targetLang = 'ru'; break; }
                if (
                  raw === 'zh' ||
                  raw === 'zh-cn' ||
                  raw === 'zh-sg' ||
                  raw === 'zh-hans' ||
                  raw.indexOf('zh-hans-') === 0
                ) {
                  targetLang = 'zh-cn';
                  break;
                }
              }
            }

            if (targetLang && targetLang !== 'en') {
              var dest = basePath + targetLang + '/' + cleanSubPath + window.location.search + window.location.hash;
              window.location.replace(dest);
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t.meta.skipToContent}
    </a>

    <KaoBanner lang={lang} size={kaoBannerSize} />

    <slot />
    <button
      type="button"
      id="back-to-top-btn"
      class="back-to-top-pill"
      aria-label={t.meta.backToTop}
      title={t.meta.backToTop}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m18 15-6-6-6 6" />
      </svg>
    </button>

    <aside id="dev-mode-hud" class="dev-mode-hud mono" aria-label={t.meta.devModeTitle} hidden>
      <div class="dev-hud-head">
        <strong>{t.meta.devModeTitle}</strong>
        <button type="button" id="dev-hud-close" aria-label="Close Developer HUD">✕</button>
      </div>
      <div class="dev-hud-grid">
        <span>Release: <strong>v1.45.0 (211)</strong></span>
        <span>SDK: <strong>API 29 – 36 (Android 10–17)</strong></span>
        <span>ABIs: <strong>arm64-v8a • armeabi-v7a • x86_64</strong></span>
        <span>Signature: <strong>APK Scheme v2/v3 + SHA-256</strong></span>
        <span id="dev-hud-perf">DOM Ready: <strong>-- ms</strong></span>
      </div>
    </aside>

    <script
      is:inline
      define:vars={{
        copiedToastMsg: t.meta.copiedToast,
        shareTitleMsg: t.meta.shareTitle,
        shareTextMsg: t.meta.shareText,
        canonicalShareUrl: shareUrl,
      }}
    >
      (function () {
        var root = document.documentElement;
        var themeBtn = document.getElementById('theme-toggle');

        function applyTheme(next) {
          root.classList.add('theme-switching');
          root.setAttribute('data-theme', next);
          var meta = document.getElementById('meta-theme-color');
          if (meta) meta.setAttribute('content', next === 'light' ? '#F4F1EA' : '#121316');
          try {
            localStorage.setItem('apkup-theme', next);
          } catch (e) {}
          if (themeBtn) {
            themeBtn.setAttribute('aria-pressed', String(next === 'light'));
          }
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              root.classList.remove('theme-switching');
            });
          });
        }

        if (themeBtn) {
          themeBtn.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'light'));
          try {
            if (!localStorage.getItem('apkup-theme')) themeBtn.classList.add('is-system-sync');
          } catch (e) {}
          themeBtn.addEventListener('click', function () {
            themeBtn.classList.remove('is-system-sync');
            var current = root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
            applyTheme(current === 'dark' ? 'light' : 'dark');
          });
        }

        function showCopied(btn) {
          var lbl = btn.querySelector('[data-share-label]');
          var copied = btn.querySelector('[data-share-copied]');
          if (!lbl || !copied) return;
          lbl.hidden = true;
          copied.hidden = false;
          btn.classList.add('is-copied');
          if (window.innerWidth <= 860) {
            var t = document.createElement('div');
            t.className = 'brand-toast mono';
            t.textContent = copiedToastMsg;
            document.body.appendChild(t);
            setTimeout(function () { t.remove(); }, 1800);
          }
          clearTimeout(btn._shareTimer);
          btn._shareTimer = setTimeout(function () {
            lbl.hidden = false;
            copied.hidden = true;
            btn.classList.remove('is-copied');
          }, 2000);
        }

        // Konami Code (↑↑↓↓←→←→BA) & Alt+D Developer Mode HUD
        var devHud = document.getElementById('dev-mode-hud');
        var devClose = document.getElementById('dev-hud-close');
        var devPerf = document.getElementById('dev-hud-perf');
        var konami = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
        var kPos = 0;
        function toggleDevHud() {
          if (!devHud) return;
          devHud.hidden = !devHud.hidden;
          if (!devHud.hidden && devPerf && window.performance) {
            devPerf.innerHTML = 'DOM Load: <strong>' + Math.round(performance.now()) + ' ms</strong>';
          }
        }
        if (devClose) devClose.addEventListener('click', function () { if (devHud) devHud.hidden = true; });
        document.addEventListener('keydown', function (e) {
          if (e.altKey && (e.key === 'd' || e.key === 'D')) {
            e.preventDefault();
            toggleDevHud();
            return;
          }
          var key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
          if (key === konami[kPos]) {
            kPos++;
            if (kPos === konami.length) {
              kPos = 0;
              toggleDevHud();
            }
          } else {
            kPos = 0;
          }
        });

        var topBtn = document.getElementById('back-to-top-btn');
        if (topBtn) {
          function syncTopBtn() {
            topBtn.classList.toggle('is-visible', window.scrollY > 480);
          }
          window.addEventListener('scroll', syncTopBtn, { passive: true });
          syncTopBtn();
          topBtn.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // TV/D-Pad keyboard focus mode
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Tab' || e.key.indexOf('Arrow') === 0) {
            root.classList.add('kbd-nav');
          }
        });
        document.addEventListener('pointerdown', function () {
          root.classList.remove('kbd-nav');
        });

        // Global mouse-tracking spotlight on .has-spotlight cards
        if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.has-spotlight').forEach(function (card) {
            card.addEventListener('pointermove', function (e) {
              var r = card.getBoundingClientRect();
              card.style.setProperty('--mx', e.clientX - r.left + 'px');
              card.style.setProperty('--my', e.clientY - r.top + 'px');
            });
          });
        }

        document.querySelectorAll('[data-share-btn]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var shareData = {
              title: shareTitleMsg,
              text: shareTextMsg,
              url: canonicalShareUrl
            };
            if (navigator.share) {
              navigator.share(shareData).catch(function (err) {
                if (err && err.name === 'AbortError') return;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                  navigator.clipboard.writeText(canonicalShareUrl).then(function () { showCopied(btn); }).catch(function () {});
                }
              });
            } else if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(canonicalShareUrl).then(function () { showCopied(btn); }).catch(function () {});
            }
          });
        });
      })();
    </script>
  </body>
</html>
