---
import { execSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface ReleaseEntry {
  header: string;
  date: string;
  version: string;
  badge: string;
  isFeature: boolean;
  bannerTitle?: string;
  bannerTag?: string;
  bullets: { title: string; body: string }[];
}

interface MonthGroup {
  month: string;
  releases: ReleaseEntry[];
}

function loadReleasedMarkdown(relPath: string, repoRoot: string): string {
  try {
    return execSync(`git show main:${relPath}`, { cwd: repoRoot, encoding: 'utf8' });
  } catch {
    return readFileSync(join(repoRoot, relPath), 'utf8');
  }
}

function parseChangelog(raw: string): MonthGroup[] {
  const lines = raw.split(/\r?\n/);
  const months: MonthGroup[] = [];
  let currentMonth: MonthGroup | null = null;
  let currentRelease: ReleaseEntry | null = null;

  for (const line of lines) {
    if (line.startsWith('## ')) {
      currentMonth = { month: line.slice(3).trim(), releases: [] };
      months.push(currentMonth);
      currentRelease = null;
    } else if (line.startsWith('### ') && currentMonth) {
      const parts = line.slice(4).split('|').map((s) => s.trim());
      const badge = parts[2] || 'Update';
      const isFeature = /feature|major/i.test(badge);
      currentRelease = {
        header: line.slice(4).trim(),
        date: parts[0] || '',
        version: parts[1] || '',
        badge,
        isFeature,
        bullets: [],
      };
      currentMonth.releases.push(currentRelease);
    } else if (line.startsWith('> [Banner]') && currentRelease) {
      const bParts = line.replace('> [Banner]', '').split('|').map((s) => s.trim());
      currentRelease.bannerTitle = bParts[0] || '';
      currentRelease.bannerTag = bParts[1] || '';
    } else if (line.startsWith('- **') && currentRelease) {
      const m = line.match(/^- \*\*(.+?)\*\*\s*(.*)$/);
      if (m) {
        currentRelease.bullets.push({ title: m[1], body: m[2] });
      }
    }
  }
  return months;
}

const repoRoot = join(process.cwd(), '..');
const enMonths = parseChangelog(loadReleasedMarkdown('app/src/main/assets/changelog/1.45_en.md', repoRoot));
const deMonths = parseChangelog(loadReleasedMarkdown('app/src/main/assets/changelog/1.45_de.md', repoRoot));
---

<BaseLayout title="What’s New? — ApkUp">
  <Navbar />
  <main id="main-content" class="section">
    <div class="container subpage-wrap">
      <div class="section-header">
        <h1 class="section-title">
          <span class="i18n-en">What’s New?</span>
          <span class="i18n-de">Was ist neu?</span>
        </h1>
        <p class="section-subtitle">
          <span class="i18n-en">
            Monthly release history synced from ApkUp’s published in-app changelog. Click any
            month below to expand or collapse.
          </span>
          <span class="i18n-de">
            Monatlicher Release-Verlauf aus dem veröffentlichten In-App-Changelog von ApkUp. Klicke
            auf einen Monat zum Auf- oder Zuklappen.
          </span>
        </p>
      </div>

      <div class="cl-filter-bar" role="group" aria-label="Filter releases">
        <button type="button" class="cl-filter-chip is-active" data-cl-filter="all">
          <span class="i18n-en">All Releases</span>
          <span class="i18n-de">Alle Releases</span>
        </button>
        <button type="button" class="cl-filter-chip" data-cl-filter="feature">
          <span class="i18n-en">Feature Update</span>
          <span class="i18n-de">Feature-Update</span>
        </button>
        <button type="button" class="cl-filter-chip" data-cl-filter="patch">
          <span class="i18n-en">Patch &amp; Fix</span>
          <span class="i18n-de">Patch &amp; Bugfix</span>
        </button>
      </div>

      <div class="i18n-en cl-months">
        {
          enMonths.map((group, idx) => (
            <details class="cl-month" open={idx === 0}>
              <summary class="cl-month-head">
                <h2>{group.month}</h2>
                <div class="cl-month-right">
                  <span class="pill-badge pill-neutral mono">{group.releases.length} releases</span>
                  <svg class="cl-chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </div>
              </summary>
              <div class="cl-releases">
                {group.releases.map((rel) => (
                  <article class="cl-card" data-cl-type={rel.isFeature ? 'feature' : 'patch'}>
                    <div class="cl-card-head">
                      <div>
                        <span class="cl-date">{rel.date}</span>
                        <h3 class="mono">{rel.version}</h3>
                      </div>
                      <span class={`pill-badge ${rel.isFeature ? 'pill-purple' : 'pill-blue'}`}>
                        {rel.badge}
                      </span>
                    </div>
                    {rel.bannerTitle && (
                      <div class="cl-banner">
                        <div class="cl-banner-left">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3l1.9 4.5L18.5 9l-4.6 1.5L12 15l-1.9-4.5L5.5 9l4.6-1.5L12 3z" />
                          </svg>
                          <strong>{rel.bannerTitle}</strong>
                        </div>
                        {rel.bannerTag && <span class="mono cl-banner-tag">{rel.bannerTag}</span>}
                      </div>
                    )}
                    <ul class="cl-list">
                      {rel.bullets.map((b) => (
                        <li>
                          <strong>{b.title}</strong> {b.body}
                        </li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            </details>
          ))
        }
      </div>

      <div class="i18n-de cl-months">
        {
          deMonths.map((group, idx) => (
            <details class="cl-month" open={idx === 0}>
              <summary class="cl-month-head">
                <h2>{group.month}</h2>
                <div class="cl-month-right">
                  <span class="pill-badge pill-neutral mono">{group.releases.length} Releases</span>
                  <svg class="cl-chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </div>
              </summary>
              <div class="cl-releases">
                {group.releases.map((rel) => (
                  <article class="cl-card" data-cl-type={rel.isFeature ? 'feature' : 'patch'}>
                    <div class="cl-card-head">
                      <div>
                        <span class="cl-date">{rel.date}</span>
                        <h3 class="mono">{rel.version}</h3>
                      </div>
                      <span class={`pill-badge ${rel.isFeature ? 'pill-purple' : 'pill-blue'}`}>
                        {rel.badge}
                      </span>
                    </div>
                    {rel.bannerTitle && (
                      <div class="cl-banner">
                        <div class="cl-banner-left">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3l1.9 4.5L18.5 9l-4.6 1.5L12 15l-1.9-4.5L5.5 9l4.6-1.5L12 3z" />
                          </svg>
                          <strong>{rel.bannerTitle}</strong>
                        </div>
                        {rel.bannerTag && <span class="mono cl-banner-tag">{rel.bannerTag}</span>}
                      </div>
                    )}
                    <ul class="cl-list">
                      {rel.bullets.map((b) => (
                        <li>
                          <strong>{b.title}</strong> {b.body}
                        </li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  (function () {
    var btns = document.querySelectorAll('[data-cl-filter]');
    var cards = document.querySelectorAll('.cl-card[data-cl-type]');
    var months = document.querySelectorAll('.cl-month');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var f = btn.getAttribute('data-cl-filter');
        btns.forEach(function (b) {
          b.classList.toggle('is-active', b.getAttribute('data-cl-filter') === f);
        });
        cards.forEach(function (c) {
          c.hidden = f !== 'all' && c.getAttribute('data-cl-type') !== f;
        });
        months.forEach(function (m) {
          var visible = m.querySelectorAll('.cl-card:not([hidden])').length;
          m.hidden = visible === 0;
          if (f !== 'all' && visible > 0) m.open = true;
        });
      });
    });
  })();
</script>

<style>
  .cl-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-end: 20px;
  }

  .cl-filter-chip {
    min-height: 36px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--outline);
    background: var(--surface-low);
    color: var(--text-muted);
    font-size: 0.84rem;
    font-weight: 700;
    transition: border-color 150ms ease-out, background-color 150ms ease-out, color 150ms ease-out;
  }

  .cl-filter-chip.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .subpage-wrap {
    max-width: 900px;
  }

  .cl-months {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .cl-month {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: 8px 22px 18px;
  }

  .cl-month-head {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 14px;
    cursor: pointer;
  }

  .cl-month-head::-webkit-details-marker {
    display: none;
  }

  .cl-month-head h2 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .cl-month-right {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .cl-chev {
    color: var(--text-muted);
    transition: transform 150ms ease-out, color 150ms ease-out;
  }

  .cl-month[open] .cl-chev {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .cl-releases {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 8px;
  }

  .cl-card {
    background: var(--bg);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 20px;
  }

  .cl-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }

  .cl-date {
    display: block;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .cl-card-head h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .pill-purple {
    background: rgba(168, 85, 247, 0.16);
    color: #c084fc;
  }

  .pill-blue {
    background: rgba(56, 189, 248, 0.16);
    color: #38bdf8;
  }

  .cl-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 13px 16px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--accent-soft), rgba(245, 158, 11, 0.12));
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: var(--accent-soft-ink);
    margin-bottom: 14px;
  }

  .cl-banner-left {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .cl-banner-tag {
    font-size: 0.82rem;
    font-weight: 700;
    opacity: 0.9;
  }

  .cl-list {
    margin: 0;
    padding-inline-start: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .cl-list strong {
    color: var(--text);
  }
</style>
