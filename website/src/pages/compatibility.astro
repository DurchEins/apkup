    de: 'Automatische Update-Erkennung für installierte Apps (ohne manuelle URL-Pflege)',
    apkup: '✓ 7 Sources',
    obtainium: '✕ Manual URLs',
    aurora: '✓ Play Only',
    fdroid: '✓ F-Droid Only',
  },
  {
    en: 'Anonymous Google Play Store delta updates (no Google account)',
    de: 'Anonyme Google-Play-Store-Updates (ohne Google-Konto)',
    apkup: '✓ Built-in',
    obtainium: '✕ No',
    aurora: '✓ Built-in',
    fdroid: '✕ No',
  },
  {
    en: 'Direct in-app APKMirror downloads & .apkm split-bundle extraction',
    de: 'Direkter APKMirror-Download in der App & .apkm-Split-Entpackung',
    apkup: '✓ Native + WebView',
    obtainium: '◐ Track Only',
    aurora: '✕ No',
    fdroid: '✕ No',
  },
  {
    en: 'F-Droid Index V2 incremental diffs (RFC 7396) & X.509 TOFU pinning',
    de: 'Inkrementelle F-Droid-Index-V2-Diffs (RFC 7396) & TOFU-Zertifikats-Pinning',
    apkup: '✓ Built-in',
    obtainium: '◐ Basic Repo',
    aurora: '✕ No',
    fdroid: '✓ Built-in',
  },
  {
    en: 'GitHub GraphQL batching, GitLab nested subgroups & Codeberg/Forgejo',
    de: 'Gebündeltes GitHub-GraphQL, mehrstufige GitLab-Subgroups & Codeberg/Forgejo',
    apkup: '✓ Full Support',
    obtainium: '✓ REST / Custom',
    aurora: '✕ No',
    fdroid: '✕ No',
  },
  {
    en: 'Drag-and-drop source priority & per-app source pinning with fallback',
    de: 'Drag-and-Drop-Quellen-Priorität & festes App-Pinning samt Fallback',
    apkup: '✓ Built-in',
    obtainium: '✕ Single Source',
    aurora: '✕ Single Source',
    fdroid: '◐ Repo Priority',
  },
  {
    en: 'Pre-install APK Signature Scheme v2/v3 mismatch & downgrade block',
    de: 'Vorab-Prüfung der APK-Signatur (v2/v3) & Schutz vor Versions-Downgrades',
    apkup: '✓ Cryptographic',
    obtainium: '◐ OS Installer',
    aurora: '◐ OS Installer',
    fdroid: '✓ Repo Signed',
  },
  {
    en: 'Automatic pre-update APK rollback backups (including split APKs)',
    de: 'Automatische Rollback-Sicherungen vor jedem Update (inkl. Split-APKs)',
    apkup: '✓ Up to 2 GB Local',
    obtainium: '✕ No',
    aurora: '✕ No',
    fdroid: '✕ No',
  },
  {
    en: 'Pre-install minSdk & CPU ABI compatibility guard',
    de: 'Vorab-Kompatibilitätsprüfung auf Android-Mindestversion (minSdk) & CPU-ABI',
    apkup: '✓ Built-in',
    obtainium: '◐ Regex / Manual',
    aurora: '✓ Device Profile',
    fdroid: '✓ Index Metadata',
  },
  {
    en: 'Silent background installations via Shizuku (no Root) & Root (su)',
    de: 'Lautlose Hintergrund-Installation über Shizuku (ohne Root) & Root (su)',
    apkup: '✓ Shizuku + su',
    obtainium: '✓ Shizuku + su',
    aurora: '✓ Shizuku + su',
    fdroid: '✓ Privileged / Shizuku',
  },
  {
    en: 'Configurable background quiet hours, active time windows & Wi-Fi/charging guards',
    de: 'Ruhezeiten, aktive Zeitfenster sowie WLAN- und Lade-Schutzregeln',
    apkup: '✓ Full Schedule',
    obtainium: '◐ Basic Interval',
    aurora: '◐ Basic Interval',
    fdroid: '◐ Basic Interval',
  },
  {
    en: 'Obtainium JSON import (with interactive preview) & export interoperability',
    de: 'Obtainium-JSON-Import (mit interaktiver Vorschau) & Export-Kompatibilität',
    apkup: '✓ 2-Way Sync',
    obtainium: '✓ Native Format',
    aurora: '✕ No',
    fdroid: '✕ No',
  },
  {
    en: 'Google Tink AES-256-GCM Keystore token encryption & host-isolated redirects',
