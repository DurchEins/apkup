---
import DownloadsPage from '../../views/DownloadsPage.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
---
<DownloadsPage lang={lang} />
