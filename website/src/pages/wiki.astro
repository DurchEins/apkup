const wikiDir = join(process.cwd(), 'src/data/wiki');
const RENDERED_CHAPTERS = CHAPTERS.map((ch) => ({
  ...ch,
  fullHtml: renderFullWikiHtml(readFileSync(join(wikiDir, ch.mdFile), 'utf8')),
}));
---

<BaseLayout title="Wiki & Guides — ApkUp">
  <Navbar />
  <main id="main-content" class="section">
    <div class="container">
      <div class="wiki-top">
        <div class="section-header" style="margin-block-end: 0;">
          <h1 class="section-title">
            <span class="i18n-en">ApkUp Wiki &amp; Documentation</span>
            <span class="i18n-de">ApkUp-Wiki &amp; Anleitungen</span>
          </h1>
          <p class="section-subtitle">
            <span class="i18n-en">
              All 9 official guides adapted into a clean, bilingual layout — search across every
              topic below or switch chapters on the left.
            </span>
            <span class="i18n-de">
              Alle 9 offiziellen Wiki-Kapitel übersichtlich und zweisprachig aufbereitet –
              durchsuche alle Themen live oder wähle links ein Kapitel.
            </span>
          </p>
        </div>

        <div class="wiki-search-bar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
          <input
            type="search"
            id="wiki-search-input"
            placeholder="Search all 9 guides (e.g. Shizuku, Cloudflare, 403, TOFU, Obtainium, Rollback)…"
            aria-label="Search wiki guides"
          />
          <span class="wiki-search-count mono" id="wiki-search-count" hidden></span>
        </div>
      </div>

      <div class="wiki-layout">
        <aside class="wiki-sidebar" aria-label="Wiki chapters">
          <div class="wiki-nav-card" role="tablist" aria-orientation="vertical">
            {
              CHAPTERS.map((ch, idx) => (
                <button
                  type="button"
                  role="tab"
                  class={`wiki-tab-btn ${idx === 0 ? 'is-active' : ''}`}
                  data-wiki-tab={ch.slug}
                  aria-selected={idx === 0 ? 'true' : 'false'}
                >
                  <span class="wiki-tab-title">
                    <span class="i18n-en">{ch.enTitle}</span>
                    <span class="i18n-de">{ch.deTitle}</span>
                  </span>
                  <span class="wiki-tab-tag mono">{ch.tag}</span>
                </button>
              ))
            }
          </div>
        </aside>

        <div class="wiki-content" id="wiki-content-top">
          {
            RENDERED_CHAPTERS.map((ch, idx) => (
              <article
                class="wiki-chapter-card"
                id={`doc-${ch.slug}`}
                data-wiki-article={ch.slug}
                hidden={idx !== 0}
              >
                <div class="wiki-chapter-top">
                  <span class="pill-badge pill-amber mono">{ch.tag}</span>
                  <a
                    class="wiki-gh-link mono"
                    href={`${SITE.wikiUrl}/${ch.ghPage}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    GitHub Wiki ↗
                  </a>
                </div>

                <h2 class="wiki-chapter-title">
                  <span class="i18n-en">{ch.enTitle}</span>
                  <span class="i18n-de">{ch.deTitle}</span>
                </h2>

                <p class="wiki-chapter-lead">
                  <span class="i18n-en">{ch.enLead}</span>
                  <span class="i18n-de">{ch.deLead}</span>
                </p>

                {ch.cards && ch.cards.length > 0 && (
                  <div class="wiki-cards-grid">
                    {ch.cards.map((c) => (
                      <div class="wiki-subcard">
                        {c.badge && <span class="pill-badge pill-neutral mono">{c.badge}</span>}
                        <h3>
                          <span class="i18n-en">{c.enTitle}</span>
                          <span class="i18n-de">{c.deTitle}</span>
                        </h3>
                        <p>
                          <span class="i18n-en">{c.enBody}</span>
                          <span class="i18n-de">{c.deBody}</span>
                        </p>
                      </div>
                    ))}
                  </div>
                )}

                {ch.steps && ch.steps.length > 0 && (
                  <div class="wiki-steps-block">
                    {ch.stepsTitleEn && (
                      <h3 class="wiki-block-heading">
                        <span class="i18n-en">{ch.stepsTitleEn}</span>
                        <span class="i18n-de">{ch.stepsTitleDe}</span>
                      </h3>
                    )}
                    <ol class="wiki-steps-list">
                      {ch.steps.map((s, sIdx) => (
                        <li>
                          <span class="wiki-step-num mono">0{sIdx + 1}</span>
                          <div>
                            <h4>
                              <span class="i18n-en">{s.enTitle}</span>
                              <span class="i18n-de">{s.deTitle}</span>
                            </h4>
                            <p>
                              <span class="i18n-en">{s.enBody}</span>
                              <span class="i18n-de">{s.deBody}</span>
                            </p>
                          </div>
                        </li>
                      ))}
                    </ol>
                  </div>
                )}

                {ch.tableHeaders && ch.tableRows && (
                  <div class="wiki-table-wrap">
                    <table class="wiki-table">
                      <thead>
                        <tr>
                          <th>{ch.tableHeaders.h1}</th>
                          <th>
                            <span class="i18n-en">{ch.tableHeaders.h2En}</span>
                            <span class="i18n-de">{ch.tableHeaders.h2De}</span>
                          </th>
                          <th>
                            <span class="i18n-en">{ch.tableHeaders.h3En}</span>
                            <span class="i18n-de">{ch.tableHeaders.h3De}</span>
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {ch.tableRows.map((r) => (
                          <tr>
                            <td class="mono"><strong>{r.col1}</strong></td>
                            <td>
                              <span class="i18n-en">{r.col2En}</span>
                              <span class="i18n-de">{r.col2De}</span>
                            </td>
                            <td>
                              <span class="i18n-en">{r.col3En}</span>
                              <span class="i18n-de">{r.col3De}</span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                {ch.deepDives && ch.deepDives.length > 0 && (
                  <div class="wiki-deep-list">
                    {ch.deepDives.map((d) => (
                      <details class="wiki-deep-item" open>
                        <summary>
                          <span>
                            <span class="i18n-en">{d.qEn}</span>
                            <span class="i18n-de">{d.qDe}</span>
                          </span>
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="m6 9 6 6 6-6" />
                          </svg>
                        </summary>
                        <p>
                          <span class="i18n-en">{d.aEn}</span>
                          <span class="i18n-de">{d.aDe}</span>
                        </p>
                      </details>
                    ))}
                  </div>
                )}
                <div class="wk-full-section">
                  <div class="wk-full-divider">
                    <span class="pill-badge pill-neutral mono">
                      <span class="i18n-en">Complete Reference Guide (Full Wiki)</span>
                      <span class="i18n-de">Vollständiges Referenz-Kapitel (Englisch • 100 % Wiki-Inhalt)</span>
                    </span>
                  </div>
                  <div class="wk-full-body" set:html={ch.fullHtml} />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  (function () {
    var tabBtns = Array.prototype.slice.call(document.querySelectorAll('[data-wiki-tab]'));
    var articles = Array.prototype.slice.call(document.querySelectorAll('[data-wiki-article]'));
    var searchInput = document.getElementById('wiki-search-input');
    var searchCount = document.getElementById('wiki-search-count');
    var activeSlug = 'home';

    function selectChapter(slug, scrollToTop) {
      activeSlug = slug;
      if (searchInput && searchInput.value.trim()) {
        searchInput.value = '';
        if (searchCount) searchCount.hidden = true;
      }
      tabBtns.forEach(function (btn) {
        var match = btn.getAttribute('data-wiki-tab') === slug;
        btn.classList.toggle('is-active', match);
        btn.setAttribute('aria-selected', String(match));
      });
      articles.forEach(function (art) {
        art.hidden = art.getAttribute('data-wiki-article') !== slug;
      });
      if (scrollToTop) {
        var targetEl = document.getElementById('wiki-content-top');
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectChapter(btn.getAttribute('data-wiki-tab'), true);
      });
    });

    document.querySelectorAll('[data-wiki-jump]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        var t = link.getAttribute('data-wiki-jump');
        if (t) {
          e.preventDefault();
          selectChapter(t, true);
        }
      });
    });

    document.querySelectorAll('[data-copy-code]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var pre = btn.nextElementSibling;
        if (!pre) return;
        navigator.clipboard.writeText(pre.textContent || '').then(function () {
          btn.textContent = 'Copied ✓';
          setTimeout(function () {
            btn.textContent = 'Copy';
          }, 1400);
        });
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var q = searchInput.value.trim().toLowerCase();
        if (!q) {
          if (searchCount) searchCount.hidden = true;
          selectChapter(activeSlug, false);
          return;
        }
        var matches = 0;
        articles.forEach(function (art) {
          var text = (art.textContent || '').toLowerCase();
          var hit = text.indexOf(q) !== -1;
          art.hidden = !hit;
          if (hit) matches++;
        });
        tabBtns.forEach(function (btn) {
          var slug = btn.getAttribute('data-wiki-tab');
          var art = document.querySelector('[data-wiki-article="' + slug + '"]');
          btn.classList.toggle('is-active', Boolean(art && !art.hidden));
        });
        if (searchCount) {
          searchCount.hidden = false;
          searchCount.textContent = matches + ' / ' + articles.length;
        }
      });
    }
  })();
</script>

<style>
  .wiki-top {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-block-end: 28px;
  }

  .wiki-search-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    background: var(--surface-low);
    border: 1px solid var(--outline-strong);
    color: var(--text-muted);
  }

  .wiki-search-bar input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.95rem;
    outline: none;
  }

  .wiki-search-count {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .wiki-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .wiki-sidebar {
    position: sticky;
    top: calc(var(--header-height) + 18px);
    max-height: calc(100vh - var(--header-height) - 32px);
    overflow-y: auto;
  }

  .wiki-nav-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .wiki-tab-btn {
    width: 100%;
    text-align: start;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 12px;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.83rem;
    line-height: 1.3;
    transition: background-color 150ms ease-out, color 150ms ease-out;
  }

  .wiki-tab-btn.is-active {
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
    border-color: rgba(245, 158, 11, 0.35);
    font-weight: 700;
  }

