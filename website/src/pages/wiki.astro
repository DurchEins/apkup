const wikiDir = join(process.cwd(), 'src/data/wiki');
const RENDERED_CHAPTERS = CHAPTERS.map((ch) => {
  const rawMd = readFileSync(join(wikiDir, ch.mdFile), 'utf8');
  const parsed = renderFullWikiHtml(rawMd, ch.slug);
  const readMin = Math.max(1, Math.round(rawMd.trim().split(/\s+/).length / 200));
  return {
    ...ch,
    readMin,
    fullHtml: parsed.html,
    headings: parsed.headings,
  };
});
---

<BaseLayout
  title="Wiki & Guides — ApkUp"
  description="Complete 9-chapter ApkUp reference documentation covering update sources, F-Droid Index V2, PAT tokens, Shizuku & Root silent updates, Obtainium JSON import, and troubleshooting."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'ApkUp Wiki & Complete Reference Guides',
    url: 'https://durcheins.github.io/apkup/wiki/',
    author: { '@type': 'Person', name: 'DurchEins', url: 'https://github.com/DurchEins' },
    about: { '@type': 'SoftwareApplication', name: 'ApkUp' },
  }}
>
  <Navbar />
  <main id="main-content" class="section">
    <div class="container">
      <div class="wiki-top">
        <div class="section-header" style="margin-block-end: 0;">
          <h1 class="section-title">
            <span class="i18n-en">ApkUp Wiki &amp; Documentation</span>
            <span class="i18n-de">ApkUp-Wiki &amp; Anleitungen</span>
          </h1>
          <p class="section-subtitle">
            <span class="i18n-en">
              All 12 official guides in one searchable place — switch chapters on the left or
              search across every topic below.
            </span>
            <span class="i18n-de">
              <strong>Hinweis:</strong> Das vollständige Referenz-Wiki stammt direkt aus dem
              englischen GitHub-Wiki und ist daher größtenteils auf <strong>Englisch</strong>.
              Die Kapitel-Übersichten, Kurzanleitungen, Tabellen und wichtigsten Erklärungen oben
              in jedem Kapitel sind vollständig auf <strong>Deutsch</strong> aufbereitet – wähle
              links ein Thema oder durchsuche alle 12 Kapitel live.
            </span>
          </p>
        </div>
      </div>

      <div class="wiki-search-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <input
          type="search"
          id="wiki-search-input"
          placeholder="Search all 12 guides (e.g. Shizuku, 24h, SHA-256, Cloudflare, 403, Obtainium)…"
          data-placeholder-en="Search all 12 guides (e.g. Shizuku, 24h, SHA-256, Cloudflare, 403, Obtainium)…"
          data-placeholder-de="Alle 12 Anleitungen durchsuchen (englische Begriffe bevorzugt, z. B. Shizuku, 24h, Rollback, Verification, Token)…"
          aria-label="Search wiki guides"
        />
        <span class="wiki-search-count mono" id="wiki-search-count" aria-live="polite" hidden></span>
        <div class="wiki-search-nav" id="wiki-search-nav" hidden>
          <button type="button" id="wiki-search-prev" aria-label="Previous match" title="Previous (Shift+Enter)">▲</button>
          <button type="button" id="wiki-search-next" aria-label="Next match" title="Next (Enter)">▼</button>
        </div>
      </div>

      <div class="wiki-layout">
        <aside class="wiki-sidebar" aria-label="Wiki chapters">
          <button
            type="button"
            class="wiki-mobile-toc-btn"
            id="wiki-mobile-toc-btn"
            aria-expanded="false"
            aria-controls="wiki-nav-card"
          >
            <span>
              <span class="i18n-en">Table of Contents (10 Chapters)</span>
              <span class="i18n-de">Inhaltsverzeichnis (10 Kapitel)</span>
            </span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </button>
          <nav id="wiki-nav-card" class="wiki-nav-card" aria-label="Wiki table of contents">
            {
              RENDERED_CHAPTERS.map((ch, idx) => (
                <details class="wiki-nav-group" data-wiki-group={ch.slug} open={idx === 0}>
                  <summary class={`wiki-tab-btn ${idx === 0 ? 'is-active' : ''}`} data-wiki-tab={ch.slug}>
                    <a href={`#doc-${ch.slug}`} class="wiki-tab-link" data-wiki-chapter-link={ch.slug}>
                      <span class="wiki-tab-title">
                        <span class="i18n-en">{ch.enTitle}</span>
                        <span class="i18n-de">{ch.deTitle}</span>
                      </span>
                    </a>
                    <span class="wiki-tab-right">
                      <span class="wiki-tab-tag mono">{ch.tag}</span>
                      <svg class="wiki-nav-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </span>
                  </summary>
                  {ch.headings.length > 0 && (
                    <ul class="wiki-subnav">
                      {ch.headings.map((h) => (
                        <li class={h.level === 2 ? 'is-l2' : 'is-l3'}>
                          <a href={`#${h.id}`} data-wiki-sub={h.id}>
                            {h.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </details>
              ))
            }
          </nav>
        </aside>

        <div class="wiki-content" id="wiki-content-top">
          {
            RENDERED_CHAPTERS.map((ch) => (
              <article
                class="wiki-chapter-card"
                id={`doc-${ch.slug}`}
                data-wiki-article={ch.slug}
              >
                <div class="wiki-chapter-top">
                  <span class="pill-badge pill-amber mono">{ch.tag}</span>
                  <span class="pill-badge pill-neutral mono">
                    <span class="i18n-en">~{ch.readMin} min read</span>
                    <span class="i18n-de">~{ch.readMin} Min. Lesezeit</span>
                  </span>
                </div>

                <h2 class="wiki-chapter-title">
                  <span class="i18n-en">{ch.enTitle}</span>
                  <span class="i18n-de">{ch.deTitle}</span>
                </h2>

                <p class="wiki-chapter-lead">
                  <span class="i18n-en">{ch.enLead}</span>
                  <span class="i18n-de">{ch.deLead}</span>
                </p>

                {ch.cards && ch.cards.length > 0 && (
                  <div class="wiki-cards-grid">
                    {ch.cards.map((c) => (
                      <div class="wiki-subcard has-spotlight">
                        {c.badge && <span class="pill-badge pill-neutral mono">{c.badge}</span>}
                        <h3>
                          <span class="i18n-en">{c.enTitle}</span>
                          <span class="i18n-de">{c.deTitle}</span>
                        </h3>
                        <p>
                          <span class="i18n-en">{c.enBody}</span>
                          <span class="i18n-de">{c.deBody}</span>
                        </p>
                      </div>
                    ))}
                  </div>
                )}

                {ch.steps && ch.steps.length > 0 && (
                  <div class="wiki-steps-block">
                    {ch.stepsTitleEn && (
                      <h3 class="wiki-block-heading">
                        <span class="i18n-en">{ch.stepsTitleEn}</span>
                        <span class="i18n-de">{ch.stepsTitleDe}</span>
                      </h3>
                    )}
                    <ol class="wiki-steps-list">
                      {ch.steps.map((s, sIdx) => (
                        <li>
                          <span class="wiki-step-num mono">0{sIdx + 1}</span>
                          <div>
                            <h4>
                              <span class="i18n-en">{s.enTitle}</span>
                              <span class="i18n-de">{s.deTitle}</span>
                            </h4>
                            <p>
                              <span class="i18n-en">{s.enBody}</span>
                              <span class="i18n-de">{s.deBody}</span>
                            </p>
                          </div>
                        </li>
                      ))}
                    </ol>
                  </div>
                )}

                {ch.tableHeaders && ch.tableRows && (
                  <div class="wiki-table-wrap">
                    <table class="wiki-table">
                      <thead>
                        <tr>
                          <th>{ch.tableHeaders.h1}</th>
                          <th>
                            <span class="i18n-en">{ch.tableHeaders.h2En}</span>
                            <span class="i18n-de">{ch.tableHeaders.h2De}</span>
                          </th>
                          <th>
                            <span class="i18n-en">{ch.tableHeaders.h3En}</span>
                            <span class="i18n-de">{ch.tableHeaders.h3De}</span>
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {ch.tableRows.map((r) => (
                          <tr>
                            <td class="mono"><strong>{r.col1}</strong></td>
                            <td>
                              <span class="i18n-en">{r.col2En}</span>
                              <span class="i18n-de">{r.col2De}</span>
                            </td>
                            <td>
                              <span class="i18n-en">{r.col3En}</span>
                              <span class="i18n-de">{r.col3De}</span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                {ch.deepDives && ch.deepDives.length > 0 && (
                  <div class="wiki-deep-list">
                    {ch.deepDives.map((d) => (
                      <details class="wiki-deep-item" open>
                        <summary>
                          <span>
                            <span class="i18n-en">{d.qEn}</span>
                            <span class="i18n-de">{d.qDe}</span>
                          </span>
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="m6 9 6 6 6-6" />
                          </svg>
                        </summary>
                        <p>
                          <span class="i18n-en">{d.aEn}</span>
                          <span class="i18n-de">{d.aDe}</span>
                        </p>
                      </details>
                    ))}
                  </div>
                )}
                <div class="wk-full-section">
                  <div class="wk-full-divider">
                    <span class="pill-badge pill-neutral mono">
                      <span class="i18n-en">Complete Reference Guide (Full Wiki)</span>
                      <span class="i18n-de">Vollständiges Referenz-Kapitel (Englisch • 100 % Wiki-Inhalt)</span>
                    </span>
                  </div>
                  <div class="wk-full-body" set:html={ch.fullHtml} />
                </div>
              </article>
            ))
          }

          <div class="wiki-gh-footer-card">
            <div>
              <strong>
                <span class="i18n-en">Original GitHub Wiki</span>
                <span class="i18n-de">Originales GitHub-Wiki</span>
              </strong>
              <p>
                <span class="i18n-en">Prefer viewing or editing the raw Markdown pages directly on GitHub?</span>
                <span class="i18n-de">Möchtest du die Markdown-Seiten direkt auf GitHub ansehen oder mitbearbeiten?</span>
              </p>
            </div>
            <a
              class="btn btn-secondary"
              href={SITE.wikiUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="i18n-en">Open GitHub Wiki ↗</span>
              <span class="i18n-de">GitHub-Wiki öffnen ↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script is:inline define:vars={{ wikiSynonyms: WIKI_SYNONYMS }}>
  (function () {
    var tabLinks = Array.prototype.slice.call(document.querySelectorAll('[data-wiki-tab]'));
    var navGroups = Array.prototype.slice.call(document.querySelectorAll('[data-wiki-group]'));
    var articles = Array.prototype.slice.call(document.querySelectorAll('[data-wiki-article]'));
    var searchInput = document.getElementById('wiki-search-input');
    var searchCount = document.getElementById('wiki-search-count');

    function setActiveNav(slug, autoExpand) {
      tabLinks.forEach(function (link) {
        link.classList.toggle('is-active', link.getAttribute('data-wiki-tab') === slug);
      });
      if (autoExpand) {
        navGroups.forEach(function (grp) {
          grp.open = grp.getAttribute('data-wiki-group') === slug;
        });
      }
    }

    var mobileTocBtn = document.getElementById('wiki-mobile-toc-btn');
    var sidebarEl = document.querySelector('.wiki-sidebar');

    if (mobileTocBtn && sidebarEl) {
      mobileTocBtn.addEventListener('click', function () {
        var open = sidebarEl.classList.toggle('is-mobile-open');
        mobileTocBtn.setAttribute('aria-expanded', String(open));
      });
    }

    document.querySelectorAll('[data-wiki-chapter-link]').forEach(function (link) {
      link.addEventListener('click', function () {
        var slug = link.getAttribute('data-wiki-chapter-link');
        if (slug) setActiveNav(slug, true);
        if (sidebarEl && mobileTocBtn) {
          sidebarEl.classList.remove('is-mobile-open');
          mobileTocBtn.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.querySelectorAll('[data-wiki-sub]').forEach(function (subLink) {
      subLink.addEventListener('click', function () {
        var targetId = subLink.getAttribute('data-wiki-sub');
        var target = targetId ? document.getElementById(targetId) : null;
        if (target && target.tagName === 'DETAILS') {
          target.open = true;
        }
        if (sidebarEl && mobileTocBtn) {
          sidebarEl.classList.remove('is-mobile-open');
          mobileTocBtn.setAttribute('aria-expanded', 'false');
        }
      });
    });

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var slug = entry.target.getAttribute('data-wiki-article');
              if (slug) setActiveNav(slug, true);
            }
          });
        },
        { rootMargin: '-20% 0px -65% 0px' }
      );
      articles.forEach(function (art) {
        observer.observe(art);
      });
    }

    document.querySelectorAll('[data-copy-code]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var pre = btn.nextElementSibling;
        if (!pre) return;
        navigator.clipboard.writeText(pre.textContent || '').then(function () {
          btn.textContent = 'Copied ✓';
          btn.classList.add('is-copied');
          setTimeout(function () {
            btn.textContent = 'Copy';
            btn.classList.remove('is-copied');
          }, 1400);
        });
      });
    });

    function syncSearchPlaceholder() {
      if (!searchInput) return;
      var isDe = document.documentElement.getAttribute('data-lang') === 'de';
      var next = searchInput.getAttribute(isDe ? 'data-placeholder-de' : 'data-placeholder-en');
      if (next) searchInput.setAttribute('placeholder', next);
    }

    function expandToken(token) {
      var terms = [token];
      if (wikiSynonyms && wikiSynonyms[token]) {
        terms = terms.concat(wikiSynonyms[token]);
      } else if (wikiSynonyms && token.length >= 4) {
        Object.keys(wikiSynonyms).forEach(function (k) {
          if (k.indexOf(token) === 0 || token.indexOf(k) === 0) {
            terms = terms.concat(wikiSynonyms[k]);
          }
        });
      }
      return terms;
    }

    var searchNav = document.getElementById('wiki-search-nav');
    var prevBtn = document.getElementById('wiki-search-prev');
    var nextBtn = document.getElementById('wiki-search-next');
    var hits = [];
    var currentHit = -1;

    function escapeRegex(str) {
      return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function clearSidebarSearchState() {
      document.querySelectorAll('.wk-nav-badge').forEach(function (b) {
        b.remove();
      });
      navGroups.forEach(function (grp) {
        grp.classList.remove('has-search-hits', 'no-search-hits');
      });
      document.querySelectorAll('[data-wiki-sub]').forEach(function (a) {
        a.classList.remove('has-search-hits', 'no-search-hits', 'is-search-active-sub');
      });
    }

    function clearHighlights() {
      document.querySelectorAll('mark.wk-hit').forEach(function (mark) {
        var parent = mark.parentNode;
        if (!parent) return;
        parent.replaceChild(document.createTextNode(mark.textContent || ''), mark);
        parent.normalize();
      });
      hits = [];
      currentHit = -1;
      clearSidebarSearchState();
    }

    function findHitContext(mark) {
      var art = mark.closest('[data-wiki-article]');
      var slug = art ? art.getAttribute('data-wiki-article') : '';
      var subId = '';
      if (art) {
        var headings = art.querySelectorAll('.wk-full-body h2[id], .wk-full-body h3[id], .wk-full-body details[id]');
        for (var i = 0; i < headings.length; i++) {
          var h = headings[i];
          if (h === mark || h.contains(mark) || (h.compareDocumentPosition(mark) & Node.DOCUMENT_POSITION_FOLLOWING)) {
            subId = h.id || '';
          } else {
            break;
          }
        }
      }
      return { slug: slug, subId: subId };
    }

    function updateSidebarSearchState() {
      clearSidebarSearchState();
      if (hits.length === 0) return;
      var chapCounts = {};
      var subCounts = {};
      hits.forEach(function (m) {
        var ctx = findHitContext(m);
        if (ctx.slug) chapCounts[ctx.slug] = (chapCounts[ctx.slug] || 0) + 1;
        if (ctx.subId) subCounts[ctx.subId] = (subCounts[ctx.subId] || 0) + 1;
      });

      navGroups.forEach(function (grp) {
        var slug = grp.getAttribute('data-wiki-group') || '';
        var count = chapCounts[slug] || 0;
        var right = grp.querySelector('.wiki-tab-right');
        if (count > 0) {
          grp.classList.add('has-search-hits');
          grp.open = true;
          if (right) {
            var badge = document.createElement('span');
            badge.className = 'wk-nav-badge mono';
            badge.textContent = String(count);
            right.insertBefore(badge, right.firstChild);
          }
        } else {
          grp.classList.add('no-search-hits');
          grp.open = false;
        }
      });

      document.querySelectorAll('[data-wiki-sub]').forEach(function (a) {
        var id = a.getAttribute('data-wiki-sub') || '';
        var count = subCounts[id] || 0;
        if (count > 0) {
          a.classList.add('has-search-hits');
          var badge = document.createElement('span');
          badge.className = 'wk-nav-badge is-sub mono';
          badge.textContent = String(count);
          a.appendChild(badge);
        } else {
          a.classList.add('no-search-hits');
        }
      });
    }

    function isNodeVisible(node) {
      var el = node.parentElement;
      while (el && el !== document.body) {
        var style = window.getComputedStyle(el);
        if (style.display === 'none' || style.visibility === 'hidden') return false;
        el = el.parentElement;
      }
      return true;
    }

    function highlightTerms(terms) {
      var unique = [];
      var seen = {};
      terms.forEach(function (t) {
        var clean = (t || '').trim().toLowerCase();
        if (clean.length >= 2 && !seen[clean]) {
          seen[clean] = true;
          unique.push(clean);
        }
      });
      if (unique.length === 0) return;
      unique.sort(function (a, b) { return b.length - a.length; });
      var regex = new RegExp('(' + unique.map(escapeRegex).join('|') + ')', 'gi');
      var container = document.querySelector('.wiki-content');
      if (!container) return;

      var textNodes = [];
      var walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, {
        acceptNode: function (node) {
          var p = node.parentElement;
          if (!p) return NodeFilter.FILTER_REJECT;
          var tag = p.tagName;
          if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'BUTTON' || tag === 'MARK') {
            return NodeFilter.FILTER_REJECT;
          }
          if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
          if (!isNodeVisible(node)) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        },
      });
      var n;
      while ((n = walker.nextNode())) {
        textNodes.push(n);
      }

      textNodes.forEach(function (node) {
        var val = node.nodeValue || '';
        regex.lastIndex = 0;
        if (!regex.test(val)) return;
        regex.lastIndex = 0;
        var frag = document.createDocumentFragment();
        var lastIdx = 0;
        var m;
        while ((m = regex.exec(val)) !== null) {
          if (m.index > lastIdx) {
            frag.appendChild(document.createTextNode(val.slice(lastIdx, m.index)));
          }
          var mark = document.createElement('mark');
          mark.className = 'wk-hit';
          mark.textContent = m[0];
          frag.appendChild(mark);
          hits.push(mark);
          lastIdx = m.index + m[0].length;
        }
        if (lastIdx < val.length) {
          frag.appendChild(document.createTextNode(val.slice(lastIdx)));
        }
        if (node.parentNode) node.parentNode.replaceChild(frag, node);
      });
    }

    function jumpToHit(index) {
      if (hits.length === 0) {
        if (searchCount) searchCount.textContent = '0 / 0';
        return;
      }
      if (currentHit >= 0 && hits[currentHit]) {
        hits[currentHit].classList.remove('is-current');
      }
      currentHit = ((index % hits.length) + hits.length) % hits.length;
      var target = hits[currentHit];
      // Auto-open any collapsed <details> ancestor (e.g., FAQ items)
      var el = target.parentElement;
      while (el) {
        if (el.tagName === 'DETAILS') el.open = true;
        el = el.parentElement;
      }
      target.classList.add('is-current');
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });

      document.querySelectorAll('[data-wiki-sub].is-search-active-sub').forEach(function (a) {
        a.classList.remove('is-search-active-sub');
      });
      var ctx = findHitContext(target);
      if (ctx.slug) setActiveNav(ctx.slug, false);
      if (ctx.subId) {
        var subEl = document.querySelector('[data-wiki-sub="' + ctx.subId + '"]');
        if (subEl) {
          subEl.classList.add('is-search-active-sub');
          subEl.scrollIntoView({ block: 'nearest' });
        }
      }

      if (searchCount) {
        searchCount.textContent = currentHit + 1 + ' / ' + hits.length;
      }
    }

    function runWikiSearch(jumpFirst) {
      if (!searchInput) return;
      var q = searchInput.value.trim().toLowerCase();
      clearHighlights();
      if (!q || q.length < 2) {
        if (searchCount) searchCount.hidden = true;
        if (searchNav) searchNav.hidden = true;
        return;
      }
      var tokens = q.split(/\s+/).filter(Boolean);
      var allTerms = [];
      tokens.forEach(function (t) {
        allTerms = allTerms.concat(expandToken(t));
      });
      highlightTerms(allTerms);
      updateSidebarSearchState();
      if (searchCount) searchCount.hidden = false;
      if (searchNav) searchNav.hidden = hits.length === 0;
      if (hits.length > 0) {
        if (jumpFirst) {
          jumpToHit(0);
        } else {
          currentHit = 0;
          hits[0].classList.add('is-current');
          if (searchCount) searchCount.textContent = '1 / ' + hits.length;
        }
      } else if (searchCount) {
        searchCount.textContent = '0 / 0';
      }
    }

    if (searchInput) {
      syncSearchPlaceholder();
      window.addEventListener('apkup:langchange', function () {
        syncSearchPlaceholder();
        if (searchInput.value.trim().length >= 2) runWikiSearch(false);
      });

      var debounceTimer = null;
      searchInput.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
          runWikiSearch(true);
        }, 120);
      });

      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          if (hits.length > 0) jumpToHit(currentHit + (e.shiftKey ? -1 : 1));
        } else if (e.key === 'Escape') {
          searchInput.value = '';
          runWikiSearch(false);
        }
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          if (hits.length > 0) jumpToHit(currentHit - 1);
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          if (hits.length > 0) jumpToHit(currentHit + 1);
        });
      }
    }
  })();
</script>

