---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/content';

interface WikiDocMeta {
  slug: string;
  file: string;
  titleEn: string;
  titleDe: string;
  tag: string;
}

const WIKI_DOCS: WikiDocMeta[] = [
  {
    slug: 'home',
    file: 'Home.md',
    titleEn: 'Overview & Quick Start',
    titleDe: 'Übersicht & Schnellstart',
    tag: 'Start',
  },
  {
    slug: 'sources',
    file: 'Update-Sources,-Repository-Linking-&-Signature-Protection.md',
    titleEn: 'Update Sources & Signature Protection',
    titleDe: 'Update-Quellen & Signaturschutz',
    tag: 'Core',
  },
  {
    slug: 'fdroid',
    file: 'F-Droid-&-Index-V2-Repositories.md',
    titleEn: 'F-Droid & Index V2 Repositories',
    titleDe: 'F-Droid & Index-V2-Repositories',
    tag: 'Index V2',
  },
  {
    slug: 'tokens',
    file: 'Configuring-GitHub-&-GitLab-Tokens.md',
    titleEn: 'GitHub, GitLab & Codeberg Tokens',
    titleDe: 'GitHub-, GitLab- & Codeberg-Tokens',
    tag: 'API / PAT',
  },
  {
    slug: 'shizuku-setup',
    file: 'Setting-up-Shizuku.md',
    titleEn: 'Setting up Shizuku (Quick Guide)',
    titleDe: 'Shizuku einrichten (Kurzanleitung)',
    tag: 'Shizuku',
  },
  {
    slug: 'shizuku-deep',
    file: 'Shizuku-&-Background-Installation.md',
    titleEn: 'Shizuku & Background Installation (Deep Dive)',
    titleDe: 'Shizuku & Hintergrund-Installation (Detail-Guide)',
    tag: 'Shizuku + su',
  },
