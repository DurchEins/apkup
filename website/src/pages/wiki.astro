    titleEn: 'Troubleshooting Source Errors',
    titleDe: 'Fehlerbehebung bei Quellen-Fehlern',
    tag: 'Help',
  },
];

const SLUG_BY_WIKI_NAME: Record<string, string> = {
  Home: 'home',
  'Update-Sources,-Repository-Linking-&-Signature-Protection': 'sources',
  'F-Droid-&-Index-V2-Repositories': 'fdroid',
  'Configuring-GitHub-&-GitLab-Tokens': 'tokens',
  'Setting-up-Shizuku': 'shizuku-setup',
  'Shizuku-&-Background-Installation': 'shizuku-deep',
  'Obtainium-Migration-&-Sync-Guide': 'obtainium',
  'App-Management,-Filters,-Background-Checks-&-Backup': 'management',
  'Troubleshooting-Source-Errors': 'troubleshooting',
};

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function slugifyHeading(text: string): string {
  return text
    .toLowerCase()
    .replace(/[`*_~()[\]{}:.!?,/\\+]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}

function formatInline(raw: string): string {
  let s = escapeHtml(raw);
  // Inline code
  s = s.replace(/`([^`]+)`/g, '<code class="wiki-inline-code mono">$1</code>');
  // Bold + italic
  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
  // Links
  s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m, label, url) => {
    const wikiMatch = url.match(/github\.com\/DurchEins\/apkup\/wiki\/([^#?]+)(#.*)?/i);
    if (wikiMatch) {
      const targetSlug = SLUG_BY_WIKI_NAME[wikiMatch[1]] || '';
      if (targetSlug) {
        return `<a href="#doc-${targetSlug}" data-wiki-jump="${targetSlug}" class="wiki-internal-link">${label}</a>`;
      }
    }
    if (url.startsWith('#')) {
      return `<a href="${url}" class="wiki-anchor-link">${label}</a>`;
    }
    return `<a href="${url}" target="_blank" rel="noopener noreferrer">${label}</a>`;
  });
  return s;
}

function renderMarkdown(md: string): string {
  const lines = md.split(/\r?\n/);
  const out: string[] = [];
  let inCode = false;
  let codeLang = '';
  let codeBuf: string[] = [];
  let inUl = false;
  let inOl = false;
  let inTable = false;
  let tableRows: string[][] = [];
  let inQuote = false;
  let quoteBuf: string[] = [];

  function flushLists() {
    if (inUl) {
      out.push('</ul>');
      inUl = false;
    }
    if (inOl) {
      out.push('</ol>');
      inOl = false;
    }
  }

  function flushTable() {
    if (!inTable) return;
    inTable = false;
    if (tableRows.length === 0) return;
    const header = tableRows[0];
    const body = tableRows.slice(1).filter((r) => !r.every((c) => /^[-:\s]+$/.test(c)));
    let html = '<div class="wiki-table-wrap"><table class="wiki-table"><thead><tr>';
    for (const h of header) html += `<th>${formatInline(h)}</th>`;
    html += '</tr></thead><tbody>';
    for (const row of body) {
      html += '<tr>';
      for (const cell of row) html += `<td>${formatInline(cell)}</td>`;
      html += '</tr>';
    }
    html += '</tbody></table></div>';
    out.push(html);
    tableRows = [];
  }

  function flushQuote() {
    if (!inQuote) return;
    inQuote = false;
    const joined = quoteBuf.join(' ').trim();
    const alertMatch = joined.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*(.*)$/i);
    if (alertMatch) {
      const kind = alertMatch[1].toUpperCase();
      out.push(
        `<div class="wiki-callout wiki-callout-${kind.toLowerCase()}"><strong class="mono">${kind}</strong><p>${formatInline(alertMatch[2])}</p></div>`
      );
    } else {
      out.push(`<blockquote class="wiki-quote"><p>${formatInline(joined)}</p></blockquote>`);
    }
    quoteBuf = [];
  }

  for (const rawLine of lines) {
    const line = rawLine.trimEnd();

    if (line.startsWith('```')) {
      flushLists();
      flushTable();
      flushQuote();
      if (!inCode) {
        inCode = true;
        codeLang = line.slice(3).trim();
        codeBuf = [];
      } else {
        inCode = false;
        out.push(
          `<pre class="wiki-pre mono"><code data-lang="${escapeHtml(codeLang)}">${escapeHtml(
            codeBuf.join('\n')
          )}</code></pre>`
        );
      }
      continue;
    }

    if (inCode) {
      codeBuf.push(rawLine);
      continue;
    }

    if (line.startsWith('|') && line.endsWith('|')) {
      flushLists();
      flushQuote();
      inTable = true;
      const cells = line
        .slice(1, -1)
        .split('|')
        .map((c) => c.trim());
      tableRows.push(cells);
      continue;
    } else if (inTable) {
      flushTable();
    }

    if (line.startsWith('>')) {
      flushLists();
      inQuote = true;
      quoteBuf.push(line.replace(/^>\s?/, ''));
      continue;
    } else if (inQuote) {
      flushQuote();
    }

    if (!line.trim()) {
      flushLists();
      continue;
    }

    if (/^---+$/.test(line.trim())) {
      flushLists();
      out.push('<hr class="wiki-hr" />');
      continue;
    }

    const hMatch = line.match(/^(#{1,4})\s+(.*)$/);
    if (hMatch) {
      flushLists();
      const level = Math.min(4, hMatch[1].length + 1); // shift # -> h2, ## -> h3
      const text = hMatch[2].trim();
      const id = slugifyHeading(text);
      out.push(`<h${level} id="${id}" class="wiki-h${level}">${formatInline(text)}</h${level}>`);
      continue;
    }

    const ulMatch = line.match(/^\s*[-*]\s+(.*)$/);
    if (ulMatch) {
      if (inOl) {
        out.push('</ol>');
        inOl = false;
      }
      if (!inUl) {
        out.push('<ul class="wiki-ul">');
        inUl = true;
      }
      out.push(`<li>${formatInline(ulMatch[1])}</li>`);
      continue;
    }

    const olMatch = line.match(/^\s*\d+\.\s+(.*)$/);
    if (olMatch) {
      if (inUl) {
        out.push('</ul>');
        inUl = false;
      }
      if (!inOl) {
        out.push('<ol class="wiki-ol">');
        inOl = true;
      }
      out.push(`<li>${formatInline(olMatch[1])}</li>`);
      continue;
    }

    flushLists();
    out.push(`<p class="wiki-p">${formatInline(line.trim())}</p>`);
  }

  flushLists();
  flushTable();
  flushQuote();
  return out.join('\n');
}

const wikiDir = join(process.cwd(), 'src/data/wiki');
const renderedDocs = WIKI_DOCS.map((doc) => {
  const md = readFileSync(join(wikiDir, doc.file), 'utf8');
  return {
    ...doc,
    html: renderMarkdown(md),
  };
});
---

<BaseLayout title="Complete Wiki & Guides — ApkUp">
  <Navbar />
  <main id="main-content" class="section">
    <div class="container">
      <div class="wiki-top">
        <div class="section-header" style="margin-block-end: 0;">
          <h1 class="section-title">
            <span class="i18n-en">ApkUp Wiki &amp; Complete Documentation</span>
            <span class="i18n-de">Vollständiges ApkUp-Wiki &amp; Dokumentation</span>
          </h1>
          <p class="section-subtitle">
            <span class="i18n-en">
              All 9 official wiki chapters natively on the website — search across every guide or
              pick a chapter on the left.
            </span>
            <span class="i18n-de">
              Alle 9 offiziellen Wiki-Kapitel komplett nativ auf der Website – durchsuche alle
              Anleitungen live oder wähle links ein Kapitel.
            </span>
          </p>
        </div>

        <div class="wiki-search-bar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
          <input
            type="search"
            id="wiki-search-input"
            placeholder="Search all 9 guides (e.g. Shizuku, Cloudflare, 403, TOFU, Obtainium, Rollback)…"
            aria-label="Search wiki guides"
          />
          <span class="wiki-search-count mono" id="wiki-search-count" hidden></span>
        </div>
      </div>

      <div class="wiki-layout">
        <aside class="wiki-sidebar" aria-label="Wiki chapters">
          <div class="wiki-nav-card" role="tablist" aria-orientation="vertical">
            {
              renderedDocs.map((doc, idx) => (
                <button
                  type="button"
                  role="tab"
                  class={`wiki-tab-btn ${idx === 0 ? 'is-active' : ''}`}
                  data-wiki-tab={doc.slug}
                  aria-selected={idx === 0 ? 'true' : 'false'}
                >
                  <span class="wiki-tab-title">
                    <span class="i18n-en">{doc.titleEn}</span>
                    <span class="i18n-de">{doc.titleDe}</span>
                  </span>
                  <span class="wiki-tab-tag mono">{doc.tag}</span>
                </button>
              ))
            }
          </div>
        </aside>

        <div class="wiki-content" id="wiki-articles-host">
          {
            renderedDocs.map((doc, idx) => (
              <article
                class="wiki-article-card"
                id={`doc-${doc.slug}`}
                data-wiki-article={doc.slug}
                hidden={idx !== 0}
              >
                <div class="wiki-article-meta">
                  <span class="pill-badge pill-amber mono">{doc.tag}</span>
                  <a
                    class="wiki-gh-link mono"
                    href={`${SITE.wikiUrl}/${doc.file.replace(/\.md$/, '')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    GitHub Wiki ↗
                  </a>
                </div>
                <div class="wiki-prose" set:html={doc.html} />
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  (function () {
    var tabBtns = Array.prototype.slice.call(document.querySelectorAll('[data-wiki-tab]'));
    var articles = Array.prototype.slice.call(document.querySelectorAll('[data-wiki-article]'));
    var searchInput = document.getElementById('wiki-search-input');
    var searchCount = document.getElementById('wiki-search-count');
    var activeSlug = 'home';

    function selectChapter(slug, scrollToTop) {
      activeSlug = slug;
      if (searchInput && searchInput.value.trim()) {
        searchInput.value = '';
        if (searchCount) searchCount.hidden = true;
      }
      tabBtns.forEach(function (btn) {
        var match = btn.getAttribute('data-wiki-tab') === slug;
        btn.classList.toggle('is-active', match);
        btn.setAttribute('aria-selected', String(match));
      });
      articles.forEach(function (art) {
        art.hidden = art.getAttribute('data-wiki-article') !== slug;
      });
      if (scrollToTop) {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectChapter(btn.getAttribute('data-wiki-tab'), true);
      });
    });

    document.querySelectorAll('[data-wiki-jump]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        var target = link.getAttribute('data-wiki-jump');
        if (target) {
          e.preventDefault();
          selectChapter(target, true);
        }
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var q = searchInput.value.trim().toLowerCase();
        if (!q) {
          if (searchCount) searchCount.hidden = true;
          selectChapter(activeSlug, false);
          return;
        }
        var matches = 0;
        articles.forEach(function (art) {
          var text = (art.textContent || '').toLowerCase();
          var hit = text.indexOf(q) !== -1;
          art.hidden = !hit;
          if (hit) matches++;
        });
        tabBtns.forEach(function (btn) {
          var slug = btn.getAttribute('data-wiki-tab');
          var art = document.querySelector('[data-wiki-article="' + slug + '"]');
          btn.classList.toggle('is-active', Boolean(art && !art.hidden));
        });
        if (searchCount) {
          searchCount.hidden = false;
          searchCount.textContent = matches + ' / ' + articles.length;
        }
      });
    }
  })();
</script>

<style>
  .wiki-top {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-block-end: 28px;
  }

  .wiki-search-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    background: var(--surface-low);
    border: 1px solid var(--outline-strong);
    color: var(--text-muted);
  }

  .wiki-search-bar input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.96rem;
    outline: none;
  }

  .wiki-search-count {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .wiki-layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .wiki-nav-card {
    position: sticky;
    top: calc(var(--header-height) + 18px);
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .wiki-tab-btn {
    width: 100%;
    text-align: start;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 14px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.88rem;
    transition: background-color 150ms ease-out, color 150ms ease-out;
  }

  .wiki-tab-btn.is-active {
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
    border-color: rgba(245, 158, 11, 0.35);
    font-weight: 700;
  }

  @media (hover: hover) {
    .wiki-tab-btn:not(.is-active):hover {
      background: var(--surface);
      color: var(--text);
    }
  }

  .wiki-tab-tag {
    font-size: 0.7rem;
    padding: 2px 7px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .wiki-content {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }

  .wiki-article-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3.5vw, 36px);
  }

  .wiki-article-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-block-end: 18px;
  }

  .wiki-gh-link {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .wiki-prose .wiki-h2 {
    margin: 0 0 14px;
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .wiki-prose .wiki-h3 {
    margin: 28px 0 10px;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text);
  }

  .wiki-prose .wiki-h4 {
    margin: 20px 0 8px;
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--accent);
  }

  .wiki-prose .wiki-p {
    margin: 0 0 14px;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .wiki-prose .wiki-ul,
  .wiki-prose .wiki-ol {
    margin: 0 0 16px;
    padding-inline-start: 22px;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 7px;
    line-height: 1.6;
  }

  .wiki-prose strong {
    color: var(--text);
  }

  .wiki-prose a {
    color: var(--accent);
  }

  .wiki-prose .wiki-inline-code {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface);
    color: var(--accent);
    font-size: 0.84em;
  }

  .wiki-prose .wiki-pre {
    margin: 0 0 16px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--bg);
    border: 1px solid var(--outline);
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .wiki-prose .wiki-table-wrap {
    overflow-x: auto;
    margin: 0 0 18px;
  }

  .wiki-prose .wiki-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .wiki-prose .wiki-table th,
  .wiki-prose .wiki-table td {
    padding: 10px 12px;
    border-block-end: 1px solid var(--outline);
    text-align: start;
  }

  .wiki-prose .wiki-table th {
    color: var(--text);
    font-weight: 700;
    background: var(--surface);
  }

  .wiki-prose .wiki-callout,
  .wiki-prose .wiki-quote {
    margin: 0 0 16px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--bg);
    border: 1px solid var(--outline-strong);
  }

  .wiki-prose .wiki-callout strong {
    display: block;
    font-size: 0.76rem;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .wiki-prose .wiki-callout p,
  .wiki-prose .wiki-quote p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .wiki-prose .wiki-hr {
    border: none;
    border-block-start: 1px solid var(--outline);
    margin-block: 24px;
  }

  @media (max-width: 920px) {
    .wiki-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .wiki-nav-card {
      position: static;
    }
  }
</style>
