---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getBaseUrl } from '../utils/site';

const base = getBaseUrl();

const guideSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'How to Install Unknown Apps (APKs) on Android 10–17 — ApkUp Guide',
  url: 'https://durcheins.github.io/apkup/sideloading/',
  author: { '@type': 'Person', name: 'DurchEins', url: 'https://github.com/DurchEins' },
  about: { '@type': 'SoftwareApplication', name: 'ApkUp' },
};
---

<BaseLayout
  title="Install Unknown Apps (APK Sideloading) — ApkUp"
  description="Step-by-step guide to enabling Install Unknown Apps on Android 10–17, using Shizuku or ADB for silent updates, and handling Google’s 24-hour verification lock."
  jsonLd={guideSchema}
  kaoBannerSize="normal"
>
  <Navbar />
  <main id="main-content" class="section">
    <div class="container subpage-wrap">
      <header class="sl-header">
        <span class="pill-badge pill-green mono">Android 10 – 17 • Sideloading Guide</span>
        <h1 class="section-title">
          <span class="i18n-en">Installing Unknown Apps on Android</span>
          <span class="i18n-de">Unbekannte Apps auf Android installieren</span>
        </h1>
        <p class="section-subtitle">
          <span class="i18n-en">
            How to enable Android’s “Install unknown apps” permission in 30 seconds — or use
            Shizuku, ADB, or Root for silent background updates.
          </span>
          <span class="i18n-de">
            So aktivierst du die Berechtigung „Unbekannte Apps installieren“ in 30 Sekunden – oder
            nutzt optional Shizuku, ADB bzw. Root für lautlose Hintergrund-Updates.
          </span>
        </p>
      </header>

      <!-- Way 1: Standard Android Flow -->
      <section class="sl-card has-spotlight" aria-labelledby="sl-way1">
        <div class="sl-card-head">
          <span class="pill-badge pill-green mono">
            <span class="i18n-en">Standard Android • 30 Seconds</span>
            <span class="i18n-de">Standard-Android • 30 Sek.</span>
          </span>
          <h2 id="sl-way1">
            <span class="i18n-en">Classic “Install Unknown Apps” Permission</span>
            <span class="i18n-de">Klassische Berechtigung „Unbekannte Apps installieren“</span>
          </h2>
        </div>
        <ol class="sl-steps">
          <li>
            <span class="sl-num mono">01</span>
            <div>
              <strong class="sl-step-title">
                <span class="i18n-en">Download &amp; open the latest signed APK</span>
                <span class="i18n-de">Neueste signierte APK herunterladen &amp; antippen</span>
              </strong>
              <p>
                <span class="i18n-en">
                  Download the latest signed .apk(<strong><em>Up</em></strong>) file via our{' '}
                  <a href={`${base}downloads/`}>Downloads page</a> or GitHub Releases and tap the
                  file in your browser or file manager.
                </span>
                <span class="i18n-de">
                  Lade die neueste signierte .apk(<strong><em>Up</em></strong>)-Datei über unsere{' '}
                  <a href={`${base}downloads/`}>Downloads-Seite</a> oder GitHub Releases herunter
                  und tippe die Datei im Browser oder Dateimanager an.
                </span>
              </p>
            </div>
          </li>
          <li>
            <span class="sl-num mono">02</span>
            <div>
              <strong class="sl-step-title">
                <span class="i18n-en">Enable “Allow from this source”</span>
                <span class="i18n-de">„Aus dieser Quelle zulassen“ aktivieren</span>
              </strong>
              <p>
                <span class="i18n-en">
                  When Android prompts you, tap <strong>Settings</strong>, switch on{' '}
                  <strong>Allow from this source</strong> for your browser, and tap{' '}
                  <strong>Install</strong>.
                </span>
                <span class="i18n-de">
                  Tippe im Android-Hinweis auf <strong>Einstellungen</strong>, aktiviere{' '}
                  <strong>Aus dieser Quelle zulassen</strong> für deinen Browser und tippe auf{' '}
                  <strong>Installieren</strong>.
                </span>
              </p>
            </div>
          </li>
          <li>
            <span class="sl-num mono">03</span>
            <div>
              <strong class="sl-step-title">
                <span class="i18n-en">Grant permission once to ApkUp</span>
                <span class="i18n-de">Berechtigung einmalig auch für ApkUp freigeben</span>
              </strong>
              <p>
                <span class="i18n-en">
                  On your first app update inside ApkUp, grant the same permission to ApkUp once —
                  or use Shizuku/Root for completely silent background updates.
                </span>
                <span class="i18n-de">
                  Beim ersten App-Update in ApkUp gibst du dieselbe Berechtigung einmalig für ApkUp
                  frei – oder nutzt optional Shizuku/Root für lautlose Hintergrund-Updates.
                </span>
              </p>
            </div>
          </li>
        </ol>
      </section>

      <!-- Two-column Bottom: Power-User Shizuku/ADB + Google 24h Lock Subpage -->
      <div class="sl-two-col">
        <article class="sl-card has-spotlight">
          <span class="pill-badge pill-green mono">Shizuku • ADB • Root</span>
          <h2>
            <span class="i18n-en">Power-User Path via Shizuku or ADB</span>
            <span class="i18n-de">Power-User-Weg über Shizuku oder ADB</span>
          </h2>
          <p>
            <span class="i18n-en">
              Installing via <strong>Shizuku</strong> (Wireless Debugging on Android 11+),{' '}
              <code>adb install -r ApkUp.apk</code> from a PC, or <strong>Root (su)</strong> uses
              Android’s developer package installer pipeline directly.
            </span>
            <span class="i18n-de">
              Installationen über <strong>Shizuku</strong> (Kabelloses Debugging ab Android 11),{' '}
              <code>adb install -r ApkUp.apk</code> vom PC oder <strong>Root (su)</strong> nutzen
              direkt die Entwickler-Schnittstelle des Android-PackageInstallers.
            </span>
          </p>
          <div class="sl-actions">
            <a href={`${base}wiki/#doc-sideloading`} class="btn btn-secondary">
              <span class="i18n-en">General Wiki →</span>
              <span class="i18n-de">Allgemeines Wiki →</span>
            </a>
            <a href={`${base}wiki/#doc-shizuku-deep`} class="btn btn-ghost">
              <span class="i18n-en">Root →</span>
              <span class="i18n-de">Root →</span>
            </a>
            <a href={`${base}wiki/#doc-shizuku-setup`} class="btn btn-ghost">
              <span class="i18n-en">Shizuku →</span>
              <span class="i18n-de">Shizuku →</span>
            </a>
          </div>
        </article>

        <article class="sl-card sl-card-danger has-spotlight">
          <span class="pill-badge pill-danger mono">
            <span class="i18n-en">⚠ Warning • 2026 / 2027 Lock</span>
            <span class="i18n-de">⚠ Warnung • 2026 / 2027 Sperre</span>
          </span>
          <h2>
            <span class="i18n-en">Blocked by Google’s 24h Developer Lock?</span>
            <span class="i18n-de">Blockiert durch Googles 24h-Entwicklersperre?</span>
          </h2>
          <p>
            <span class="i18n-en">
              Google Play Protect is rolling out mandatory developer ID verification and a 24-hour
              Developer Options cooldown. Learn how to permanently unlock unverified APKs and why
              we support <strong>Keep Android Open</strong>.
            </span>
            <span class="i18n-de">
              Google Play Protect führt eine Ausweispflicht für Entwickler sowie eine
              24-Stunden-Sperre in den Entwickleroptionen ein. Erfahre, wie du die Sperre
              dauerhaft löst und warum wir <strong>Keep Android Open</strong> unterstützen.
            </span>
          </p>
          <div class="sl-actions">
            <a href={`${base}sideloading/google-lock/`} class="btn btn-danger">
              <span class="i18n-en">⚠ 24h Lock &amp; Keep Android Open →</span>
              <span class="i18n-de">⚠ 24h-Sperre &amp; Keep Android Open →</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
