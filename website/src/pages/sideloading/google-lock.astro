  /* 8. Table Row Status Highlight */
  .kao-table tbody tr {
    border-left: 3px solid transparent;
    transition-property: background-color, border-color;
    transition-duration: 150ms;
  }

  @media (hover: hover) {
    .kao-table tbody tr.kao-row-warn:hover {
