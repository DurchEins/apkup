<script is:inline>
  (function () {
    // 2. Live Countdown to Jan 1, 2027
    var cdEl = document.getElementById('kao-global-countdown');
    if (cdEl) {
      function updateCountdown() {
        var diff = Date.UTC(2027, 0, 1, 0, 0, 0) - Date.now();
        if (diff <= 0) {
          cdEl.innerHTML =
            '<span class="i18n-en">Global Rollout: Active</span><span class="i18n-de">Globaler Rollout: Aktiv</span>';
          return;
        }
        var days = Math.floor(diff / 86400000);
        var hrs = Math.floor((diff % 86400000) / 3600000);
        cdEl.innerHTML =
          '<span class="i18n-en">Global Rollout in ' + days + 'd ' + hrs + 'h</span>' +
          '<span class="i18n-de">Globaler Rollout in ' + days + 'T ' + hrs + 'Std.</span>';
      }
      updateCountdown();
      setInterval(updateCountdown, 60000);
    }

    // 5. Spotlight cursor tracking on fact cards
    document.querySelectorAll('.kao-spotlight').forEach(function (card) {
      card.addEventListener('pointermove', function (e) {
        var r = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        card.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });
    });

    // 9. Staggered Scroll-Reveal for danger cards
    var dangerItems = document.querySelectorAll('.kao-danger-item');
    if ('IntersectionObserver' in window && dangerItems.length) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      dangerItems.forEach(function (item) { io.observe(item); });
    } else {
      dangerItems.forEach(function (item) { item.classList.add('is-visible'); });
    }

    // 3. Interactive 4-Step Checklist
    var STORAGE_KEY = 'apkup-24h-steps-v1';
    var stepsList = document.getElementById('kao-steps-list');
    var countEl = document.getElementById('kao-steps-count');
    var fillEl = document.getElementById('kao-steps-fill');
    if (stepsList) {
      var saved = [];
      try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch (e) {}
      if (!Array.isArray(saved) || saved.length !== 4) saved = [false, false, false, false];
      var items = stepsList.querySelectorAll('li[data-step-idx]');

      function renderSteps() {
        var doneCount = 0;
        items.forEach(function (li, i) {
          var isDone = !!saved[i];
          if (isDone) doneCount++;
          li.classList.toggle('is-done', isDone);
          li.setAttribute('aria-checked', isDone ? 'true' : 'false');
        });
        if (countEl) countEl.textContent = doneCount + ' / 4';
        if (fillEl) fillEl.style.width = (doneCount * 25) + '%';
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(saved)); } catch (e) {}
      }

      items.forEach(function (li, i) {
        function toggle() {
          saved[i] = !saved[i];
          renderSteps();
        }
        li.addEventListener('click', toggle);
        li.addEventListener('keydown', function (e) {
          if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            toggle();
          }
        });
      });
      renderSteps();
    }

    // 7. 7-Day Trap Mini-Simulation
    var sim = document.getElementById('kao-trap-sim');
    var simResult = document.getElementById('kao-trap-result');
    if (sim && simResult) {
      sim.querySelectorAll('.kao-trap-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var mode = btn.getAttribute('data-trap-mode');
          sim.querySelectorAll('.kao-trap-tab').forEach(function (b) {
            var active = b === btn;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          if (mode === 'forever') {
            simResult.classList.remove('is-bad');
            simResult.classList.add('is-good');
            simResult.innerHTML =
              '<span class="i18n-en">Day 1 → Day 365+: ✓ Permanently unlocked (no repeat 24h wait!)</span>' +
              '<span class="i18n-de">Tag 1 → Tag 365+: ✓ Dauerhaft freigeschaltet (nie wieder 24h warten!)</span>';
          } else {
            simResult.classList.remove('is-good');
            simResult.classList.add('is-bad');
            simResult.innerHTML =
              '<span class="i18n-en">Day 1–7: Allowed → Day 8: ✕ Auto-locked again (+24h new wait!)</span>' +
              '<span class="i18n-de">Tag 1–7: Erlaubt → Tag 8: ✕ Automatisch wieder gesperrt (+24h Wartezeit!)</span>';
          }
        });
      });
    }

    // 6. ADB Copy-to-Clipboard Morph
    var copyBtn = document.getElementById('kao-copy-adb');
    if (copyBtn) {
      var copyTimer = null;
      copyBtn.addEventListener('click', function () {
        navigator.clipboard && navigator.clipboard.writeText('adb install -r ApkUp.apk');
        copyBtn.classList.add('is-copied');
        clearTimeout(copyTimer);
        copyTimer = setTimeout(function () {
          copyBtn.classList.remove('is-copied');
        }, 1800);
      });
    }

    // 10. Floating Quick-Jump Pill
    var heroEl = document.getElementById('kao-hero');
    var stepsSection = document.getElementById('sl-lock-steps');
    var jumpBtn = document.getElementById('kao-quick-jump');
    if (heroEl && stepsSection && jumpBtn && 'IntersectionObserver' in window) {
      var heroVisible = true;
      var stepsVisible = false;
      function syncJump() {
        jumpBtn.hidden = heroVisible || stepsVisible;
      }
      new IntersectionObserver(function (e) {
        heroVisible = e[0].isIntersecting;
        syncJump();
      }).observe(heroEl);
      new IntersectionObserver(function (e) {
        stepsVisible = e[0].isIntersecting;
        syncJump();
      }).observe(stepsSection);
    }

    // 6b. Scroll Progress Line
    var scrollBar = document.getElementById('kao-scroll-progress');
    if (scrollBar) {
      function updateScrollBar() {
        var docH = document.documentElement.scrollHeight - window.innerHeight;
        var ratio = docH > 0 ? Math.min(1, Math.max(0, window.scrollY / docH)) : 0;
        scrollBar.style.transform = 'scaleX(' + ratio.toFixed(4) + ')';
      }
      window.addEventListener('scroll', updateScrollBar, { passive: true });
      updateScrollBar();
    }

    // 2b. Share & Warn Others (Native Share or Clipboard Fallback)
    var shareBtn = document.getElementById('kao-share-btn');
    if (shareBtn) {
      var shareResetTimer = null;
      shareBtn.addEventListener('click', function () {
        var url = window.location.href;
        var isDe = document.documentElement.getAttribute('data-lang') === 'de';
        if (navigator.share) {
          navigator.share({
            title: isDe ? 'Googles 24h-Entwicklersperre & Keep Android Open' : 'Google 24h Developer Lock & Keep Android Open',
            text: isDe
              ? 'So löst du Googles neue 24h-Sperre auf Android dauerhaft:'
              : 'How to permanently unlock Google’s 24h sideloading lock on Android:',
            url: url,
          }).catch(function () {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url);
          var prev = shareBtn.innerHTML;
          shareBtn.innerHTML = '<span class="i18n-en">✓ Link copied!</span><span class="i18n-de">✓ Link kopiert!</span>';
          clearTimeout(shareResetTimer);
          shareResetTimer = setTimeout(function () { shareBtn.innerHTML = prev; }, 1800);
        }
      });
    }

    // 3b. 2-Click Self-Check ("Bin ich betroffen?")
    var checker = document.getElementById('kao-checker');
    var checkerRes = document.getElementById('kao-checker-result');
    if (checker && checkerRes) {
      var state = { gms: 'yes', method: 'apk' };
      function renderChecker() {
        var safe = state.gms === 'no' || state.method === 'adb';
        checkerRes.classList.toggle('is-safe', safe);
        checkerRes.classList.toggle('is-affected', !safe);
        if (state.gms === 'no') {
          checkerRes.innerHTML =
            '<span class="i18n-en">✓ Not affected: DeGoogled / Custom ROMs without Play Protect are not blocked.</span>' +
            '<span class="i18n-de">✓ Nicht betroffen: Custom-ROMs ohne Google Play Protect werden nicht blockiert.</span>';
        } else if (state.method === 'adb') {
          checkerRes.innerHTML =
            '<span class="i18n-en">✓ Developer path open: ADB, Shizuku &amp; Root bypass the 24h consumer block.</span>' +
            '<span class="i18n-de">✓ Entwickler-Weg frei: ADB, Shizuku &amp; Root umgehen die 24h-Sperre direkt.</span>';
        } else {
          checkerRes.innerHTML =
            '<span class="i18n-en">⚠ Affected: Complete the 4-step “Allow indefinitely” unlock below once.</span>' +
            '<span class="i18n-de">⚠ Betroffen: Einmalig unten die 4 Schritte („Dauerhaft erlauben“) ausführen.</span>';
        }
      }
      checker.querySelectorAll('.kao-q-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var q = btn.getAttribute('data-q');
          var val = btn.getAttribute('data-val');
          state[q] = val;
          checker.querySelectorAll('.kao-q-btn[data-q="' + q + '"]').forEach(function (b) {
            b.classList.toggle('is-selected', b === btn);
          });
          renderChecker();
        });
      });
    }

    // 9b. Reset Micro-Button for 4/4 Checklist
    var resetBtn = document.getElementById('kao-steps-reset');
    var stepsCountEl = document.getElementById('kao-steps-count');
    if (resetBtn && stepsList) {
      function syncResetVisibility() {
        var allDone = stepsList.querySelectorAll('li.is-done').length === 4;
        resetBtn.hidden = !allDone;
      }
      stepsList.addEventListener('click', function () {
        setTimeout(syncResetVisibility, 0);
      });
      resetBtn.addEventListener('click', function () {
        try { localStorage.removeItem('apkup-24h-steps-v1'); } catch (e) {}
        stepsList.querySelectorAll('li[data-step-idx]').forEach(function (li) {
          li.classList.remove('is-done');
          li.setAttribute('aria-checked', 'false');
        });
        if (stepsCountEl) stepsCountEl.textContent = '0 / 4';
        if (fillEl) fillEl.style.width = '0%';
        resetBtn.hidden = true;
      });
      syncResetVisibility();
    }

    // 5b. 7x Tap Easter Egg on Step 01 Badge
    var badge1 = document.getElementById('kao-step1-badge');
    var devToast = document.getElementById('kao-dev-toast');
    if (badge1 && devToast) {
      var taps = 0;
      var toastTimer = null;
      badge1.addEventListener('click', function (e) {
        e.stopPropagation();
        taps++;
        if (taps >= 7) {
          taps = 0;
          devToast.hidden = false;
          clearTimeout(toastTimer);
          toastTimer = setTimeout(function () { devToast.hidden = true; }, 2600);
        }
      });
    }

    // 1b. 24h Browser Timer + .ics Calendar Reminder Export
    var TIMER_KEY = 'apkup-24h-unlock-at';
    var timerStartBtn = document.getElementById('kao-timer-start');
    var timerIcsBtn = document.getElementById('kao-timer-ics');
    var timerStatus = document.getElementById('kao-timer-status');
    var timerInterval = null;

    function render24hTimer() {
      if (!timerStatus) return;
      var targetMs = 0;
      try { targetMs = Number(localStorage.getItem(TIMER_KEY) || '0'); } catch (e) {}
      if (!targetMs) {
        timerStatus.hidden = true;
        return;
      }
      timerStatus.hidden = false;
      var diff = targetMs - Date.now();
      if (diff <= 0) {
        timerStatus.innerHTML =
          '<span class="i18n-en">✓ 24h complete! Open Developer Options now &amp; pick “Allow indefinitely”.</span>' +
          '<span class="i18n-de">✓ 24h abgelaufen! Jetzt in den Entwickleroptionen „Dauerhaft erlauben“ wählen.</span>';
        return;
      }
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var endDate = new Date(targetMs);
      var hhmm = String(endDate.getHours()).padStart(2, '0') + ':' + String(endDate.getMinutes()).padStart(2, '0');
      timerStatus.innerHTML =
        '<span class="i18n-en">⏳ ' + h + 'h ' + m + 'm left (ready at ' + hhmm + ')</span>' +
        '<span class="i18n-de">⏳ Noch ' + h + ' Std. ' + m + ' Min. (Freigabe ab ' + hhmm + ' Uhr)</span>';
    }

    if (timerStartBtn) {
      timerStartBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        var unlockAt = Date.now() + 24 * 3600 * 1000;
        try { localStorage.setItem(TIMER_KEY, String(unlockAt)); } catch (err) {}
        render24hTimer();
        clearInterval(timerInterval);
        timerInterval = setInterval(render24hTimer, 30000);
      });
      render24hTimer();
      timerInterval = setInterval(render24hTimer, 30000);
    }

    if (timerIcsBtn) {
      timerIcsBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        var targetMs = 0;
        try { targetMs = Number(localStorage.getItem(TIMER_KEY) || '0'); } catch (err) {}
        if (!targetMs) targetMs = Date.now() + 24 * 3600 * 1000;
        function toIcsUtc(d) {
          return d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');
        }
        var start = new Date(targetMs);
        var end = new Date(targetMs + 15 * 60 * 1000);
        var isDe = document.documentElement.getAttribute('data-lang') === 'de';
        var summary = isDe
          ? 'Android 24h-Sperre: Dauerhaft erlauben wählen!'
          : 'Android 24h Lock: Choose Allow indefinitely!';
        var desc = isDe
          ? 'Öffne Einstellungen -> System -> Entwickleroptionen -> Apps von nicht verifizierten Entwicklern -> Dauerhaft erlauben.'
          : 'Open Settings -> System -> Developer Options -> Apps from unverified developers -> Allow indefinitely.';
        var ics = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//ApkUp//24h Lock Reminder//EN',
          'BEGIN:VEVENT',
          'UID:apkup-24h-' + start.getTime() + '@durcheins.github.io',
          'DTSTAMP:' + toIcsUtc(new Date()),
          'DTSTART:' + toIcsUtc(start),
          'DTEND:' + toIcsUtc(end),
          'SUMMARY:' + summary,
          'DESCRIPTION:' + desc,
          'BEGIN:VALARM',
          'TRIGGER:-PT0M',
          'ACTION:DISPLAY',
          'DESCRIPTION:' + summary,
          'END:VALARM',
          'END:VEVENT',
          'END:VCALENDAR',
        ].join('\r\n');
        var blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'apkup-android-24h-unlock.ics';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
      });
    }

    // 8b. Comparison Table Safe Column Highlight
    var cmpTable = document.getElementById('kao-compare-table');
    var safeTh = document.getElementById('kao-col-safe-th');
    if (cmpTable && safeTh) {
      safeTh.addEventListener('mouseenter', function () { cmpTable.classList.add('is-col-safe-hl'); });
      safeTh.addEventListener('mouseleave', function () { cmpTable.classList.remove('is-col-safe-hl'); });
      safeTh.addEventListener('click', function () { cmpTable.classList.toggle('is-col-safe-hl'); });
    }

    // 10b. Smooth Anchor Highlight Flash
    var lockSection = document.getElementById('sl-lock-section');
    if (lockSection) {
      document.querySelectorAll('[data-kao-jump-steps]').forEach(function (el) {
        el.addEventListener('click', function () {
          lockSection.classList.remove('kao-anchor-flash');
          void lockSection.offsetWidth;
          lockSection.classList.add('kao-anchor-flash');
        });
      });
    }
  })();
</script>
