  /* New Spell 6: Scroll Progress Line */
  .kao-scroll-progress {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    z-index: 50;
    background: linear-gradient(90deg, #ef4444, #f97316);
    transform-origin: left center;
