  .kao-copy-icon {
    display: inline-flex;
    transition-property: opacity, transform;
    transition-duration: 300ms;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  .kao-icon-done {
    position: absolute;
    left: 11px;
    opacity: 0;
    transform: scale(0.25);
    color: #4ade80;
  }

  .kao-copy-btn.is-copied {
    border-color: rgba(34, 197, 94, 0.55);
    color: #4ade80;
