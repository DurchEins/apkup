    padding-top: 10px;
    border-top: 1px solid rgba(239, 68, 68, 0.35);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .kao-trap-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .kao-trap-tab {
    padding: 5px 12px;
    border-radius: 999px;
