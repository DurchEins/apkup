---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/content';
---

<BaseLayout title="Security Policy — ApkUp">
  <Navbar />
  <main id="main-content" class="section">
    <div class="container subpage-wrap">
      <div class="section-header">
        <span class="sec-shield-pill mono">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
          <span>Zero Tracking • APK Signature v2/v3</span>
        </span>
        <h1 class="section-title">
          <span class="i18n-en">Security Policy &amp; Architecture</span>
          <span class="i18n-de">Sicherheitsrichtlinie &amp; Architektur</span>
        </h1>
        <p class="section-subtitle">
          <span class="i18n-en">
            Complete security documentation based on SECURITY.md — covering supported versions,
            cryptographic verification, and responsible vulnerability disclosure.
          </span>
          <span class="i18n-de">
            Vollständige Sicherheitsdokumentation auf Basis der SECURITY.md – unterstützte
            Versionen, kryptografische Prüfung und vertrauliche Schwachstellen-Meldung.
          </span>
        </p>
      </div>

      <div class="sec-grid">
        <article class="sec-card">
          <h2>
            <span class="i18n-en">Supported Versions</span>
            <span class="i18n-de">Unterstützte Versionen</span>
          </h2>
          <p>
            <span class="i18n-en">We actively provide security patches for the following versions of ApkUp:</span>
            <span class="i18n-de">Sicherheitsupdates werden aktiv für folgende Versionen von ApkUp bereitgestellt:</span>
          </p>
          <div class="sec-table-wrap">
            <table class="sec-table">
              <thead>
                <tr>
                  <th>Version</th>
                  <th>
                    <span class="i18n-en">Status</span>
                    <span class="i18n-de">Unterstützt</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="mono">1.45.x (or newer / oder neuer)</td>
                  <td><span class="pill-badge pill-emerald">✓ Supported / Aktiv</span></td>
                </tr>
                <tr>
                  <td class="mono">1.44.x</td>
                  <td><span class="pill-badge pill-emerald">✓ Supported / Aktiv</span></td>
                </tr>
                <tr>
                  <td class="mono">&lt; 1.44</td>
                  <td><span class="pill-badge pill-neutral">✕ End of Life</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </article>

        <article class="sec-card">
          <h2>
            <span class="i18n-en">Defense-in-Depth Security Architecture</span>
            <span class="i18n-de">Sicherheitsarchitektur im Überblick</span>
          </h2>
          <p>
            <span class="i18n-en">ApkUp enforces multi-layer verification across every update lifecycle stage:</span>
            <span class="i18n-de">ApkUp schützt den gesamten Update-Prozess mehrstufig ab:</span>
          </p>

          <div class="sec-pillars">
            <div class="sec-pillar">
              <div class="sec-pillar-head">
                <span class="pill-badge pill-amber mono">apksig v2 / v3</span>
                <h3>
                  <span class="i18n-en">Cryptographic APK Signature Verification</span>
                  <span class="i18n-de">Kryptografische APK-Signaturprüfung</span>
                </h3>
              </div>
              <p>
                <span class="i18n-en">
                  Before handing any downloaded APK or .apkm split bundle to PackageInstaller,
                  Shizuku, or Root (su), ApkIntegrityVerifier verifies APK Signature Scheme v2/v3
                  signing certificates against the currently installed application and blocks
                  certificate mismatches or version downgrades.
                </span>
                <span class="i18n-de">
                  Vor jeder Übergabe an den Android-PackageInstaller, Shizuku oder Root (su) prüft
                  ApkIntegrityVerifier die APK-Signaturzertifikate (v2/v3 Signing Scheme) gegen die
                  bereits installierte App und blockiert Signaturabweichungen sowie
                  Versions-Downgrades.
                </span>
              </p>
            </div>

            <div class="sec-pillar">
              <div class="sec-pillar-head">
                <span class="pill-badge pill-amber mono">SHA-256 + X.509 TOFU</span>
                <h3>
                  <span class="i18n-en">Signed F-Droid / IzzyOnDroid Indexes &amp; SHA-256 Checksums</span>
                  <span class="i18n-de">Signierte F-Droid-/IzzyOnDroid-Indizes &amp; SHA-256-Prüfsummen</span>
                </h3>
              </div>
              <p>
                <span class="i18n-en">
                  Repository indexes (entry.jar / index-v1.jar) are verified against pinned 64-hex
                  SHA-256 X.509 signing certificate fingerprints, and downloaded APKs (including
                  ApkUp self-updates via SHA256SUMS) are validated against expected SHA-256 digests.
                </span>
                <span class="i18n-de">
                  Repository-Indizes (entry.jar / index-v1.jar) werden kryptografisch gegen gepinnte
                  SHA-256-Zertifikats-Fingerprints geprüft; heruntergeladene APKs (einschließlich
                  Selbst-Updates über SHA256SUMS) werden gegen erwartete SHA-256-Prüfsummen
                  validiert.
                </span>
              </p>
            </div>

            <div class="sec-pillar">
              <div class="sec-pillar-head">
                <span class="pill-badge pill-neutral mono">Zip-Slip Guard + cacheDir</span>
                <h3>
                  <span class="i18n-en">Hardened Archive &amp; Storage Isolation</span>
                  <span class="i18n-de">Isolierter Speicher &amp; Archiv-Härtung</span>
                </h3>
              </div>
              <p>
                <span class="i18n-en">
                  All downloads reside in private internal app storage (cacheDir), .apkm split
                  bundles enforce strict Zip-Slip and decompression-bomb limits, and cleartext HTTP
                  traffic as well as cloud backups are strictly disabled.
                </span>
                <span class="i18n-de">
                  Downloads liegen ausschließlich im privaten internen App-Speicher (cacheDir),
                  .apkm-Bundles sind gegen Zip-Slip und Entpackbomben gehärtet, Klartext-HTTP sowie
                  Cloud-Backups sind deaktiviert.
                </span>
              </p>
            </div>

            <div class="sec-pillar">
              <div class="sec-pillar-head">
                <span class="pill-badge pill-emerald mono">Google Tink AES-256-GCM</span>
                <h3>
                  <span class="i18n-en">Encrypted Credentials &amp; Host Isolation</span>
                  <span class="i18n-de">Verschlüsselte Zugangsdaten &amp; Host-Isolierung</span>
                </h3>
              </div>
              <p>
                <span class="i18n-en">
                  Local preferences and optional tokens are encrypted at rest using Google Tink
                  (AES-256-GCM via Android Keystore). Authorization headers are pinned strictly to
                  their target API hosts and stripped across cross-host redirects.
                </span>
                <span class="i18n-de">
                  Lokale Einstellungen und optionale API-Tokens werden per Google Tink (AES-256-GCM
                  im Android Keystore) verschlüsselt gespeichert und niemals an fremde
                  Redirect-Domains weitergeleitet.
                </span>
              </p>
            </div>
          </div>
        </article>

        <article class="sec-card sec-report-card">
          <h2>
            <span class="i18n-en">Reporting a Vulnerability</span>
            <span class="i18n-de">Sicherheitslücken vertraulich melden</span>
          </h2>
          <p>
            <span class="i18n-en">
              If you discover a potential security vulnerability within ApkUp (especially regarding
              APK signature verification, .apkm archive extraction, Shizuku IPC / optional Root su
              execution, credential storage, or network transport), please do <strong>NOT</strong>
              disclose it via public GitHub issues, discussions, or social media.
            </span>
            <span class="i18n-de">
              Solltest du eine Sicherheitslücke in ApkUp entdecken (insbesondere bei der
              APK-Signaturprüfung, der .apkm-Archiv-Entpackung, der Shizuku- / optionalen
              Root-(su)-Ausführung, der Token-Speicherung oder dem Netzwerk-Transport), erstelle
              bitte <strong>KEIN</strong> öffentliches Issue.
            </span>
          </p>
          <ol class="sec-steps">
            <li>
              <span class="i18n-en">Use GitHub’s confidential <strong>Private Vulnerability Reporting</strong>.</span>
              <span class="i18n-de">Nutze vertraulich GitHubs <strong>Private Vulnerability Reporting</strong>.</span>
            </li>
            <li>
              <span class="i18n-en">Detail the issue, steps to reproduce, affected versions, and include a proof-of-concept if available.</span>
              <span class="i18n-de">Beschreibe die Schwachstelle mit Reproduktionsschritten, betroffenen Versionen sowie ggf. einem Proof-of-Concept.</span>
            </li>
            <li>
              <span class="i18n-en">We will review incoming reports promptly, investigate the scope, and release a patch before any public disclosure occurs.</span>
              <span class="i18n-de">Meldungen werden schnellstmöglich geprüft und behoben, bevor Details öffentlich geteilt werden.</span>
            </li>
          </ol>
          <div class="sec-actions">
            <a
              class="btn btn-primary"
              href="https://github.com/DurchEins/apkup/security/advisories/new"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="i18n-en">Report a Vulnerability (Confidential)</span>
              <span class="i18n-de">Sicherheitslücke vertraulich melden</span>
            </a>
            <a class="btn btn-secondary" href={SITE.securityUrl} target="_blank" rel="noopener noreferrer">
              <span class="i18n-en">View SECURITY.md on GitHub</span>
              <span class="i18n-de">SECURITY.md auf GitHub</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .sec-shield-pill {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    background: var(--tertiary-soft);
    color: var(--tertiary-soft-ink);
    border: 1px solid rgba(110, 231, 183, 0.35);
    font-size: 0.78rem;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .sec-shield-pill::after {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 40%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
    transform: translateX(-140%);
    animation: secGleam 3.2s ease-in-out infinite;
  }

  @keyframes secGleam {
    0%, 70% { transform: translateX(-140%); }
    100% { transform: translateX(320%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sec-shield-pill::after { animation: none; }
  }

  .subpage-wrap {
    max-width: 900px;
  }

  .sec-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sec-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3vw, 30px);
  }

  .sec-card h2 {
    margin: 0 0 10px;
    font-size: 1.3rem;
    font-weight: 800;
  }

  .sec-card > p {
    margin: 0 0 16px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .sec-table-wrap {
    overflow-x: auto;
  }

  .sec-table {
    width: 100%;
    border-collapse: collapse;
    text-align: start;
  }

  .sec-table th,
  .sec-table td {
    padding: 12px 14px;
    border-block-end: 1px solid var(--outline);
  }

  .sec-table th {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 700;
  }

  .sec-pillars {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .sec-pillar {
    background: var(--bg);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sec-pillar-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .sec-pillar h3 {
    margin: 0;
    font-size: 1.04rem;
    font-weight: 700;
  }

  .sec-pillar p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .sec-steps {
    margin: 0 0 20px;
    padding-inline-start: 20px;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 8px;
    line-height: 1.55;
  }

  .sec-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 760px) {
    .sec-pillars {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
