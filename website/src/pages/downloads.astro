---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QrModal from '../components/QrModal.astro';
import { SITE, MIRRORS } from '../data/content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const MIRROR_DESCRIPTIONS: Record<string, { en: string; de: string; tier: 'official' | 'community' | 'outdated' }> = {
  Zapstore: {
    en: 'Decentralized Nostr-based Android app store with cryptographic developer signatures.',
    de: 'Dezentraler Nostr-App-Store mit kryptografischer Entwickler-Signatur.',
    tier: 'official',
  },
  GitLab: {
    en: 'Full source-code mirror & automated release mirror synchronized from main.',
    de: 'Vollständiger Quellcode- und Release-Mirror, synchronisiert mit main.',
    tier: 'official',
  },
  APKPure: {
    en: 'Popular third-party APK mirror indexing signed public releases.',
    de: 'Bekannter Drittanbieter-Mirror, der signierte Releases spiegelt.',
    tier: 'community',
  },
  'itch.io': {
    en: 'Indie distribution page with direct APK download & version notes.',
    de: 'Indie-Vertriebsseite mit direktem APK-Download und Versionshinweisen.',
    tier: 'community',
  },
  Appteka: {
    en: 'Independent Android app catalog hosting verified APK builds.',
    de: 'Unabhängiger Android-App-Katalog mit gehosteten APK-Builds.',
    tier: 'community',
  },
  'Komi Store': {
    en: 'Community-curated FOSS Android app store.',
    de: 'Von der Community kuratierter FOSS-Android-Store.',
    tier: 'community',
  },
  AlternativeTo: {
    en: 'Community reviews, feature tags, and open-source alternatives listing.',
    de: 'Community-Bewertungen, Funktionsübersicht und Open-Source-Eintrag.',
    tier: 'community',
  },
  'Amazon Appstore': {
    en: 'Legacy listing — no longer receives current builds. Prefer GitHub Releases.',
    de: 'Veralteter Eintrag — erhält keine aktuellen Builds mehr. Bitte GitHub Releases nutzen.',
    tier: 'outdated',
  },
};

const downloadSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ApkUp',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Android 10.0 - 17 (API 29+)',
  softwareVersion: SITE.fallbackVersion,
  license: SITE.licenseUrl,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  url: 'https://durcheins.github.io/apkup/downloads/',
  downloadUrl: SITE.releasesUrl,
};
---

<BaseLayout
  title="Downloads, Mirrors & SHA-256 Verification — ApkUp"
  description="Download the canonical signed ApkUp APK from GitHub Releases, verify SHA256SUMS checksums, and browse all 8 official & community mirrors."
  jsonLd={downloadSchema}
>
  <Navbar />
  <main id="main-content" class="subpage-main">
    <div class="container">
      <div class="subpage-header">
        <span class="pill-badge pill-amber mono">v{SITE.fallbackVersion} ({SITE.fallbackBuild})</span>
        <h1 class="subpage-title">
          <span class="i18n-en">Downloads, Mirrors &amp; Verification</span>
          <span class="i18n-de">Downloads, Mirrors &amp; Verifizierung</span>
        </h1>
        <p class="subpage-lead">
          <span class="i18n-en">
            Single-Artifact Principle: GitHub Releases provides the canonical CI-signed APK and
            SHA256SUMS checksum. All mirrors below link to ApkUp’s official or community listings.
          </span>
          <span class="i18n-de">
            Single-Artifact-Prinzip: GitHub Releases liefert die kanonische, per CI signierte APK
            samt SHA256SUMS-Prüfsumme. Unten findest du alle 8 offiziellen und Community-Mirrors.
          </span>
        </p>
      </div>

      <!-- 1. Canonical Release Card -->
      <section class="dl-card" aria-labelledby="dl-canonical-title">
        <div class="dl-card-top">
          <div>
            <div class="dl-badges">
              <span class="pill-badge pill-amber mono" id="dl-page-version">v{SITE.fallbackVersion}</span>
              <span class="pill-badge pill-green">
                <span class="i18n-en">Canonical Signed CI Build</span>
                <span class="i18n-de">Kanonischer Signierter CI-Build</span>
              </span>
            </div>
            <h2 id="dl-canonical-title">GitHub Releases (Direct Signed APK)</h2>
            <p class="dl-subtext">
              <span class="i18n-en">
                Universal APK with built-in self-updater, reproducible GitHub Actions build, and
                cryptographic SHA-256 verification.
              </span>
              <span class="i18n-de">
                Universelle APK mit integriertem Selbst-Updater, reproduzierbarem GitHub-Actions-Build
                und kryptografischer SHA-256-Prüfung.
              </span>
            </p>
          </div>
          <div class="dl-actions">
            <a class="btn btn-primary" href={SITE.releasesUrl} data-apk-link>
              <span class="i18n-en" data-apk-label-en>Download Latest APK</span>
              <span class="i18n-de" data-apk-label-de>Aktuelle APK herunterladen</span>
            </a>
            <button type="button" class="btn btn-secondary" data-open-qr>
              <span>QR-Code</span>
            </button>
            <a class="btn btn-ghost" href={`${base}changelog/`}>
              <span class="i18n-en">What’s New?</span>
              <span class="i18n-de">Was ist neu?</span>
            </a>
          </div>
        </div>

        <div class="dl-specs-grid mono">
          <div class="dl-spec-item">
            <span class="dl-spec-label">
              <span class="i18n-en">Android Version</span>
              <span class="i18n-de">Android-Version</span>
            </span>
            <strong>10.0 – 17 (API 29+)</strong>
          </div>
          <div class="dl-spec-item">
            <span class="dl-spec-label">
              <span class="i18n-en">Supported ABIs</span>
              <span class="i18n-de">Unterstützte ABIs</span>
            </span>
            <strong>arm64-v8a • armeabi-v7a • x86_64</strong>
          </div>
          <div class="dl-spec-item">
            <span class="dl-spec-label">
              <span class="i18n-en">License</span>
              <span class="i18n-de">Lizenz</span>
            </span>
            <strong>GPL-3.0 Open Source</strong>
          </div>
          <div class="dl-spec-item">
            <span class="dl-spec-label">
              <span class="i18n-en">Signature Scheme</span>
              <span class="i18n-de">Signatur-Verfahren</span>
            </span>
            <strong>APK Signature v2 / v3</strong>
          </div>
        </div>
      </section>

      <!-- 2. Live SHA256SUMS & Verification -->
      <section class="dl-verify-card" aria-labelledby="dl-verify-title">
        <div class="dl-verify-head">
          <div>
            <h2 id="dl-verify-title">
              <span class="i18n-en">SHA-256 Checksum &amp; Integrity Verification</span>
              <span class="i18n-de">SHA-256-Prüfsumme &amp; Integritätsprüfung</span>
            </h2>
            <p class="dl-subtext">
              <span class="i18n-en">
                Verify your downloaded APK matches the official GitHub Actions release artifact
                before installing.
              </span>
              <span class="i18n-de">
                Prüfe vor der Installation, ob deine heruntergeladene APK exakt mit dem offiziellen
                GitHub-Actions-Artefakt übereinstimmt.
              </span>
            </p>
          </div>
          <a
            class="btn btn-secondary"
            href="https://github.com/DurchEins/apkup/releases/latest"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="i18n-en">View SHA256SUMS on GitHub ↗</span>
            <span class="i18n-de">SHA256SUMS auf GitHub öffnen ↗</span>
          </a>
        </div>

        <div class="dl-hash-box">
          <div class="dl-hash-row">
            <code class="mono" id="sha256-output">
              Loading live SHA256SUMS from GitHub Releases…
            </code>
            <button type="button" class="btn btn-ghost dl-copy-btn" id="copy-sha256-btn" hidden>
              <span class="i18n-en">Copy</span>
              <span class="i18n-de">Kopieren</span>
            </button>
          </div>
        </div>

        <div class="dl-cmd-grid">
          <div class="dl-cmd-box">
            <span class="mono dl-cmd-label">Linux / macOS (Terminal)</span>
            <code class="mono">sha256sum -c SHA256SUMS</code>
          </div>
          <div class="dl-cmd-box">
            <span class="mono dl-cmd-label">Windows (PowerShell)</span>
            <code class="mono">Get-FileHash .\ApkUp-*.apk -Algorithm SHA256</code>
          </div>
        </div>
      </section>

      <!-- 3. All 8 Mirrors -->
      <section class="dl-mirrors-section" aria-labelledby="dl-mirrors-title">
        <div class="dl-section-head">
          <h2 id="dl-mirrors-title">
            <span class="i18n-en">All 8 Mirrors &amp; Distribution Channels</span>
            <span class="i18n-de">Alle 8 Mirrors &amp; Distributionskanäle</span>
          </h2>
          <p class="dl-subtext">
            <span class="i18n-en">
              Official mirrors receive updates alongside GitHub Releases. Community mirrors are
              indexed externally; Amazon Appstore is no longer updated.
            </span>
            <span class="i18n-de">
              Offizielle Mirrors werden direkt mit den Releases gepflegt. Community-Mirrors
              spiegeln öffentliche Releases; der Amazon Appstore wird nicht mehr aktualisiert.
            </span>
          </p>
        </div>

        <div class="dl-mirrors-grid">
          {
            MIRRORS.map((m) => {
              const meta = MIRROR_DESCRIPTIONS[m.name] ?? {
                en: m.badgeEn,
                de: m.badgeDe,
                tier: 'community' as const,
              };
              return (
                <a
                  class={`dl-mirror-item ${m.outdated ? 'is-outdated' : ''}`}
                  href={m.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="dl-mirror-top">
                    <div class="dl-mirror-title-wrap">
                      <span class="dl-mirror-dot" style={`background: ${m.color};`} aria-hidden="true" />
                      <strong>{m.name}</strong>
                    </div>
                    <span class={`pill-badge ${m.outdated ? 'pill-warn' : meta.tier === 'official' ? 'pill-green' : 'pill-neutral'} mono`}>
                      <span class="i18n-en">{m.badgeEn}</span>
                      <span class="i18n-de">{m.badgeDe}</span>
                    </span>
                  </div>
                  <p>
                    <span class="i18n-en">{meta.en}</span>
                    <span class="i18n-de">{meta.de}</span>
                  </p>
                </a>
              );
            })
          }
        </div>
      </section>
    </div>
  </main>
  <Footer />
  <QrModal />
</BaseLayout>

<script is:inline>
  (function () {
    var out = document.getElementById('sha256-output');
    var copyBtn = document.getElementById('copy-sha256-btn');
    var verBadge = document.getElementById('dl-page-version');
    var shaText = '';

    function renderSha(text) {
      shaText = (text || '').trim();
      if (!out) return;
      if (shaText) {
        out.textContent = shaText;
        if (copyBtn) copyBtn.hidden = false;
      } else {
        out.textContent = 'SHA256SUMS available on GitHub Releases (api rate-limited or offline).';
      }
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        if (!shaText || !navigator.clipboard) return;
        navigator.clipboard.writeText(shaText).then(function () {
          copyBtn.textContent = '✓';
          setTimeout(function () {
            copyBtn.innerHTML = '<span class="i18n-en">Copy</span><span class="i18n-de">Kopieren</span>';
          }, 1800);
        });
      });
    }

    fetch('https://api.github.com/repos/DurchEins/apkup/releases/latest', {
      headers: { Accept: 'application/vnd.github+json' },
    })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (rel) {
        if (!rel) return renderSha('');
        if (verBadge && rel.tag_name) verBadge.textContent = rel.tag_name;
        var shaAsset = (rel.assets || []).find(function (a) {
          return /sha256/i.test(a.name || '');
        });
        if (!shaAsset || !shaAsset.browser_download_url) return renderSha('');
        return fetch(shaAsset.browser_download_url)
          .then(function (r) { return r.ok ? r.text() : ''; })
          .then(renderSha)
          .catch(function () { renderSha(''); });
      })
      .catch(function () { renderSha(''); });
  })();
</script>

<style>
  .subpage-main {
    padding-block: 48px 80px;
  }

  .subpage-header {
    margin-bottom: 32px;
    max-width: 760px;
  }

  .subpage-title {
    margin-top: 14px;
    font-size: clamp(1.9rem, 3.8vw, 2.7rem);
    letter-spacing: -0.025em;
  }

  .subpage-lead {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .dl-card,
  .dl-verify-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3vw, 32px);
    margin-bottom: 24px;
  }

  .dl-card-top,
  .dl-verify-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .dl-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .dl-card h2,
  .dl-verify-card h2,
  .dl-section-head h2 {
    font-size: 1.35rem;
    margin: 0 0 8px;
  }

  .dl-subtext {
    color: var(--text-muted);
    font-size: 0.94rem;
    margin: 0;
    max-width: 68ch;
  }

  .dl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .dl-specs-grid {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--outline);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 14px;
  }

  .dl-spec-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.84rem;
  }

  .dl-spec-label {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .dl-hash-box {
    margin-top: 18px;
    background: var(--bg);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 14px 16px;
  }

  .dl-hash-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .dl-hash-row code {
    font-size: 0.82rem;
    color: var(--accent);
    word-break: break-all;
    white-space: pre-wrap;
  }

  .dl-copy-btn {
    min-height: 34px;
    padding: 4px 12px;
    font-size: 0.8rem;
  }

  .dl-cmd-grid {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }

  .dl-cmd-box {
    background: var(--bg);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dl-cmd-label {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .dl-cmd-box code {
    font-size: 0.82rem;
    word-break: break-all;
  }

  .dl-mirrors-section {
    margin-top: 36px;
  }

  .dl-section-head {
    margin-bottom: 18px;
  }

  .dl-mirrors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }

  .dl-mirror-item {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 18px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 150ms ease-out, transform 150ms ease-out;
  }

  .dl-mirror-item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .dl-mirror-item.is-outdated {
    opacity: 0.78;
  }

  .dl-mirror-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .dl-mirror-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dl-mirror-dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .dl-mirror-item p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .pill-warn {
    background: rgba(239, 68, 68, 0.14);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.35);
  }
</style>
