---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QrModal from '../components/QrModal.astro';
import MirrorIcon from '../components/MirrorIcon.astro';
import { SITE, MIRRORS } from '../data/content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const MIRROR_DESCRIPTIONS: Record<string, { en: string; de: string; tier: 'official' | 'community' | 'outdated' }> = {
  Zapstore: {
    en: 'Decentralized Nostr-based Android app store with cryptographic developer signatures.',
    de: 'Dezentraler Nostr-App-Store mit kryptografischer Entwickler-Signatur.',
    tier: 'official',
  },
  'GitLab Releases': {
    en: 'Full source-code mirror & automated release mirror synchronized from main.',
    de: 'Vollständiger Quellcode- und Release-Mirror, synchronisiert mit main.',
    tier: 'official',
  },
  APKPure: {
    en: 'Popular third-party APK mirror indexing signed public releases.',
    de: 'Bekannter Drittanbieter-Mirror, der signierte Releases spiegelt.',
    tier: 'community',
  },
  'itch.io': {
    en: 'Indie distribution page with direct APK download & version notes.',
    de: 'Indie-Vertriebsseite mit direktem APK-Download und Versionshinweisen.',
    tier: 'community',
  },
  Appteka: {
    en: 'Independent Android app catalog hosting verified APK builds.',
    de: 'Unabhängiger Android-App-Katalog mit gehosteten APK-Builds.',
    tier: 'community',
  },
  'Komi Store': {
    en: 'Community-curated FOSS Android app store.',
    de: 'Von der Community kuratierter FOSS-Android-Store.',
    tier: 'community',
  },
  AlternativeTo: {
    en: 'Community reviews, feature tags, and open-source alternatives listing.',
    de: 'Community-Bewertungen, Funktionsübersicht und Open-Source-Eintrag.',
    tier: 'community',
  },
  'Amazon Appstore': {
    en: 'Legacy listing — no longer receives current builds. Prefer GitHub Releases.',
    de: 'Veralteter Eintrag — erhält keine aktuellen Builds mehr. Bitte GitHub Releases nutzen.',
    tier: 'outdated',
  },
};

const officialMirrors = MIRRORS.filter((m) => MIRROR_DESCRIPTIONS[m.name]?.tier === 'official');
const communityMirrors = MIRRORS.filter((m) => MIRROR_DESCRIPTIONS[m.name]?.tier !== 'official');

const downloadSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ApkUp',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Android 10.0 - 17 (API 29+)',
  softwareVersion: SITE.fallbackVersion,
  license: SITE.licenseUrl,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  url: 'https://durcheins.github.io/apkup/downloads/',
  downloadUrl: SITE.releasesUrl,
};
---

<BaseLayout
  title="Downloads, Mirrors & SHA-256 Verification — ApkUp"
  description="Download the canonical signed ApkUp APK from GitHub Releases, verify SHA256SUMS checksums, and browse all 8 official & community mirrors."
  jsonLd={downloadSchema}
>
  <Navbar />
  <main id="main-content" class="dl-page">
    <div class="container">
      <header class="dl-header">
        <span class="pill-badge pill-amber mono" id="dl-page-version">
          v{SITE.fallbackVersion} ({SITE.fallbackBuild})
        </span>
        <h1 class="dl-title">
          <span class="i18n-en">Downloads, Mirrors &amp; Verification</span>
          <span class="i18n-de">Downloads, Mirrors &amp; Verifizierung</span>
        </h1>
        <p class="dl-lead">
          <span class="i18n-en">
            Single-Artifact Principle: GitHub Releases delivers the canonical CI-signed APK and
            SHA256SUMS checksum. Below you’ll find live integrity verification and all 8 mirrors.
          </span>
          <span class="i18n-de">
            Single-Artifact-Prinzip: GitHub Releases liefert die kanonische, per CI signierte APK
            samt SHA256SUMS-Prüfsumme. Unten findest du Live-Verifizierung und alle 8 Mirrors.
          </span>
        </p>
      </header>

      <!-- 1. Canonical Release Card -->
      <section class="dl-hero-card" aria-labelledby="dl-canonical-title">
        <div class="dl-hero-top">
          <div>
            <div class="dl-badges">
              <span class="pill-badge pill-amber mono" data-gh-version>v{SITE.fallbackVersion}</span>
              <span class="pill-badge pill-green">
                <span class="i18n-en">Canonical Signed CI Build</span>
                <span class="i18n-de">Kanonischer Signierter CI-Build</span>
              </span>
            </div>
            <h2 id="dl-canonical-title">GitHub Releases (Direct Signed APK)</h2>
            <p class="dl-muted">
              <span class="i18n-en">
                Universal APK with built-in self-updater, reproducible GitHub Actions build, and
                cryptographic SHA-256 verification.
              </span>
              <span class="i18n-de">
                Universelle APK mit integriertem Selbst-Updater, reproduzierbarem GitHub-Actions-Build
                und kryptografischer SHA-256-Prüfung.
              </span>
            </p>
          </div>
          <div class="dl-actions">
            <a class="btn btn-primary" href={SITE.releasesUrl} data-apk-link>
              <span class="i18n-en" data-apk-label-en>Download Latest APK</span>
              <span class="i18n-de" data-apk-label-de>Aktuelle APK herunterladen</span>
            </a>
            <button type="button" class="btn btn-secondary" data-open-qr>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <path d="M14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 18v3" />
              </svg>
              <span>QR-Code</span>
            </button>
            <a class="btn btn-ghost" href={`${base}changelog/`}>
              <span class="i18n-en">What’s New?</span>
              <span class="i18n-de">Was ist neu?</span>
            </a>
          </div>
        </div>

        <div class="dl-specs-strip mono">
          <div class="dl-spec">
            <span>Android</span>
            <strong>10.0 – 17 (API 29+)</strong>
          </div>
          <div class="dl-spec">
            <span>ABIs</span>
            <strong>arm64-v8a • armeabi-v7a • x86_64</strong>
          </div>
          <div class="dl-spec">
            <span>
              <span class="i18n-en">License</span>
              <span class="i18n-de">Lizenz</span>
            </span>
            <strong>GPL-3.0 Open Source</strong>
          </div>
          <div class="dl-spec">
            <span>
              <span class="i18n-en">Signature</span>
              <span class="i18n-de">Signatur</span>
            </span>
            <strong>APK Signature v2 / v3</strong>
          </div>
        </div>
      </section>

      <!-- 2. 2-Column Bento Verification Grid -->
      <section class="dl-bento-grid" aria-labelledby="dl-verify-title">
        <div class="dl-bento-card">
          <div class="dl-bento-head">
            <h2 id="dl-verify-title">
              <span class="i18n-en">Live SHA-256 Checksum</span>
              <span class="i18n-de">Live-SHA-256-Prüfsumme</span>
            </h2>
            <a
              class="dl-ext-link mono"
              href="https://github.com/DurchEins/apkup/releases/latest"
              target="_blank"
              rel="noopener noreferrer"
            >
              SHA256SUMS ↗
            </a>
          </div>
          <p class="dl-muted">
            <span class="i18n-en">
              Fetched live from the latest GitHub Release so you can verify your APK matches the
              exact CI build artifact.
            </span>
            <span class="i18n-de">
              Live vom neuesten GitHub Release geladen, damit du deine APK exakt mit dem CI-Build
              abgleichen kannst.
            </span>
          </p>
          <div class="dl-code-box">
            <code class="mono" id="sha256-output">Loading SHA256SUMS…</code>
            <button type="button" class="btn btn-secondary dl-copy-sm" id="copy-sha256-btn" hidden>
              <span class="i18n-en">Copy</span>
              <span class="i18n-de">Kopieren</span>
            </button>
          </div>
        </div>

        <div class="dl-bento-card">
          <h2>
            <span class="i18n-en">Local Verification Commands</span>
            <span class="i18n-de">Lokale Prüfbefehle</span>
          </h2>
          <p class="dl-muted">
            <span class="i18n-en">
              Run either command in your download folder to compare your local APK hash against the
              official release checksum.
            </span>
            <span class="i18n-de">
              Führe einen der Befehle im Download-Ordner aus, um deine APK-Datei lokal gegen die
              offizielle Prüfsumme zu testen.
            </span>
          </p>
          <div class="dl-cmd-stack">
            <div class="dl-cmd-row">
              <span class="mono dl-cmd-os">Linux / macOS</span>
              <code class="mono">sha256sum -c SHA256SUMS</code>
            </div>
            <div class="dl-cmd-row">
              <span class="mono dl-cmd-os">Windows PowerShell</span>
              <code class="mono">Get-FileHash .\ApkUp-*.apk -Algorithm SHA256</code>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Official Mirrors (2-column symmetrical) -->
      <section class="dl-mirrors-group" aria-labelledby="dl-official-title">
        <div class="dl-group-head">
          <h2 id="dl-official-title">
            <span class="i18n-en">Official Mirrors</span>
            <span class="i18n-de">Offizielle Mirrors</span>
          </h2>
          <p class="dl-muted">
            <span class="i18n-en">Directly maintained alongside GitHub Releases.</span>
            <span class="i18n-de">Direkt parallel zu GitHub Releases gepflegt.</span>
          </p>
        </div>

        <div class="dl-mirror-grid">
          {
            officialMirrors.map((m) => {
              const meta = MIRROR_DESCRIPTIONS[m.name];
              return (
                <a class="dl-mirror-card" href={m.url} target="_blank" rel="noopener noreferrer">
                  <div class="dl-mirror-head">
                    <div class="dl-mirror-brand">
                      <span class="dl-mirror-icon" style={`background: ${m.color};`}>
                        <MirrorIcon name={m.name} size={22} />
                      </span>
                      <div>
                        <strong>{m.name}</strong>
                        <span class="pill-badge pill-green mono">
                          <span class="i18n-en">{m.badgeEn}</span>
                          <span class="i18n-de">{m.badgeDe}</span>
                        </span>
                      </div>
                    </div>
                    <svg class="dl-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                  </div>
                  <p>
                    <span class="i18n-en">{meta.en}</span>
                    <span class="i18n-de">{meta.de}</span>
                  </p>
                </a>
              );
            })
          }
        </div>
      </section>

      <!-- 4. Community Stores & Legacy (3x2 symmetrical) -->
      <section class="dl-mirrors-group" aria-labelledby="dl-community-title">
        <div class="dl-group-head">
          <h2 id="dl-community-title">
            <span class="i18n-en">Community Stores &amp; Directory</span>
            <span class="i18n-de">Community-Stores &amp; Verzeichnis</span>
          </h2>
          <p class="dl-muted">
            <span class="i18n-en">Third-party APK mirrors, indie catalogs, and legacy listings.</span>
            <span class="i18n-de">Drittanbieter-Mirrors, Indie-Kataloge und archivierte Einträge.</span>
          </p>
        </div>

        <div class="dl-mirror-grid">
          {
            communityMirrors.map((m) => {
              const meta = MIRROR_DESCRIPTIONS[m.name];
              return (
                <a
                  class={`dl-mirror-card ${m.outdated ? 'is-outdated' : ''}`}
                  href={m.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="dl-mirror-head">
                    <div class="dl-mirror-brand">
                      <span class="dl-mirror-icon" style={`background: ${m.color};`}>
                        <MirrorIcon name={m.name} size={22} />
                      </span>
                      <div>
                        <strong>{m.name}</strong>
                        <span class={`pill-badge ${m.outdated ? 'pill-warn' : 'pill-neutral'} mono`}>
                          <span class="i18n-en">{m.badgeEn}</span>
                          <span class="i18n-de">{m.badgeDe}</span>
                        </span>
                      </div>
                    </div>
                    <svg class="dl-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                  </div>
                  <p>
                    <span class="i18n-en">{meta.en}</span>
                    <span class="i18n-de">{meta.de}</span>
                  </p>
                </a>
              );
            })
          }
        </div>
      </section>
    </div>
  </main>
  <Footer />
  <QrModal />
</BaseLayout>

<script is:inline>
  (function () {
    var out = document.getElementById('sha256-output');
    var copyBtn = document.getElementById('copy-sha256-btn');
    var verBadge = document.getElementById('dl-page-version');
    var shaText = '';

    function renderSha(text) {
      shaText = (text || '').trim();
      if (!out) return;
      if (shaText) {
        out.textContent = shaText;
        if (copyBtn) copyBtn.hidden = false;
      } else {
        out.textContent = 'SHA256SUMS available on GitHub Releases.';
      }
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        if (!shaText || !navigator.clipboard) return;
        navigator.clipboard.writeText(shaText).then(function () {
          copyBtn.textContent = '✓';
          setTimeout(function () {
            copyBtn.innerHTML = '<span class="i18n-en">Copy</span><span class="i18n-de">Kopieren</span>';
          }, 1800);
        });
      });
    }

    fetch('https://api.github.com/repos/DurchEins/apkup/releases/latest', {
      headers: { Accept: 'application/vnd.github+json' },
    })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (rel) {
        if (!rel) return renderSha('');
        if (verBadge && rel.tag_name) verBadge.textContent = rel.tag_name;
        var shaAsset = (rel.assets || []).find(function (a) {
          return /sha256/i.test(a.name || '');
        });
        if (!shaAsset || !shaAsset.browser_download_url) return renderSha('');
        return fetch(shaAsset.browser_download_url)
          .then(function (r) { return r.ok ? r.text() : ''; })
          .then(renderSha)
          .catch(function () { renderSha(''); });
      })
      .catch(function () { renderSha(''); });
  })();
</script>

<style>
  .dl-page {
    padding-block: 48px 80px;
  }

  .dl-header {
    max-width: 740px;
    margin-bottom: 32px;
  }

  .dl-title {
    margin-top: 14px;
    font-size: clamp(1.9rem, 3.8vw, 2.7rem);
    letter-spacing: -0.025em;
  }

  .dl-lead {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .dl-muted {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .dl-hero-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3vw, 32px);
    margin-bottom: 20px;
  }

  .dl-hero-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .dl-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .dl-hero-card h2 {
    margin: 0 0 8px;
    font-size: 1.38rem;
  }

  .dl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .dl-specs-strip {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--outline);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 14px;
  }

  .dl-spec {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.84rem;
  }

  .dl-spec span {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .dl-bento-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 36px;
  }

  .dl-bento-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .dl-bento-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .dl-bento-card h2 {
    margin: 0;
    font-size: 1.12rem;
  }

  .dl-ext-link {
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .dl-ext-link:hover {
    text-decoration: underline;
  }

  .dl-code-box {
    margin-top: auto;
    background: var(--bg);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .dl-code-box code {
    font-size: 0.8rem;
    color: var(--accent);
    word-break: break-all;
    white-space: pre-wrap;
  }

  .dl-copy-sm {
    min-height: 32px;
    padding: 4px 12px;
    font-size: 0.78rem;
    flex-shrink: 0;
  }

  .dl-cmd-stack {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dl-cmd-row {
    background: var(--bg);
    border: 1px solid var(--outline);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .dl-cmd-os {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .dl-cmd-row code {
    font-size: 0.8rem;
    word-break: break-all;
  }

  .dl-mirrors-group {
    margin-top: 32px;
  }

  .dl-group-head {
    margin-bottom: 16px;
  }

  .dl-group-head h2 {
    margin: 0 0 4px;
    font-size: 1.28rem;
  }

  .dl-mirror-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .dl-mirror-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 150ms ease-out, transform 150ms ease-out, background-color 150ms ease-out;
  }

  .dl-mirror-card:hover {
    border-color: var(--accent);
    background: var(--surface-high);
    transform: translateY(-2px);
  }

  .dl-mirror-card.is-outdated {
    opacity: 0.78;
  }

  .dl-mirror-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .dl-mirror-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .dl-mirror-brand > div {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .dl-mirror-brand strong {
    font-size: 1rem;
  }

  .dl-mirror-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dl-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .dl-mirror-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .pill-warn {
    background: rgba(239, 68, 68, 0.14);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.35);
  }

  @media (max-width: 820px) {
    .dl-bento-grid,
    .dl-mirror-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
