---
import { getBaseUrl } from '../utils/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QrModal from '../components/QrModal.astro';
import MirrorIcon from '../components/MirrorIcon.astro';
import { SITE, MIRRORS } from '../data/content';

const base = getBaseUrl();

const MIRROR_DESCRIPTIONS: Record<string, { en: string; de: string; tier: 'official' | 'community' | 'outdated' }> = {
  Zapstore: {
    en: 'Decentralized Nostr-based Android app store with cryptographic developer signatures.',
    de: 'Dezentraler Nostr-App-Store mit kryptografischer Entwickler-Signatur.',
    tier: 'official',
  },
  'GitLab Releases': {
    en: 'Full source-code mirror & automated release mirror synchronized from main.',
    de: 'Vollständiger Quellcode- und Release-Mirror, synchronisiert mit main.',
    tier: 'official',
  },
  APKPure: {
    en: 'Popular third-party APK mirror indexing signed public releases.',
    de: 'Bekannter Drittanbieter-Mirror, der signierte Releases spiegelt.',
    tier: 'community',
  },
  'itch.io': {
    en: 'Indie distribution page with direct APK download & version notes.',
    de: 'Indie-Vertriebsseite mit direktem APK-Download und Versionshinweisen.',
    tier: 'community',
  },
  Appteka: {
    en: 'Independent Android app catalog hosting verified APK builds.',
    de: 'Unabhängiger Android-App-Katalog mit gehosteten APK-Builds.',
    tier: 'community',
  },
  'Komi Store': {
    en: 'Community-curated FOSS Android app store.',
    de: 'Von der Community kuratierter FOSS-Android-Store.',
    tier: 'community',
  },
  AlternativeTo: {
    en: 'Community reviews, feature tags, and open-source alternatives listing.',
    de: 'Community-Bewertungen, Funktionsübersicht und Open-Source-Eintrag.',
    tier: 'community',
  },
  'Amazon Appstore': {
    en: 'Legacy listing — no longer receives current builds. Prefer GitHub Releases.',
    de: 'Veralteter Eintrag — erhält keine aktuellen Builds mehr. Bitte GitHub Releases nutzen.',
    tier: 'outdated',
  },
};

const officialMirrors = MIRRORS.filter((m) => MIRROR_DESCRIPTIONS[m.name]?.tier === 'official');
const communityMirrors = MIRRORS.filter((m) => MIRROR_DESCRIPTIONS[m.name]?.tier !== 'official');

const downloadSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ApkUp',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Android 10.0 - 17 (API 29+)',
  softwareVersion: SITE.fallbackVersion,
  license: SITE.licenseUrl,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  url: 'https://durcheins.github.io/apkup/downloads/',
  downloadUrl: SITE.releasesUrl,
};
---

<BaseLayout
  title="Downloads, Mirrors & SHA-256 Verification — ApkUp"
  description="Download the canonical signed ApkUp APK from GitHub Releases, verify SHA256SUMS checksums, and browse all 8 official & community mirrors."
  jsonLd={downloadSchema}
>
  <Navbar />
  <main id="main-content" class="dl-page">
    <div class="container">
      <header class="dl-header">
        <h1 class="dl-title">
          <span class="i18n-en">Downloads, Mirrors &amp; Verification</span>
          <span class="i18n-de">Downloads, Mirrors &amp; Verifizierung</span>
        </h1>
        <p class="dl-lead">
          <span class="i18n-en">
            Single-Artifact Principle: GitHub Releases delivers the canonical CI-signed APK and
            SHA-256 checksum. Below you’ll find live verification and all 8 mirrors.
          </span>
          <span class="i18n-de">
            Single-Artifact-Prinzip: GitHub Releases liefert die kanonische, per CI signierte APK
            samt SHA-256-Prüfsumme. Unten findest du Live-Verifizierung und alle 8 Mirrors.
          </span>
        </p>
      </header>

      <!-- 1. Compact Canonical Release Card -->
      <section class="dl-hero-card" aria-labelledby="dl-canonical-title">
        <div class="dl-hero-top">
          <div>
            <div class="dl-badges">
              <span class="pill-badge pill-green">
                <span class="i18n-en">Canonical Signed CI Build</span>
                <span class="i18n-de">Kanonischer Signierter CI-Build</span>
              </span>
            </div>
            <h2 id="dl-canonical-title">GitHub Releases (Direct Signed APK)</h2>
            <p class="dl-muted">
              <span class="i18n-en">
                Universal APK with built-in self-updater and cryptographic SHA-256 verification.
              </span>
              <span class="i18n-de">
                Universelle APK mit integriertem Selbst-Updater und kryptografischer SHA-256-Prüfung.
              </span>
            </p>
          </div>
          <div class="dl-actions">
            <a class="btn btn-primary" href={SITE.releasesUrl} data-apk-link>
              <span class="i18n-en">Download <span class="apk-light">Apk</span><strong class="apk-up">Up</strong> <span data-apk-meta>(v{SITE.fallbackVersion})</span></span>
              <span class="i18n-de"><span class="apk-light">Apk</span><strong class="apk-up">Up</strong> laden <span data-apk-meta>(v{SITE.fallbackVersion})</span></span>
            </a>
            <button type="button" class="btn btn-secondary" data-open-qr>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <path d="M14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 18v3" />
              </svg>
              <span>QR-Code</span>
            </button>
            <a class="btn btn-ghost" href={`${base}changelog/`}>
              <span class="i18n-en">What’s New?</span>
              <span class="i18n-de">Was ist neu?</span>
            </a>
          </div>
        </div>

        <div class="dl-specs-strip mono">
          <span><strong>Android:</strong> 10.0 – 17 (API 29+)</span>
          <span><strong>ABIs:</strong> arm64-v8a • armeabi-v7a • x86_64</span>
          <span><strong>GPL-3.0</strong> • APK Signature v2 / v3</span>
          <a href={`${base}sideloading/`} class="dl-ext-link">
            <span class="i18n-en">Install Unknown Apps →</span>
            <span class="i18n-de">Unbekannte Apps installieren →</span>
          </a>
          <a href={`${base}sideloading/google-lock/`} class="dl-ext-link">
            <span class="i18n-en">Google 24h Lock →</span>
            <span class="i18n-de">Googles 24h-Sperre →</span>
          </a>
        </div>
      </section>

      <!-- 2. Compact 2-Column Bento Verification Grid -->
      <section class="dl-bento-grid" aria-labelledby="dl-verify-title">
        <div class="dl-bento-card has-spotlight">
          <div class="dl-bento-head">
            <div class="dl-title-with-help" data-help-wrap="help-sha256">
              <span class="dl-live-dot" id="sha256-live-dot" aria-hidden="true" title="Live"></span>
              <h2 id="dl-verify-title">
                <span class="i18n-en">Live SHA-256 Checksum</span>
                <span class="i18n-de">Live-SHA-256-Prüfsumme</span>
              </h2>
              <button
                type="button"
                class="dl-help-btn"
                aria-expanded="false"
                aria-controls="help-sha256"
                aria-label="What is SHA-256?"
                data-help-toggle="help-sha256"
              >
                ?
              </button>
              <div class="dl-help-popover" id="help-sha256" hidden>
                <p>
                  <span class="i18n-en">
                    A SHA-256 checksum is a unique 64-character digital fingerprint of the APK. If even a single byte was altered or corrupted, the hash won’t match.
                  </span>
                  <span class="i18n-de">
                    Eine SHA-256-Prüfsumme ist der eindeutige 64-stellige Fingerabdruck der APK. Wurde auch nur ein einzelnes Byte verändert oder beschädigt, stimmt der Hash nicht mehr überein.
                  </span>
                </p>
                <a href={`${base}wiki/#doc-sha256`} class="dl-help-wiki-link">
                  <span class="i18n-en">Read full guide in Wiki →</span>
                  <span class="i18n-de">Ausführlich im Wiki lesen →</span>
                </a>
              </div>
            </div>
            <a
              class="dl-ext-link mono"
              href="https://github.com/DurchEins/apkup/releases/latest"
              target="_blank"
              rel="noopener noreferrer"
            >
              SHA256SUMS ↗
            </a>
          </div>

          <p class="dl-muted">
            <span class="i18n-en">
              Live SHA-256 digest of the latest signed APK asset from GitHub Releases.
            </span>
            <span class="i18n-de">
              Live-SHA-256-Prüfsumme der aktuell signierten APK direkt aus dem GitHub Release.
            </span>
          </p>
          <div class="dl-code-box">
            <code class="mono" id="sha256-output">Loading SHA-256…</code>
            <button type="button" class="btn btn-secondary dl-copy-sm" id="copy-sha256-btn" hidden>
              <span class="i18n-en">Copy</span>
              <span class="i18n-de">Kopieren</span>
            </button>
          </div>
          <div class="dl-compare-wrap">
            <input
              type="text"
              id="sha256-compare-input"
              class="dl-compare-input mono"
              placeholder="Paste local SHA-256 to verify…"
              aria-label="Paste local SHA-256 hash to verify"
              spellcheck="false"
            />
            <span class="dl-compare-badge mono" id="sha256-compare-badge" hidden></span>
          </div>
        </div>

        <div class="dl-bento-card has-spotlight">
          <div class="dl-bento-head">
            <div class="dl-title-with-help" data-help-wrap="help-cmd">
              <h2>
                <span class="i18n-en">Local Verification Commands</span>
                <span class="i18n-de">Lokale Prüfbefehle</span>
              </h2>
              <button
                type="button"
                class="dl-help-btn"
                aria-expanded="false"
                aria-controls="help-cmd"
                aria-label="How do local verification commands work?"
                data-help-toggle="help-cmd"
              >
                ?
              </button>
              <div class="dl-help-popover" id="help-cmd" hidden>
                <p>
                  <span class="i18n-en">
                    Run the command for your OS in your Downloads folder to calculate your file’s SHA-256 hash and compare it with the official checksum on the left.
                  </span>
                  <span class="i18n-de">
                    Führe den Befehl für dein System im Download-Ordner aus, um den SHA-256-Hash deiner APK zu berechnen und mit der offiziellen Prüfsumme links zu vergleichen.
                  </span>
                </p>
                <a href={`${base}wiki/#sha256-local-verification-step-by-step`} class="dl-help-wiki-link">
                  <span class="i18n-en">Step-by-step guide in Wiki →</span>
                  <span class="i18n-de">Schritt-für-Schritt im Wiki →</span>
                </a>
              </div>
            </div>
          </div>
          <div class="dl-cmd-stack">
            <div class="dl-cmd-row">
              <div class="dl-cmd-text">
                <span class="mono dl-cmd-os">Linux / macOS</span>
                <code class="mono">sha256sum -c SHA256SUMS</code>
              </div>
              <button
                type="button"
                class="btn btn-secondary dl-copy-sm"
                data-copy-cmd="sha256sum -c SHA256SUMS"
              >
                <span class="i18n-en">Copy</span>
                <span class="i18n-de">Kopieren</span>
              </button>
            </div>
            <div class="dl-cmd-row">
              <div class="dl-cmd-text">
                <span class="mono dl-cmd-os">Windows PowerShell</span>
                <code class="mono">Get-FileHash .\ApkUp-*.apk -Algorithm SHA256</code>
              </div>
              <button
                type="button"
                class="btn btn-secondary dl-copy-sm"
                data-copy-cmd="Get-FileHash .\ApkUp-*.apk -Algorithm SHA256"
              >
                <span class="i18n-en">Copy</span>
                <span class="i18n-de">Kopieren</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Official Mirrors (2-column symmetrical) -->
      <section class="dl-mirrors-group" aria-labelledby="dl-official-title">
        <div class="dl-group-head">
          <h2 id="dl-official-title">
            <span class="i18n-en">Official Mirrors</span>
            <span class="i18n-de">Offizielle Mirrors</span>
          </h2>
          <p class="dl-muted">
            <span class="i18n-en">Directly maintained alongside GitHub Releases.</span>
            <span class="i18n-de">Direkt parallel zu GitHub Releases gepflegt.</span>
          </p>
        </div>

        <div class="dl-mirror-grid">
          {
            officialMirrors.map((m) => {
              const meta = MIRROR_DESCRIPTIONS[m.name];
              return (
                <a class="dl-mirror-card has-spotlight" href={m.url} target="_blank" rel="noopener noreferrer">
                  <div class="dl-mirror-head">
                    <div class="dl-mirror-brand">
                      <span
                        class={`dl-mirror-icon ${m.name === 'itch.io' ? 'is-svg' : ''}`}
                        style={m.name === 'itch.io' ? `background: ${m.color};` : 'background: #fff;'}
                      >
                        <MirrorIcon name={m.name} size={24} />
                      </span>
                      <div>
                        <strong>{m.name}</strong>
                        <span
                          class="pill-badge pill-green mono"
                          title="Canonical / Officially synced channel"
                        >
                          <span class="i18n-en">{m.badgeEn}</span>
                          <span class="i18n-de">{m.badgeDe}</span>
                        </span>
                      </div>
                    </div>
                    <svg class="dl-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                  </div>
                  <p>
                    <span class="i18n-en">{meta.en}</span>
                    <span class="i18n-de">{meta.de}</span>
                  </p>
                </a>
              );
            })
          }
        </div>
      </section>

      <!-- 4. Community Stores & Legacy (3x2 symmetrical) -->
      <section class="dl-mirrors-group" aria-labelledby="dl-community-title">
        <div class="dl-group-head">
          <h2 id="dl-community-title">
            <span class="i18n-en">Community Stores &amp; Directory</span>
            <span class="i18n-de">Community-Stores &amp; Verzeichnis</span>
          </h2>
          <p class="dl-muted">
            <span class="i18n-en">Third-party APK mirrors, indie catalogs, and legacy listings.</span>
            <span class="i18n-de">Drittanbieter-Mirrors, Indie-Kataloge und archivierte Einträge.</span>
          </p>
        </div>

        <div class="dl-mirror-grid">
          {
            communityMirrors.map((m) => {
              const meta = MIRROR_DESCRIPTIONS[m.name];
              return (
                <a
                  class={`dl-mirror-card has-spotlight ${m.outdated ? 'is-outdated' : ''}`}
                  href={m.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="dl-mirror-head">
                    <div class="dl-mirror-brand">
                      <span
                        class={`dl-mirror-icon ${m.name === 'itch.io' ? 'is-svg' : ''}`}
                        style={m.name === 'itch.io' ? `background: ${m.color};` : 'background: #fff;'}
                      >
                        <MirrorIcon name={m.name} size={24} />
                      </span>
                      <div>
                        <strong>{m.name}</strong>
                        <span
                          class={`pill-badge ${m.outdated ? 'pill-warn' : 'pill-neutral'} mono`}
                          title={m.outdated ? 'Legacy listing — use GitHub Releases' : 'Community-indexed mirror'}
                        >
                          <span class="i18n-en">{m.badgeEn}</span>
                          <span class="i18n-de">{m.badgeDe}</span>
                        </span>
                      </div>
                    </div>
                    <svg class="dl-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                  </div>
                  <p>
                    <span class="i18n-en">{meta.en}</span>
                    <span class="i18n-de">{meta.de}</span>
                  </p>
                </a>
              );
            })
          }
        </div>
      </section>
    </div>
  </main>
  <Footer />
  <QrModal />
</BaseLayout>

<script is:inline>
  (function () {
    var out = document.getElementById('sha256-output');
    var copyBtn = document.getElementById('copy-sha256-btn');
    var shaText = '';

    function flashBtn(btn) {
      var orig = btn.innerHTML;
      btn.textContent = '✓';
      btn.classList.add('is-copied');
      setTimeout(function () {
        btn.innerHTML = orig;
        btn.classList.remove('is-copied');
      }, 1600);
    }

    function copyText(text, btn) {
      if (!text) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          if (btn) flashBtn(btn);
        }).catch(function () {});
      }
    }

    function renderSha(text) {
      shaText = (text || '').trim();
      var liveDot = document.getElementById('sha256-live-dot');
      if (!out) return;
      if (shaText) {
        out.textContent = shaText;
        if (copyBtn) copyBtn.hidden = false;
        if (liveDot) liveDot.classList.add('is-live');
      } else {
        out.textContent = 'SHA256SUMS available on GitHub Releases.';
        if (copyBtn) copyBtn.hidden = true;
      }
    }

    var cmpInput = document.getElementById('sha256-compare-input');
    var cmpBadge = document.getElementById('sha256-compare-badge');
    if (cmpInput && cmpBadge) {
      cmpInput.addEventListener('input', function () {
        var val = (cmpInput.value || '').trim().toLowerCase();
        var liveHash = (shaText.split(/\s+/)[0] || '').toLowerCase();
        if (!val) {
          cmpBadge.hidden = true;
          cmpBadge.className = 'dl-compare-badge mono';
          return;
        }
        cmpBadge.hidden = false;
        if (liveHash && val === liveHash) {
          cmpBadge.textContent = 'Match ✓';
          cmpBadge.className = 'dl-compare-badge mono is-match';
        } else {
          cmpBadge.textContent = 'Mismatch ✕';
          cmpBadge.className = 'dl-compare-badge mono is-mismatch';
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        copyText(shaText, copyBtn);
      });
    }

    document.querySelectorAll('[data-copy-cmd]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        copyText(btn.getAttribute('data-copy-cmd') || '', btn);
      });
    });

    function closeAllHelp() {
      document.querySelectorAll('.dl-help-popover').forEach(function (p) {
        p.hidden = true;
      });
      document.querySelectorAll('[data-help-toggle]').forEach(function (b) {
        b.setAttribute('aria-expanded', 'false');
      });
    }

    document.querySelectorAll('[data-help-wrap]').forEach(function (wrap) {
      var id = wrap.getAttribute('data-help-wrap');
      var panel = id ? document.getElementById(id) : null;
      var btn = wrap.querySelector('[data-help-toggle]');
      var closeTimer = null;
      if (!panel || !btn) return;

      function openPanel() {
        clearTimeout(closeTimer);
        closeAllHelp();
        panel.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
      }

      function scheduleClose() {
        closeTimer = setTimeout(function () {
          panel.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
        }, 160);
      }

      btn.addEventListener('mouseenter', openPanel);
      panel.addEventListener('mouseenter', function () {
        clearTimeout(closeTimer);
      });
      wrap.addEventListener('mouseleave', scheduleClose);

      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (panel.hidden) {
          openPanel();
        } else {
          closeAllHelp();
        }
      });
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('[data-help-wrap]')) {
        closeAllHelp();
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAllHelp();
    });

    fetch('https://api.github.com/repos/DurchEins/apkup/releases/latest', {
      headers: { Accept: 'application/vnd.github+json' },
    })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (rel) {
        if (!rel) return renderSha('');
        var apkAsset = (rel.assets || []).find(function (a) {
          return /\.apk$/i.test(a.name || '');
        });
        // Update primary download link & meta on /downloads/
        if (apkAsset && apkAsset.browser_download_url) {
          document.querySelectorAll('[data-apk-link]').forEach(function (el) {
            el.setAttribute('href', apkAsset.browser_download_url);
          });
        }
        if (rel.tag_name) {
          var mb = apkAsset && apkAsset.size ? (apkAsset.size / (1024 * 1024)).toFixed(1) : '';
          var meta = '(' + rel.tag_name + (mb ? ' • ' + mb + ' MB' : '') + ')';
          document.querySelectorAll('[data-apk-meta]').forEach(function (el) {
            el.textContent = meta;
          });
        }

        // 1. Prefer GitHub API digest field (no CORS redirect)
        if (apkAsset && apkAsset.digest) {
          var cleanHash = apkAsset.digest.replace(/^sha256:/i, '');
          return renderSha(cleanHash + '  ' + apkAsset.name);
        }

        // 2. Fallback: extract sha256 hex from release body
        if (rel.body) {
          var m = rel.body.match(/[a-f0-9]{64}/i);
          if (m) return renderSha(m[0] + (apkAsset ? '  ' + apkAsset.name : ''));
        }

        return renderSha('');
      })
      .catch(function () { renderSha(''); });
  })();
</script>

<style>
  .dl-page {
    padding-block: 36px 72px;
  }

  .dl-header {
    max-width: 740px;
    margin-bottom: 22px;
  }

  .dl-title {
    margin: 0;
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    letter-spacing: -0.025em;
  }

  .dl-lead {
    margin-top: 8px;
    color: var(--text-muted);
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .dl-muted {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .dl-hero-card {
    background: var(--surface-low);
    border: 1px solid var(--outline);
    border-radius: var(--radius-lg);
    padding: 20px 24px;
    margin-bottom: 14px;
  }

  .dl-hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .dl-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .dl-hero-card h2 {
    margin: 0 0 4px;
    font-size: 1.25rem;
  }

  .dl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .dl-specs-strip {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--outline);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 0.8rem;
